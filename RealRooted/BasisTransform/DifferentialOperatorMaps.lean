/-!
# Basis maps generated by differential operators

We identify the basis map generated by iterating a linear operator with its
polynomial functional calculus.  We then determine the exact source ray for
the first-order operator `(a + b X) + κ (X - h) D`.
-/

public section

open Polynomial

noncomputable section

namespace RealRooted

/-- A nonzero real polynomial which splits and whose roots all belong to `S`. -/
@[expose] def IsRealRootedIn (S : Set ℝ) (p : ℝ[X]) : Prop :=
  p ≠ 0 ∧ p.Splits ∧ ∀ r ∈ p.roots, r ∈ S

/-- The ray differential operator `f ↦ (a + bX)f + κ(X-h)f'`. -/
@[expose] def rayDifferentialOperator (a b kappa h : ℝ) : Module.End ℝ ℝ[X] where
  toFun p := (C a + C b * X) * p + C kappa * (X - C h) * p.derivative
  map_add' p q := by simp only [derivative_add, mul_add]; ring
  map_smul' c p := by
    simp only [smul_eq_C_mul, derivative_C_mul, RingHom.id_apply]
    ring

/-- The ray differential operator has its advertised pointwise formula. -/
@[simp] theorem rayDifferentialOperator_apply (a b kappa h : ℝ) (p : ℝ[X]) :
    rayDifferentialOperator a b kappa h p =
      (C a + C b * X) * p + C kappa * (X - C h) * p.derivative := rfl

/-- One shifted factor of the ray differential operator. -/
@[expose] def rayDifferentialStep (a b kappa h rho : ℝ) (p : ℝ[X]) : ℝ[X] :=
  (C (a - rho) + C b * X) * p + C kappa * (X - C h) * p.derivative

/-- Subtracting `rho` times the identity from the ray operator gives its
shifted differential step. -/
theorem rayDifferentialOperator_sub_apply (a b kappa h rho : ℝ) (p : ℝ[X]) :
    rayDifferentialOperator a b kappa h p - C rho * p =
      rayDifferentialStep a b kappa h rho p := by
  simp [rayDifferentialStep]
  ring

private lemma rayAffine_natDegree_le (a b : ℝ) :
    (C a + C b * X : ℝ[X]).natDegree ≤ 1 := by
  apply natDegree_add_le_of_degree_le
  · rw [natDegree_C]
    simp
  · calc
      (C b * X : ℝ[X]).natDegree ≤ (C b).natDegree + X.natDegree := natDegree_mul_le
      _ ≤ 0 + 1 := Nat.add_le_add (by rw [natDegree_C]) (by simp)
      _ = 1 := by simp

private lemma rayDerivativeCoeff_natDegree_le (kappa h : ℝ) :
    (C kappa * (X - C h) : ℝ[X]).natDegree ≤ 1 := by
  calc
    (C kappa * (X - C h) : ℝ[X]).natDegree ≤
        (C kappa).natDegree + (X - C h).natDegree := natDegree_mul_le
    _ ≤ 0 + 1 := Nat.add_le_add (by rw [natDegree_C]) (by simp)
    _ = 1 := by simp

private lemma rayDifferentialStep_degree_le (a b kappa h rho : ℝ) (p : ℝ[X]) :
    (rayDifferentialStep a b kappa h rho p).natDegree ≤ p.natDegree + 1 := by
  rw [rayDifferentialStep]
  apply natDegree_add_le_of_degree_le
  · exact natDegree_mul_iterate_derivative_le (d := 1) (j := 0)
      (rayAffine_natDegree_le (a - rho) b) le_rfl
  · exact natDegree_mul_iterate_derivative_le (d := 1) (j := 1)
      ((rayDerivativeCoeff_natDegree_le kappa h).trans (by simp)) le_rfl

private lemma rayDifferentialStep_coeff_succ (a b kappa h rho : ℝ) (p : ℝ[X]) :
    (rayDifferentialStep a b kappa h rho p).coeff (p.natDegree + 1) =
      b * p.leadingCoeff := by
  rw [rayDifferentialStep, coeff_add]
  have h0 := coeff_mul_iterate_derivative_of_natDegree_le
    (A := C (a - rho) + C b * X) (p := p) (d := 1) (j := 0)
    (D := p.natDegree) (rayAffine_natDegree_le (a - rho) b) le_rfl
  have h1 := coeff_mul_iterate_derivative_of_natDegree_le
    (A := C kappa * (X - C h)) (p := p) (d := 1) (j := 1)
    (D := p.natDegree) ((rayDerivativeCoeff_natDegree_le kappa h).trans (by simp)) le_rfl
  simp only [Function.iterate_zero, id_eq, Nat.descFactorial_zero, Nat.cast_one,
    mul_one, Function.iterate_one, Nat.descFactorial_one] at h0 h1
  rw [h0, h1, leadingCoeff]
  simp [Polynomial.coeff_X]

private lemma rayDifferentialStep_degree_eq_and_leadingCoeff_pos
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b)
    (hp : HasPosLeadingCoeff p) :
    (rayDifferentialStep a b kappa h rho p).natDegree = p.natDegree + 1 ∧
      HasPosLeadingCoeff (rayDifferentialStep a b kappa h rho p) := by
  have hcoeff :
      0 < (rayDifferentialStep a b kappa h rho p).coeff (p.natDegree + 1) := by
    rw [rayDifferentialStep_coeff_succ]
    exact mul_pos hb hp
  have hdeg := natDegree_eq_of_le_of_coeff_ne_zero
    (rayDifferentialStep_degree_le a b kappa h rho p) hcoeff.ne'
  refine ⟨hdeg, ?_⟩
  rw [HasPosLeadingCoeff, leadingCoeff, hdeg]
  exact hcoeff

private lemma rayDifferentialStep_factorization
    (a b kappa h rho : ℝ) (p q : ℝ[X]) (m : ℕ)
    (hpq : (X - C h) ^ m * q = p) :
    rayDifferentialStep a b kappa h rho p = (X - C h) ^ m *
      rayDifferentialStep (a + kappa * m) b kappa h rho q := by
  rw [rayDifferentialStep, rayDifferentialStep, ← hpq]
  cases m with
  | zero => simp
  | succ m =>
      have hparam : a + kappa * (m + 1 : ℕ) = a + kappa * m + kappa := by
        push_cast
        ring
      rw [hparam, derivative_mul, derivative_X_sub_C_pow]
      simp only [Nat.succ_sub_one, Nat.cast_succ, map_add, map_sub, map_mul, map_one]
      ring

private lemma roots_lt_of_ray_factor {h : ℝ} {p q : ℝ[X]} {m : ℕ}
    (hq : q ≠ 0) (hfactor : (X - C h) ^ m * q = p)
    (hqeval : q.eval h ≠ 0) (hroots : ∀ r ∈ p.roots, r ≤ h) :
    ∀ r ∈ q.roots, r < h := by
  intro r hr
  have hrq : q.IsRoot r := (mem_roots hq).mp hr
  have hrp : r ∈ p.roots := by
    rw [← hfactor, roots_mul
      (mul_ne_zero (pow_ne_zero _ (X_sub_C_ne_zero h)) hq), Multiset.mem_add]
    exact Or.inr hr
  exact lt_of_le_of_ne (hroots r hrp) fun heq => hqeval (by simpa [heq] using hrq)

private theorem rayDifferentialStep_package_of_pos
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ≤ h) :
    rayDifferentialStep a b kappa h rho p ≠ 0 ∧
      (rayDifferentialStep a b kappa h rho p).Splits ∧
      ((∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h) ↔
        rho ≤ a + b * h + kappa * p.rootMultiplicity h) ∧
      p.rootMultiplicity h ≤
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
  let m := p.rootMultiplicity h
  let q := p /ₘ (X - C h) ^ m
  let H := rayDifferentialStep (a + kappa * m) b kappa h rho q
  have hfactor : (X - C h) ^ m * q = p := by
    dsimp [q, m]
    exact p.pow_mul_divByMonic_rootMultiplicity_eq h
  have hqeval : q.eval h ≠ 0 := by
    dsimp [q, m]
    exact eval_divByMonic_pow_rootMultiplicity_ne_zero h hp.ne_zero
  have hq : q ≠ 0 := fun hq => hqeval (by rw [hq, eval_zero])
  have hFfactor : rayDifferentialStep a b kappa h rho p = (X - C h) ^ m * H := by
    dsimp [H]
    exact rayDifferentialStep_factorization a b kappa h rho p q m hfactor
  have hqrr : q ≠ 0 ∧ q.Splits :=
    isRealRooted_of_dvd hp.ne_zero hs hq
      ⟨(X - C h) ^ m, by rw [mul_comm, hfactor]⟩
  have hqpos : HasPosLeadingCoeff q := by
    apply hasPosLeadingCoeff_of_pow_X_sub_C_mul (r := h) (m := m)
    rw [hfactor]
    exact hp
  have hqroots : ∀ r ∈ q.roots, r < h :=
    roots_lt_of_ray_factor hq hfactor hqeval hroots
  have hHpack := rayDifferentialStep_degree_eq_and_leadingCoeff_pos
    (a := a + kappa * m) (kappa := kappa) (h := h) (rho := rho) hb hqpos
  have hqH : StrictInterl q H := by
    dsimp [H]
    apply MaWang.strictInterl_derivative_of_nonpos_of_splits hqrr.2
    · change q.natDegree ≤
        (rayDifferentialStep (a + kappa * m) b kappa h rho q).natDegree
      rw [hHpack.1]
      lia
    · change (rayDifferentialStep (a + kappa * m) b kappa h rho q).natDegree ≤
        q.natDegree + 1
      rw [hHpack.1]
    · exact hHpack.2
    · exact hqpos
    · intro r hr
      have hrmem : r ∈ q.roots := (mem_roots hq).mpr hr
      simp only [eval_mul, eval_C, eval_sub, eval_X]
      exact mul_nonpos_of_nonneg_of_nonpos hkappa (sub_nonpos.mpr (hqroots r hrmem).le)
  have hinter : Interlaces q H := hqH.toInterlaces hHpack.1.symm
  have hqevalpos : 0 < q.eval h :=
    eval_pos_of_all_roots_lt hq hqrr.2 hqpos hqroots
  have hHeval : H.eval h =
      (a + kappa * m - rho + b * h) * q.eval h := by
    dsimp [H, rayDifferentialStep]
    simp only [eval_add, eval_mul, eval_C, eval_X, eval_sub, sub_self, mul_zero,
      ]
    ring
  have hHroots : (∀ r ∈ H.roots, r ≤ h) ↔
      rho ≤ a + b * h + kappa * m := by
    rw [roots_le_iff_eval_nonneg_of_interlaces hinter hHpack.2 hqroots, hHeval]
    constructor
    · intro hnonneg
      nlinarith
    · intro hrho
      exact mul_nonneg (by nlinarith) hqevalpos.le
  have hH : H ≠ 0 := hHpack.2.ne_zero
  have hprod : (X - C h) ^ m * H ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (X_sub_C_ne_zero h)) hH
  have hFne : rayDifferentialStep a b kappa h rho p ≠ 0 := by
    rw [hFfactor]
    exact hprod
  have htransfer :
      (∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h) ↔
        ∀ r ∈ H.roots, r ≤ h := by
    constructor
    · intro hall r hr
      apply hall r
      rw [hFfactor, roots_mul hprod, Multiset.mem_add]
      exact Or.inr hr
    · intro hall r hr
      rw [hFfactor, roots_mul hprod, Multiset.mem_add] at hr
      rcases hr with hr | hr
      · have hre : r = h := by
          have hm : m ≠ 0 ∧ r = h := by
            simpa only [roots_pow, roots_X_sub_C, Multiset.mem_nsmul,
              Multiset.mem_singleton] using hr
          exact hm.2
        rw [hre]
      · exact hall r hr
  have hsplits : (rayDifferentialStep a b kappa h rho p).Splits := by
    rw [hFfactor]
    exact (isRealRooted_X_sub_C h).2.pow m |>.mul hqH.2.1.2
  have hmult : m ≤ (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
    rw [hFfactor, rootMultiplicity_mul hprod, rootMultiplicity_X_sub_C_pow]
    exact Nat.le_add_right m _
  exact ⟨hFne, hsplits, htransfer.trans hHroots, hmult⟩

/-- A shifted ray step is always nonzero and split.  Its roots remain in the
target ray exactly up to the endpoint-multiplicity threshold, and the endpoint
multiplicity cannot decrease. -/
theorem rayDifferentialStep_package
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hp : p ≠ 0) (hs : p.Splits) (hroots : ∀ r ∈ p.roots, r ≤ h) :
    rayDifferentialStep a b kappa h rho p ≠ 0 ∧
      (rayDifferentialStep a b kappa h rho p).Splits ∧
      ((∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h) ↔
        rho ≤ a + b * h + kappa * p.rootMultiplicity h) ∧
      p.rootMultiplicity h ≤
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
  let c := p.leadingCoeff
  let P := C c * p
  have hc : c ≠ 0 := by
    dsimp [c]
    exact leadingCoeff_ne_zero.mpr hp
  have hPpos : HasPosLeadingCoeff P := by
    dsimp [P, HasPosLeadingCoeff]
    rw [leadingCoeff_mul, leadingCoeff_C]
    exact mul_self_pos.mpr hc
  have hPs : P.Splits := hs.C_mul c
  have hProots : ∀ r ∈ P.roots, r ≤ h := by
    intro r hr
    dsimp [P] at hr
    rw [roots_C_mul p hc] at hr
    exact hroots r hr
  have hstep : rayDifferentialStep a b kappa h rho P =
      C c * rayDifferentialStep a b kappa h rho p := by
    dsimp [P, rayDifferentialStep]
    simp only [derivative_C_mul]
    ring
  have hmultP : P.rootMultiplicity h = p.rootMultiplicity h := by
    dsimp [P]
    exact rootMultiplicity_C_mul hc p
  have hpack := rayDifferentialStep_package_of_pos
    (a := a) (rho := rho) hb hkappa hPpos hPs hProots
  have hstep_ne : rayDifferentialStep a b kappa h rho p ≠ 0 := by
    intro hzero
    apply hpack.1
    rw [hstep, hzero, mul_zero]
  have hstep_splits : (rayDifferentialStep a b kappa h rho p).Splits := by
    exact (isRealRooted_of_dvd hpack.1 hpack.2.1 hstep_ne
      ⟨C c, by rw [mul_comm]; exact hstep⟩).2
  have hroot_transfer :
      (∀ r ∈ (rayDifferentialStep a b kappa h rho P).roots, r ≤ h) ↔
        ∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h := by
    rw [hstep, roots_C_mul _ hc]
  have houtmult :
      (rayDifferentialStep a b kappa h rho P).rootMultiplicity h =
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
    rw [hstep]
    exact rootMultiplicity_C_mul hc _
  refine ⟨hstep_ne, hstep_splits, ?_, ?_⟩
  · rw [← hroot_transfer, hpack.2.2.1, hmultP]
  · rw [← hmultP, ← houtmult]
    exact hpack.2.2.2

/-- The basis map whose `n`th basis element is the `n`th iterate of the ray
differential operator applied to the seed `g`. -/
@[expose] def rayBasisMap (a b kappa h : ℝ) (g p : ℝ[X]) : ℝ[X] :=
  basisTransform (fun n ↦ (rayDifferentialOperator a b kappa h ^ n) g) p

/-- The ray basis map is the polynomial functional calculus of its differential
operator, applied to the seed. -/
theorem rayBasisMap_eq_aeval_apply (a b kappa h : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g p =
      (aeval (rayDifferentialOperator a b kappa h) p : Module.End ℝ ℝ[X]) g :=
  basisTransform_iterate_eq_aeval_apply _ _ _

/-- A source linear factor acts by the corresponding shifted ray step. -/
theorem rayBasisMap_linear_mul (a b kappa h rho : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g ((X - C rho) * p) =
      rayDifferentialStep a b kappa h rho (rayBasisMap a b kappa h g p) := by
  rw [rayBasisMap, basisTransform_iterate_X_sub_C_mul,
    rayDifferentialOperator_sub_apply]
  rw [rayBasisMap]

/-- Scalar multiplication commutes with a ray basis map. -/
theorem rayBasisMap_C_mul (a b kappa h c : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g (C c * p) = C c * rayBasisMap a b kappa h g p := by
  rw [rayBasisMap, show C c * p = c • p by rw [smul_eq_C_mul], basisTransform_smul]
  rw [rayBasisMap]

/-- The ray basis map sends the constant polynomial `1` to its seed. -/
@[simp] theorem rayBasisMap_one (a b kappa h : ℝ) (g : ℝ[X]) :
    rayBasisMap a b kappa h g 1 = g := by
  rw [rayBasisMap]
  simpa using Polynomial.basisTransform_X_pow
    (fun n ↦ (rayDifferentialOperator a b kappa h ^ n) g) 0

private theorem rayBasisMap_prod_package
    {a b kappa h : ℝ} {g : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hg : IsRealRootedIn (Set.Iic h) g) (s : Multiset ℝ)
    (hs : ∀ rho ∈ s, rho ≤ a + b * h + kappa * g.rootMultiplicity h) :
    IsRealRootedIn (Set.Iic h)
        (rayBasisMap a b kappa h g (s.map (X - C ·)).prod) ∧
      g.rootMultiplicity h ≤
        (rayBasisMap a b kappa h g (s.map (X - C ·)).prod).rootMultiplicity h := by
  induction s using Multiset.induction_on with
  | empty =>
      simpa only [Multiset.map_zero, Multiset.prod_zero, rayBasisMap_one] using
        (⟨hg, le_rfl⟩ : IsRealRootedIn (Set.Iic h) g ∧
          g.rootMultiplicity h ≤ g.rootMultiplicity h)
  | @cons rho s ih =>
      have ih' := ih (fun r hr => hs r (Multiset.mem_cons_of_mem hr))
      let q := rayBasisMap a b kappa h g (s.map (X - C ·)).prod
      have hq : IsRealRootedIn (Set.Iic h) q := ih'.1
      have hmult : g.rootMultiplicity h ≤ q.rootMultiplicity h := by
        simpa only [q] using ih'.2
      have hrho : rho ≤ a + b * h + kappa * q.rootMultiplicity h := by
        have hmult_real : (g.rootMultiplicity h : ℝ) ≤ q.rootMultiplicity h := by
          exact_mod_cast hmult
        have hmul : kappa * g.rootMultiplicity h ≤ kappa * q.rootMultiplicity h :=
          mul_le_mul_of_nonneg_left hmult_real hkappa
        exact (hs rho (Multiset.mem_cons_self _ _)).trans (by linarith)
      have hpack := rayDifferentialStep_package (a := a) (rho := rho)
        hb hkappa hq.1 hq.2.1
        (fun r hr => hq.2.2 r hr)
      have hstep_roots :
          ∀ r ∈ (rayDifferentialStep a b kappa h rho q).roots, r ≤ h :=
        hpack.2.2.1.mpr hrho
      have hidentity :
          rayBasisMap a b kappa h g
              ((rho ::ₘ s).map (X - C ·)).prod =
            rayDifferentialStep a b kappa h rho q := by
        simp only [Multiset.map_cons, Multiset.prod_cons]
        exact rayBasisMap_linear_mul a b kappa h rho g _
      rw [hidentity]
      exact ⟨⟨hpack.1, hpack.2.1, hstep_roots⟩, hmult.trans hpack.2.2.2⟩

/-- Exact source ray for a basis map generated by
`f ↦ (a + bX)f + κ(X-h)f'`.  This includes constant seeds and `κ = 0`. -/
theorem rayBasisMap_maps_realRootedIn_iff
    {a b kappa h : ℝ} {g : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hg : IsRealRootedIn (Set.Iic h) g) (S : Set ℝ) :
    (∀ p, IsRealRootedIn S p →
      IsRealRootedIn (Set.Iic h) (rayBasisMap a b kappa h g p)) ↔
      S ⊆ Set.Iic (a + b * h + kappa * g.rootMultiplicity h) := by
  constructor
  · intro hmaps rho hrho
    let p : ℝ[X] := X - C rho
    have hp : IsRealRootedIn S p := by
      refine ⟨(isRealRooted_X_sub_C rho).1, (isRealRooted_X_sub_C rho).2, ?_⟩
      intro r hr
      dsimp [p] at hr
      rw [roots_X_sub_C, Multiset.mem_singleton] at hr
      simpa [hr] using hrho
    have himage := hmaps p hp
    have hlinear : rayBasisMap a b kappa h g p =
        rayDifferentialStep a b kappa h rho g := by
      dsimp [p]
      simpa only [mul_one, rayBasisMap_one] using
        rayBasisMap_linear_mul a b kappa h rho g 1
    have hpack := rayDifferentialStep_package (a := a) (rho := rho)
      hb hkappa hg.1 hg.2.1
      (fun r hr => hg.2.2 r hr)
    have hroot : ∀ r ∈ (rayDifferentialStep a b kappa h rho g).roots, r ≤ h := by
      intro r hr
      have hr' : r ∈ (rayBasisMap a b kappa h g p).roots := by
        simpa only [hlinear] using hr
      have hh := himage.2.2 r hr'
      change r ≤ h at hh
      exact hh
    exact hpack.2.2.1.mp hroot
  · intro hS p hp
    have hroots : ∀ rho ∈ p.roots,
        rho ≤ a + b * h + kappa * g.rootMultiplicity h := by
      intro rho hrho
      exact hS (hp.2.2 rho hrho)
    have hprod := rayBasisMap_prod_package hb hkappa hg p.roots hroots
    let q := (p.roots.map (X - C ·)).prod
    have hlc : p.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hp.1
    have hfactor : p = C p.leadingCoeff * q := by
      dsimp [q]
      exact hp.2.1.eq_prod_roots
    have himage : rayBasisMap a b kappa h g p =
        C p.leadingCoeff * rayBasisMap a b kappa h g q := by
      calc
        rayBasisMap a b kappa h g p =
            rayBasisMap a b kappa h g (C p.leadingCoeff * q) :=
          congrArg (rayBasisMap a b kappa h g) hfactor
        _ = _ := rayBasisMap_C_mul a b kappa h p.leadingCoeff g q
    refine ⟨?_, ?_, ?_⟩
    · rw [himage]
      exact mul_ne_zero (C_ne_zero.mpr hlc) hprod.1.1
    · rw [himage]
      exact hprod.1.2.1.C_mul _
    · intro r hr
      rw [himage, roots_C_mul _ hlc] at hr
      exact hprod.1.2.2 r hr

end RealRooted
