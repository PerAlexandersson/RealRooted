/-!
# Basis maps generated by differential operators

We identify the basis map generated by iterating a linear operator with its
polynomial functional calculus.  We then determine the exact source ray for
the first-order operator `(a + b X) + κ (X - h) D`, and develop the closed-window step
for the interval operator `(α X + β) + κ (X - L) (X - U) D`: degree, interlacing, the sharp
closed-window criterion, and the endpoint multiplicities.
-/

public section

open Polynomial Set

noncomputable section

namespace RealRooted

/-- A nonzero real polynomial which splits and whose roots all belong to `S`. -/
@[expose] def IsRealRootedIn (S : Set ℝ) (p : ℝ[X]) : Prop :=
  p ≠ 0 ∧ p.Splits ∧ ∀ r ∈ p.roots, r ∈ S

/-- The ray differential operator `f ↦ (a + bX)f + κ(X-h)f'`. -/
@[expose] def rayDifferentialOperator (a b kappa h : ℝ) : Module.End ℝ ℝ[X] where
  toFun p := (C a + C b * X) * p + C kappa * (X - C h) * p.derivative
  map_add' p q := by simp only [derivative_add, mul_add]; ring
  map_smul' c p := by
    simp only [smul_eq_C_mul, derivative_C_mul, RingHom.id_apply]
    ring

/-- The ray differential operator has its advertised pointwise formula. -/
@[simp] theorem rayDifferentialOperator_apply (a b kappa h : ℝ) (p : ℝ[X]) :
    rayDifferentialOperator a b kappa h p =
      (C a + C b * X) * p + C kappa * (X - C h) * p.derivative := rfl

/-- One shifted factor of the ray differential operator. -/
@[expose] def rayDifferentialStep (a b kappa h rho : ℝ) (p : ℝ[X]) : ℝ[X] :=
  (C (a - rho) + C b * X) * p + C kappa * (X - C h) * p.derivative

/-- Subtracting `rho` times the identity from the ray operator gives its
shifted differential step. -/
theorem rayDifferentialOperator_sub_apply (a b kappa h rho : ℝ) (p : ℝ[X]) :
    rayDifferentialOperator a b kappa h p - C rho * p =
      rayDifferentialStep a b kappa h rho p := by
  simp [rayDifferentialStep]
  ring

/-- Degree bound for the first-order step `A * p + B * p'` with `deg A ≤ 1`, `deg B ≤ 2`. -/
private lemma natDegree_mul_add_mul_derivative_le {A B : ℝ[X]} (hA : A.natDegree ≤ 1)
    (hB : B.natDegree ≤ 2) (p : ℝ[X]) :
    (A * p + B * p.derivative).natDegree ≤ p.natDegree + 1 := by
  apply natDegree_add_le_of_degree_le
  · exact natDegree_mul_iterate_derivative_le (d := 1) (j := 0) hA le_rfl
  · exact natDegree_mul_iterate_derivative_le (d := 1) (j := 1) hB le_rfl

/-- The coefficient of `X ^ (natDegree p + 1)` in the first-order step `A * p + B * p'`. -/
private lemma coeff_succ_mul_add_mul_derivative {A B : ℝ[X]} (hA : A.natDegree ≤ 1)
    (hB : B.natDegree ≤ 2) (p : ℝ[X]) :
    (A * p + B * p.derivative).coeff (p.natDegree + 1) =
      (A.coeff 1 + B.coeff 2 * p.natDegree) * p.leadingCoeff := by
  have h0 := coeff_mul_iterate_derivative_of_natDegree_le
    (A := A) (p := p) (d := 1) (j := 0) (D := p.natDegree) hA le_rfl
  have h1 := coeff_mul_iterate_derivative_of_natDegree_le
    (A := B) (p := p) (d := 1) (j := 1) (D := p.natDegree) hB le_rfl
  simp only [Function.iterate_zero, id_eq, Nat.descFactorial_zero, Nat.cast_one,
    mul_one, Function.iterate_one, Nat.descFactorial_one] at h0 h1
  rw [coeff_add, h0, h1, leadingCoeff]
  ring

/-- A first-order step `A * p + B * p'` with positive top coefficient raises the degree by
one and keeps the leading coefficient positive. -/
private lemma natDegree_eq_and_hasPosLeadingCoeff_mul_add_mul_derivative {A B p : ℝ[X]}
    (hA : A.natDegree ≤ 1) (hB : B.natDegree ≤ 2)
    (htop : 0 < A.coeff 1 + B.coeff 2 * p.natDegree) (hp : HasPosLeadingCoeff p) :
    (A * p + B * p.derivative).natDegree = p.natDegree + 1 ∧
      HasPosLeadingCoeff (A * p + B * p.derivative) := by
  have hcoeff : 0 < (A * p + B * p.derivative).coeff (p.natDegree + 1) := by
    rw [coeff_succ_mul_add_mul_derivative hA hB]
    exact mul_pos htop hp
  have hdeg := natDegree_eq_of_le_of_coeff_ne_zero
    (natDegree_mul_add_mul_derivative_le hA hB p) hcoeff.ne'
  refine ⟨hdeg, ?_⟩
  rw [HasPosLeadingCoeff, leadingCoeff, hdeg]
  exact hcoeff

/-- A polynomial of the form `(X - e) ^ m * q`, with `B = B' * (X - e)`, is mapped by the
first-order step `A * p + B * p'` to `(X - e) ^ m` times a step of `q` with shifted
coefficient `A + m B'`. -/
private lemma mul_add_mul_derivative_pow_X_sub_C_mul (A B' q : ℝ[X]) (e : ℝ) (m : ℕ) :
    A * ((X - C e) ^ m * q) + B' * (X - C e) * ((X - C e) ^ m * q).derivative =
      (X - C e) ^ m * ((A + C (m : ℝ) * B') * q + B' * (X - C e) * q.derivative) := by
  cases m with
  | zero => simp
  | succ m =>
      rw [derivative_mul, derivative_X_sub_C_pow]
      simp only [Nat.succ_sub_one, Nat.cast_succ, map_add, map_one]
      ring

/-- Splitting off the full multiplicity of a root `e` of a split polynomial with positive
leading coefficient leaves a split cofactor with positive leading coefficient that does not
vanish at `e`. -/
private lemma exists_pow_X_sub_C_mul_eval_ne_zero {p : ℝ[X]} (hp : HasPosLeadingCoeff p)
    (hs : p.Splits) (e : ℝ) :
    ∃ q : ℝ[X], (X - C e) ^ p.rootMultiplicity e * q = p ∧ q.eval e ≠ 0 ∧
      HasPosLeadingCoeff q ∧ q.Splits := by
  have hfactor := p.pow_mul_divByMonic_rootMultiplicity_eq e
  have hqeval := eval_divByMonic_pow_rootMultiplicity_ne_zero e hp.ne_zero
  have hq : p /ₘ (X - C e) ^ p.rootMultiplicity e ≠ 0 := fun hzero =>
    hqeval (by rw [hzero, eval_zero])
  refine ⟨_, hfactor, hqeval, ?_,
    (isRealRooted_of_dvd hp.ne_zero hs hq ⟨_, by rw [mul_comm, hfactor]⟩).2⟩
  refine hasPosLeadingCoeff_of_pow_X_sub_C_mul (r := e) (m := p.rootMultiplicity e) ?_
  rw [hfactor]
  exact hp

/-- The roots of the cofactor `q` in `(X - e) ^ m * q = p` stay in a set containing the roots
of `p` and avoid `e`. -/
private lemma roots_cofactor_mem_and_ne {S : Set ℝ} {e : ℝ} {p q : ℝ[X]} {m : ℕ}
    (hq : q ≠ 0) (hfactor : (X - C e) ^ m * q = p) (hqeval : q.eval e ≠ 0)
    (hroots : ∀ r ∈ p.roots, r ∈ S) :
    ∀ r ∈ q.roots, r ∈ S ∧ r ≠ e := by
  intro r hr
  have hrq : q.IsRoot r := (mem_roots hq).mp hr
  have hrp : r ∈ p.roots := by
    rw [← hfactor, roots_mul
      (mul_ne_zero (pow_ne_zero _ (X_sub_C_ne_zero e)) hq), Multiset.mem_add]
    exact Or.inr hr
  exact ⟨hroots r hrp, fun hre => hqeval (by simpa [hre] using hrq)⟩

/-- Removing a factor `(X - e) ^ m` preserves the assertion that all roots lie in a set
containing `e`. -/
private lemma forall_mem_roots_iff_of_pow_X_sub_C_mul {S : Set ℝ} {e : ℝ} (he : e ∈ S)
    {m : ℕ} {F H : ℝ[X]} (hH : H ≠ 0) (hfactor : F = (X - C e) ^ m * H) :
    (∀ r ∈ F.roots, r ∈ S) ↔ ∀ r ∈ H.roots, r ∈ S := by
  subst hfactor
  rw [roots_mul (mul_ne_zero (pow_ne_zero m (X_sub_C_ne_zero e)) hH)]
  simp only [Multiset.mem_add, roots_pow, roots_X_sub_C, Multiset.mem_nsmul,
    Multiset.mem_singleton]
  constructor
  · exact fun h r hr => h r (Or.inr hr)
  · rintro h r (⟨-, rfl⟩ | hr)
    exacts [he, h r hr]

private lemma rayDifferentialStep_degree_eq_and_leadingCoeff_pos
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b)
    (hp : HasPosLeadingCoeff p) :
    (rayDifferentialStep a b kappa h rho p).natDegree = p.natDegree + 1 ∧
      HasPosLeadingCoeff (rayDifferentialStep a b kappa h rho p) :=
  natDegree_eq_and_hasPosLeadingCoeff_mul_add_mul_derivative (by compute_degree)
    (by compute_degree!) (by simpa [coeff_X, coeff_C] using hb) hp

private lemma rayDifferentialStep_factorization
    (a b kappa h rho : ℝ) (p q : ℝ[X]) (m : ℕ)
    (hpq : (X - C h) ^ m * q = p) :
    rayDifferentialStep a b kappa h rho p = (X - C h) ^ m *
      rayDifferentialStep (a + kappa * m) b kappa h rho q := by
  rw [rayDifferentialStep, rayDifferentialStep, ← hpq,
    mul_add_mul_derivative_pow_X_sub_C_mul]
  congr 2
  simp only [map_add, map_sub, map_mul, map_natCast]
  ring

private theorem rayDifferentialStep_package_of_pos
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ≤ h) :
    rayDifferentialStep a b kappa h rho p ≠ 0 ∧
      (rayDifferentialStep a b kappa h rho p).Splits ∧
      ((∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h) ↔
        rho ≤ a + b * h + kappa * p.rootMultiplicity h) ∧
      p.rootMultiplicity h ≤
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
  obtain ⟨q, hfactor, hqeval, hqpos, hqs⟩ := exists_pow_X_sub_C_mul_eval_ne_zero hp hs h
  generalize p.rootMultiplicity h = m at hfactor ⊢
  let H := rayDifferentialStep (a + kappa * m) b kappa h rho q
  have hFfactor : rayDifferentialStep a b kappa h rho p = (X - C h) ^ m * H :=
    rayDifferentialStep_factorization a b kappa h rho p q m hfactor
  have hqroots : ∀ r ∈ q.roots, r < h := fun r hr =>
    let hr' := roots_cofactor_mem_and_ne (S := Set.Iic h) hqpos.ne_zero hfactor hqeval hroots r hr
    lt_of_le_of_ne hr'.1 hr'.2
  have hHpack := rayDifferentialStep_degree_eq_and_leadingCoeff_pos
    (a := a + kappa * m) (kappa := kappa) (h := h) (rho := rho) hb hqpos
  have hqH : StrictInterl q H := by
    dsimp [H]
    apply MaWang.strictInterl_derivative_of_nonpos_of_splits hqs
    · change q.natDegree ≤
        (rayDifferentialStep (a + kappa * m) b kappa h rho q).natDegree
      rw [hHpack.1]
      lia
    · change (rayDifferentialStep (a + kappa * m) b kappa h rho q).natDegree ≤
        q.natDegree + 1
      rw [hHpack.1]
    · exact hHpack.2
    · exact hqpos
    · intro r hr
      have hrmem : r ∈ q.roots := (mem_roots hqpos.ne_zero).mpr hr
      simp only [eval_mul, eval_C, eval_sub, eval_X]
      exact mul_nonpos_of_nonneg_of_nonpos hkappa (sub_nonpos.mpr (hqroots r hrmem).le)
  have hinter : Interlaces q H := hqH.toInterlaces hHpack.1.symm
  have hqevalpos : 0 < q.eval h :=
    eval_pos_of_all_roots_lt hqpos.ne_zero hqs hqpos hqroots
  have hHeval : H.eval h =
      (a + kappa * m - rho + b * h) * q.eval h := by
    dsimp [H, rayDifferentialStep]
    simp only [eval_add, eval_mul, eval_C, eval_X, eval_sub, sub_self, mul_zero,
      ]
    ring
  have hHroots : (∀ r ∈ H.roots, r ≤ h) ↔
      rho ≤ a + b * h + kappa * m := by
    rw [roots_le_iff_eval_nonneg_of_interlaces hinter hHpack.2 hqroots, hHeval]
    constructor
    · intro hnonneg
      nlinarith
    · intro hrho
      exact mul_nonneg (by nlinarith) hqevalpos.le
  have hH : H ≠ 0 := hHpack.2.ne_zero
  have hprod : (X - C h) ^ m * H ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (X_sub_C_ne_zero h)) hH
  refine ⟨by rw [hFfactor]; exact hprod,
    by rw [hFfactor]; exact ((isRealRooted_X_sub_C h).2.pow m).mul hqH.2.1.2,
    (forall_mem_roots_iff_of_pow_X_sub_C_mul (S := Set.Iic h) (Set.mem_Iic.mpr le_rfl) hH
      hFfactor).trans hHroots, ?_⟩
  rw [hFfactor, rootMultiplicity_mul hprod, rootMultiplicity_X_sub_C_pow]
  exact Nat.le_add_right m _

/-- A shifted ray step is always nonzero and split.  Its roots remain in the
target ray exactly up to the endpoint-multiplicity threshold, and the endpoint
multiplicity cannot decrease. -/
theorem rayDifferentialStep_package
    {a b kappa h rho : ℝ} {p : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hp : p ≠ 0) (hs : p.Splits) (hroots : ∀ r ∈ p.roots, r ≤ h) :
    rayDifferentialStep a b kappa h rho p ≠ 0 ∧
      (rayDifferentialStep a b kappa h rho p).Splits ∧
      ((∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h) ↔
        rho ≤ a + b * h + kappa * p.rootMultiplicity h) ∧
      p.rootMultiplicity h ≤
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
  let c := p.leadingCoeff
  let P := C c * p
  have hc : c ≠ 0 := by
    dsimp [c]
    exact leadingCoeff_ne_zero.mpr hp
  have hPpos : HasPosLeadingCoeff P := by
    dsimp [P, HasPosLeadingCoeff]
    rw [leadingCoeff_mul, leadingCoeff_C]
    exact mul_self_pos.mpr hc
  have hPs : P.Splits := hs.C_mul c
  have hProots : ∀ r ∈ P.roots, r ≤ h := by
    intro r hr
    dsimp [P] at hr
    rw [roots_C_mul p hc] at hr
    exact hroots r hr
  have hstep : rayDifferentialStep a b kappa h rho P =
      C c * rayDifferentialStep a b kappa h rho p := by
    dsimp [P, rayDifferentialStep]
    simp only [derivative_C_mul]
    ring
  have hmultP : P.rootMultiplicity h = p.rootMultiplicity h := by
    dsimp [P]
    exact rootMultiplicity_C_mul hc p
  have hpack := rayDifferentialStep_package_of_pos
    (a := a) (rho := rho) hb hkappa hPpos hPs hProots
  have hstep_ne : rayDifferentialStep a b kappa h rho p ≠ 0 := by
    intro hzero
    apply hpack.1
    rw [hstep, hzero, mul_zero]
  have hstep_splits : (rayDifferentialStep a b kappa h rho p).Splits := by
    exact (isRealRooted_of_dvd hpack.1 hpack.2.1 hstep_ne
      ⟨C c, by rw [mul_comm]; exact hstep⟩).2
  have hroot_transfer :
      (∀ r ∈ (rayDifferentialStep a b kappa h rho P).roots, r ≤ h) ↔
        ∀ r ∈ (rayDifferentialStep a b kappa h rho p).roots, r ≤ h := by
    rw [hstep, roots_C_mul _ hc]
  have houtmult :
      (rayDifferentialStep a b kappa h rho P).rootMultiplicity h =
        (rayDifferentialStep a b kappa h rho p).rootMultiplicity h := by
    rw [hstep]
    exact rootMultiplicity_C_mul hc _
  refine ⟨hstep_ne, hstep_splits, ?_, ?_⟩
  · rw [← hroot_transfer, hpack.2.2.1, hmultP]
  · rw [← hmultP, ← houtmult]
    exact hpack.2.2.2

/-! ## Interval differential operators -/

/-- The scaled interval differential operator
`f ↦ ρ ((α X + β) f + κ (X - L) (X - U) f')`. -/
@[expose] def intervalDifferentialOperator
    (alpha beta rho kappa L U : ℝ) : Module.End ℝ ℝ[X] where
  toFun p := C rho *
    ((C alpha * X + C beta) * p +
      C kappa * (X - C L) * (X - C U) * p.derivative)
  map_add' p q := by simp only [derivative_add, mul_add]; ring
  map_smul' c p := by
    simp only [smul_eq_C_mul, derivative_C_mul, RingHom.id_apply]
    ring

/-- The interval differential operator has its advertised pointwise formula. -/
@[simp] theorem intervalDifferentialOperator_apply
    (alpha beta rho kappa L U : ℝ) (p : ℝ[X]) :
    intervalDifferentialOperator alpha beta rho kappa L U p =
      C rho * ((C alpha * X + C beta) * p +
        C kappa * (X - C L) * (X - C U) * p.derivative) := rfl

/-- One shifted factor of a scaled interval differential operator. -/
@[expose] def intervalDifferentialStep
    (alpha beta rho kappa L U xi : ℝ) (p : ℝ[X]) : ℝ[X] :=
  (C (rho * alpha) * X + C (rho * beta - xi)) * p +
    C (rho * kappa) * (X - C L) * (X - C U) * p.derivative

/-- Subtracting `xi` times the identity gives the shifted interval step. -/
theorem intervalDifferentialOperator_sub_apply
    (alpha beta rho kappa L U xi : ℝ) (p : ℝ[X]) :
    intervalDifferentialOperator alpha beta rho kappa L U p - C xi * p =
      intervalDifferentialStep alpha beta rho kappa L U xi p := by
  simp only [intervalDifferentialOperator_apply, intervalDifferentialStep,
    map_mul, map_sub]
  ring

/-- The unscaled interval step `(a X + b) p + k (X - L) (X - U) p'`. -/
private def intervalRawStep (a b k L U : ℝ) (p : ℝ[X]) : ℝ[X] :=
  (C a * X + C b) * p +
    C k * (X - C L) * (X - C U) * p.derivative

private lemma intervalRawStep_swap (a b k L U : ℝ) (p : ℝ[X]) :
    intervalRawStep a b k L U p = intervalRawStep a b k U L p := by
  dsimp [intervalRawStep]
  ring

private lemma coeff_two_C_mul_X_sub_C_mul_X_sub_C (k L U : ℝ) :
    (C k * (X - C L) * (X - C U) : ℝ[X]).coeff 2 = k := by
  rw [show C k * (X - C L) * (X - C U) =
    C k * X ^ 2 - C (k * (L + U)) * X + C (k * L * U) by
      simp only [map_add, map_mul]
      ring]
  simp

private lemma intervalRawStep_degree_eq_and_leadingCoeff_pos
    {a b k L U : ℝ} {p : ℝ[X]} (htop : 0 < a + k * p.natDegree)
    (hp : HasPosLeadingCoeff p) :
    (intervalRawStep a b k L U p).natDegree = p.natDegree + 1 ∧
      HasPosLeadingCoeff (intervalRawStep a b k L U p) :=
  natDegree_eq_and_hasPosLeadingCoeff_mul_add_mul_derivative (by compute_degree)
    (by compute_degree!)
    (by rw [coeff_two_C_mul_X_sub_C_mul_X_sub_C]; simpa using htop) hp

private theorem intervalRawStep_strictInterl
    {a b k L U : ℝ} {p : ℝ[X]} (hk : 0 < k)
    (htop : 0 < a + k * p.natDegree) (hp : HasPosLeadingCoeff p)
    (hs : p.Splits) (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    StrictInterl p (intervalRawStep a b k L U p) := by
  have hpack := intervalRawStep_degree_eq_and_leadingCoeff_pos
    (b := b) (L := L) (U := U) htop hp
  apply MaWang.strictInterl_derivative_of_nonpos_of_splits hs
  · change p.natDegree ≤ (intervalRawStep a b k L U p).natDegree
    rw [hpack.1]
    lia
  · change (intervalRawStep a b k L U p).natDegree ≤ p.natDegree + 1
    rw [hpack.1]
  · change HasPosLeadingCoeff (intervalRawStep a b k L U p)
    exact hpack.2
  · exact hp
  · intro r hr
    have hrmem : r ∈ p.roots := (mem_roots hp.ne_zero).mpr hr
    have hrange := hroots r hrmem
    simp only [eval_mul, eval_C, eval_sub, eval_X]
    exact mul_nonpos_of_nonneg_of_nonpos
      (mul_nonneg hk.le (sub_nonneg.mpr hrange.1))
      (sub_nonpos.mpr hrange.2)

private lemma intervalRawStep_endpoint_factorization
    (a b k e o : ℝ) (p q : ℝ[X]) (m : ℕ)
    (hpq : (X - C e) ^ m * q = p) :
    intervalRawStep a b k e o p = (X - C e) ^ m *
      intervalRawStep (a + k * m) (b - k * m * o) k e o q := by
  have h := mul_add_mul_derivative_pow_X_sub_C_mul (C a * X + C b) (C k * (X - C o)) q e m
  rw [intervalRawStep, intervalRawStep, ← hpq]
  simp only [map_add, map_sub, map_mul, map_natCast] at h ⊢
  linear_combination h

private lemma endpointCofactor_top
    {a k e : ℝ} {p q : ℝ[X]} {m : ℕ} (hq : q ≠ 0)
    (hfactor : (X - C e) ^ m * q = p) (htop : 0 < a + k * p.natDegree) :
    0 < (a + k * m) + k * q.natDegree := by
  have hpow : ((X - C e) ^ m : ℝ[X]) ≠ 0 :=
    pow_ne_zero _ (X_sub_C_ne_zero e)
  have hdeg := natDegree_mul hpow hq
  rw [hfactor] at hdeg
  simp only [natDegree_pow, natDegree_X_sub_C, mul_one] at hdeg
  rw [hdeg] at htop
  push_cast at htop ⊢
  linarith

private lemma lower_endpoint_sign
    {q : ℝ[X]} {L : ℝ} (hs : q.Splits)
    (hpos : HasPosLeadingCoeff q) (hroots : ∀ r ∈ q.roots, L < r) :
    0 < (-1 : ℝ) ^ q.natDegree * q.eval L := by
  have hcard : q.roots.card = (q.roots.map (L - ·)).card := by simp
  rw [Polynomial.Splits.eval_eq_prod_roots hs L,
    ← Polynomial.splits_iff_card_roots.mp hs, mul_left_comm, hcard,
    ← Multiset.prod_map_neg]
  refine mul_pos hpos (Multiset.prod_pos fun y hy => ?_)
  obtain ⟨s, hs, rfl⟩ := Multiset.mem_map.mp hy
  obtain ⟨r, hr, rfl⟩ := Multiset.mem_map.mp hs
  linarith [hroots r hr]

/-- Splitting off the full multiplicity `m` of an endpoint `e` of the window `[L, U]` (with `o`
the other endpoint) leaves a cofactor `q` whose interval step `H` is in proper position with
`q`, factors the step of `p`, and has the endpoint value `(a e + b + k m (e - o)) q(e)`. -/
private theorem intervalRawStep_endpoint_cofactor
    {a b k L U e o : ℝ} {p : ℝ[X]} (hk : 0 < k)
    (htop : 0 < a + k * p.natDegree) (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) (hend : (e = L ∧ o = U) ∨ (e = U ∧ o = L)) :
    ∃ q H : ℝ[X], (X - C e) ^ p.rootMultiplicity e * q = p ∧ q.eval e ≠ 0 ∧ q.Splits ∧
      HasPosLeadingCoeff q ∧ (∀ r ∈ q.roots, r ∈ Icc L U ∧ r ≠ e) ∧
      StrictInterl q H ∧ H.natDegree = q.natDegree + 1 ∧ HasPosLeadingCoeff H ∧
      intervalRawStep a b k L U p = (X - C e) ^ p.rootMultiplicity e * H ∧
      H.eval e = (a * e + b + k * p.rootMultiplicity e * (e - o)) * q.eval e := by
  have hsw : ∀ a' b' q, intervalRawStep a' b' k L U q = intervalRawStep a' b' k e o q := by
    rcases hend with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact fun _ _ _ => rfl
    · exact fun _ _ _ => intervalRawStep_swap ..
  obtain ⟨q, hfactor, hqeval, hqpos, hqs⟩ := exists_pow_X_sub_C_mul_eval_ne_zero hp hs e
  generalize p.rootMultiplicity e = m at hfactor ⊢
  have hqroots := roots_cofactor_mem_and_ne hqpos.ne_zero hfactor hqeval hroots
  have hqtop := endpointCofactor_top hqpos.ne_zero hfactor htop
  have hpack := intervalRawStep_degree_eq_and_leadingCoeff_pos
    (b := b - k * m * o) (L := L) (U := U) hqtop hqpos
  refine ⟨q, intervalRawStep (a + k * m) (b - k * m * o) k L U q, hfactor, hqeval, hqs, hqpos,
    hqroots, intervalRawStep_strictInterl hk hqtop hqpos hqs fun r hr => (hqroots r hr).1,
    hpack.1, hpack.2, ?_, ?_⟩
  · rw [hsw, hsw, intervalRawStep_endpoint_factorization a b k e o p q m hfactor]
  · rw [hsw]
    simp only [intervalRawStep, eval_add, eval_mul, eval_C, eval_X, eval_sub, sub_self,
      zero_mul, mul_zero, add_zero]
    ring

private theorem intervalRawStep_roots_ge_iff
    {a b k L U : ℝ} {p : ℝ[X]} (hk : 0 < k)
    (htop : 0 < a + k * p.natDegree) (hp : HasPosLeadingCoeff p)
    (hs : p.Splits) (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    (∀ r ∈ (intervalRawStep a b k L U p).roots, L ≤ r) ↔
      0 ≤ -a * L - b + k * (U - L) * p.rootMultiplicity L := by
  obtain ⟨q, H, -, -, hqs, hqpos, hqroots, hqH, hHdeg, hHpos, hFfactor, hHeval⟩ :=
    intervalRawStep_endpoint_cofactor hk htop hp hs hroots (e := L) (o := U) (Or.inl ⟨rfl, rfl⟩)
  have hqL : ∀ r ∈ q.roots, L < r := fun r hr =>
    lt_of_le_of_ne (hqroots r hr).1.1 (hqroots r hr).2.symm
  refine (forall_mem_roots_iff_of_pow_X_sub_C_mul (S := Set.Ici L) (Set.mem_Ici.mpr le_rfl)
    hHpos.ne_zero hFfactor).trans
    ((roots_ge_iff_neg_one_pow_mul_eval_nonneg_of_interlaces (hqH.toInterlaces hHdeg.symm) hHpos
      hqL).trans ?_)
  have hsignEq : (-1 : ℝ) ^ H.natDegree * H.eval L =
      (-a * L - b + k * (U - L) * p.rootMultiplicity L) *
        ((-1 : ℝ) ^ q.natDegree * q.eval L) := by
    rw [hHdeg, pow_succ, hHeval]
    ring
  rw [hsignEq, mul_nonneg_iff_of_pos_right (lower_endpoint_sign hqs hqpos hqL)]

private theorem intervalRawStep_roots_le_iff
    {a b k L U : ℝ} {p : ℝ[X]} (hk : 0 < k)
    (htop : 0 < a + k * p.natDegree) (hp : HasPosLeadingCoeff p)
    (hs : p.Splits) (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    (∀ r ∈ (intervalRawStep a b k L U p).roots, r ≤ U) ↔
      0 ≤ a * U + b + k * (U - L) * p.rootMultiplicity U := by
  obtain ⟨q, H, -, hqeval, hqs, hqpos, hqroots, hqH, hHdeg, hHpos, hFfactor, hHeval⟩ :=
    intervalRawStep_endpoint_cofactor hk htop hp hs hroots (e := U) (o := L) (Or.inr ⟨rfl, rfl⟩)
  have hqU : ∀ r ∈ q.roots, r < U := fun r hr =>
    lt_of_le_of_ne (hqroots r hr).1.2 (hqroots r hr).2
  refine (forall_mem_roots_iff_of_pow_X_sub_C_mul (S := Set.Iic U) (Set.mem_Iic.mpr le_rfl)
    hHpos.ne_zero hFfactor).trans
    ((roots_le_iff_eval_nonneg_of_interlaces (hqH.toInterlaces hHdeg.symm) hHpos hqU).trans ?_)
  rw [hHeval, mul_nonneg_iff_of_pos_right (eval_pos_of_all_roots_lt hqpos.ne_zero hqs hqpos hqU)]
  constructor <;> intro h <;> linarith

private lemma intervalRawStep_rootMultiplicity_eq
    {a b k L U e o : ℝ} {p : ℝ[X]} (hk : 0 < k)
    (htop : 0 < a + k * p.natDegree) (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) (hend : (e = L ∧ o = U) ∨ (e = U ∧ o = L)) :
    (intervalRawStep a b k L U p).rootMultiplicity e =
      if a * e + b + k * p.rootMultiplicity e * (e - o) = 0 then p.rootMultiplicity e + 1
      else p.rootMultiplicity e := by
  obtain ⟨q, H, -, hqeval, -, -, -, hqH, -, hHpos, hFfactor, hHeval⟩ :=
    intervalRawStep_endpoint_cofactor hk htop hp hs hroots hend
  have hq0 : q.rootMultiplicity e = 0 :=
    rootMultiplicity_eq_zero (by simpa [IsRoot.def] using hqeval)
  have hHmult : H.rootMultiplicity e =
      if a * e + b + k * p.rootMultiplicity e * (e - o) = 0 then 1 else 0 := by
    split_ifs with heq
    · have hroot : H.IsRoot e := by rw [IsRoot.def, hHeval, heq, zero_mul]
      have hpos := (rootMultiplicity_pos hHpos.ne_zero).2 hroot
      have hle := (hqH.rootMultiplicity_bounds e).2
      rw [hq0] at hle
      lia
    · exact rootMultiplicity_eq_zero (by rw [IsRoot.def, hHeval]; exact mul_ne_zero heq hqeval)
  rw [hFfactor, rootMultiplicity_mul
    (mul_ne_zero (pow_ne_zero _ (X_sub_C_ne_zero e)) hHpos.ne_zero),
    rootMultiplicity_X_sub_C_pow, hHmult]
  split_ifs <;> rfl

/-- A scaled interval step with positive top coefficient raises the degree by one, keeps the
leading coefficient positive and is in proper position with its input, even when the input has
roots at either endpoint of `[L, U]`. -/
theorem intervalDifferentialStep_strictInterl
    {alpha beta rho kappa L U xi : ℝ} {p : ℝ[X]}
    (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * p.natDegree)
    (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    (intervalDifferentialStep alpha beta rho kappa L U xi p).natDegree =
        p.natDegree + 1 ∧
      HasPosLeadingCoeff
        (intervalDifferentialStep alpha beta rho kappa L U xi p) ∧
      StrictInterl p (intervalDifferentialStep alpha beta rho kappa L U xi p) := by
  have htop' : 0 < rho * alpha + rho * kappa * p.natDegree := by
    nlinarith [mul_pos hrho htop]
  have hpack := intervalRawStep_degree_eq_and_leadingCoeff_pos
    (b := rho * beta - xi) (L := L) (U := U) htop' hp
  exact ⟨hpack.1, hpack.2,
    intervalRawStep_strictInterl (mul_pos hrho hkappa) htop' hp hs hroots⟩

/-- The endpoint multiplicities of the scaled interval step increase by one exactly when `xi`
equals the corresponding threshold, and are otherwise unchanged. -/
theorem intervalDifferentialStep_rootMultiplicity
    {alpha beta rho kappa L U xi : ℝ} {p : ℝ[X]}
    (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * p.natDegree)
    (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    (intervalDifferentialStep alpha beta rho kappa L U xi p).rootMultiplicity L =
        (if xi = rho * (alpha * L + beta - kappa * (U - L) * p.rootMultiplicity L)
          then p.rootMultiplicity L + 1 else p.rootMultiplicity L) ∧
      (intervalDifferentialStep alpha beta rho kappa L U xi p).rootMultiplicity U =
        if xi = rho * (alpha * U + beta + kappa * (U - L) * p.rootMultiplicity U)
          then p.rootMultiplicity U + 1 else p.rootMultiplicity U := by
  have htop' : 0 < rho * alpha + rho * kappa * p.natDegree := by
    nlinarith [mul_pos hrho htop]
  have hk := mul_pos hrho hkappa
  constructor
  · refine (intervalRawStep_rootMultiplicity_eq (b := rho * beta - xi) (e := L) (o := U) hk
      htop' hp hs hroots (Or.inl ⟨rfl, rfl⟩)).trans (if_congr ?_ rfl rfl)
    constructor <;> intro h <;> linear_combination (-1 : ℝ) * h
  · refine (intervalRawStep_rootMultiplicity_eq (b := rho * beta - xi) (e := U) (o := L) hk
      htop' hp hs hroots (Or.inr ⟨rfl, rfl⟩)).trans (if_congr ?_ rfl rfl)
    constructor <;> intro h <;> linear_combination (-1 : ℝ) * h

/-- The complete scaled interval step under the exact top-coefficient
hypothesis.  It gives degree growth, interlacing, the sharp closed-window
criterion, and monotonicity of both endpoint multiplicities. -/
theorem intervalDifferentialStep_closed
    {alpha beta rho kappa L U xi : ℝ} {p : ℝ[X]}
    (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * p.natDegree)
    (hp : HasPosLeadingCoeff p) (hs : p.Splits)
    (hroots : ∀ r ∈ p.roots, r ∈ Icc L U) :
    (intervalDifferentialStep alpha beta rho kappa L U xi p).natDegree =
        p.natDegree + 1 ∧
      HasPosLeadingCoeff
        (intervalDifferentialStep alpha beta rho kappa L U xi p) ∧
      (intervalDifferentialStep alpha beta rho kappa L U xi p).Splits ∧
      Interlaces p (intervalDifferentialStep alpha beta rho kappa L U xi p) ∧
      ((∀ r ∈ (intervalDifferentialStep alpha beta rho kappa L U xi p).roots,
          r ∈ Icc L U) ↔
        rho * (alpha * L + beta - kappa * (U - L) * p.rootMultiplicity L) ≤ xi ∧
          xi ≤ rho *
            (alpha * U + beta + kappa * (U - L) * p.rootMultiplicity U)) ∧
      p.rootMultiplicity L ≤
        (intervalDifferentialStep alpha beta rho kappa L U xi p).rootMultiplicity L ∧
      p.rootMultiplicity U ≤
        (intervalDifferentialStep alpha beta rho kappa L U xi p).rootMultiplicity U := by
  have hstrict := intervalDifferentialStep_strictInterl (beta := beta) (xi := xi) hrho hkappa
    htop hp hs hroots
  have hmult := intervalDifferentialStep_rootMultiplicity (beta := beta) (xi := xi) hrho hkappa
    htop hp hs hroots
  have htop' : 0 < rho * alpha + rho * kappa * p.natDegree := by
    nlinarith [mul_pos hrho htop]
  have hk := mul_pos hrho hkappa
  have hlower := intervalRawStep_roots_ge_iff (b := rho * beta - xi) hk htop' hp hs hroots
  have hupper := intervalRawStep_roots_le_iff (b := rho * beta - xi) hk htop' hp hs hroots
  refine ⟨hstrict.1, hstrict.2.1, hstrict.2.2.2.1.2, hstrict.2.2.toInterlaces hstrict.1.symm,
    ?_, ?_, ?_⟩
  · constructor
    · intro hall
      have hlo := hlower.mp (fun r hr => (hall r hr).1)
      have hup := hupper.mp (fun r hr => (hall r hr).2)
      constructor <;> nlinarith
    · rintro ⟨hlo, hup⟩ r hr
      exact ⟨hlower.mpr (by nlinarith) r hr, hupper.mpr (by nlinarith) r hr⟩
  · rw [hmult.1]
    split_ifs <;> lia
  · rw [hmult.2]
    split_ifs <;> lia

/-- The basis map whose `n`th basis element is the `n`th iterate of the ray
differential operator applied to the seed `g`. -/
@[expose] def rayBasisMap (a b kappa h : ℝ) (g p : ℝ[X]) : ℝ[X] :=
  basisTransform (fun n ↦ (rayDifferentialOperator a b kappa h ^ n) g) p

/-- The ray basis map is the polynomial functional calculus of its differential
operator, applied to the seed. -/
theorem rayBasisMap_eq_aeval_apply (a b kappa h : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g p =
      (aeval (rayDifferentialOperator a b kappa h) p : Module.End ℝ ℝ[X]) g :=
  basisTransform_iterate_eq_aeval_apply _ _ _

/-- A source linear factor acts by the corresponding shifted ray step. -/
theorem rayBasisMap_linear_mul (a b kappa h rho : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g ((X - C rho) * p) =
      rayDifferentialStep a b kappa h rho (rayBasisMap a b kappa h g p) := by
  rw [rayBasisMap, basisTransform_iterate_X_sub_C_mul,
    rayDifferentialOperator_sub_apply]
  rw [rayBasisMap]

/-- Scalar multiplication commutes with a ray basis map. -/
theorem rayBasisMap_C_mul (a b kappa h c : ℝ) (g p : ℝ[X]) :
    rayBasisMap a b kappa h g (C c * p) = C c * rayBasisMap a b kappa h g p := by
  rw [rayBasisMap, show C c * p = c • p by rw [smul_eq_C_mul], basisTransform_smul]
  rw [rayBasisMap]

/-- The ray basis map sends the constant polynomial `1` to its seed. -/
@[simp] theorem rayBasisMap_one (a b kappa h : ℝ) (g : ℝ[X]) :
    rayBasisMap a b kappa h g 1 = g := by
  rw [rayBasisMap]
  simpa using Polynomial.basisTransform_X_pow
    (fun n ↦ (rayDifferentialOperator a b kappa h ^ n) g) 0

private theorem rayBasisMap_prod_package
    {a b kappa h : ℝ} {g : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hg : IsRealRootedIn (Set.Iic h) g) (s : Multiset ℝ)
    (hs : ∀ rho ∈ s, rho ≤ a + b * h + kappa * g.rootMultiplicity h) :
    IsRealRootedIn (Set.Iic h)
        (rayBasisMap a b kappa h g (s.map (X - C ·)).prod) ∧
      g.rootMultiplicity h ≤
        (rayBasisMap a b kappa h g (s.map (X - C ·)).prod).rootMultiplicity h := by
  induction s using Multiset.induction_on with
  | empty =>
      simpa only [Multiset.map_zero, Multiset.prod_zero, rayBasisMap_one] using
        (⟨hg, le_rfl⟩ : IsRealRootedIn (Set.Iic h) g ∧
          g.rootMultiplicity h ≤ g.rootMultiplicity h)
  | @cons rho s ih =>
      have ih' := ih (fun r hr => hs r (Multiset.mem_cons_of_mem hr))
      let q := rayBasisMap a b kappa h g (s.map (X - C ·)).prod
      have hq : IsRealRootedIn (Set.Iic h) q := ih'.1
      have hmult : g.rootMultiplicity h ≤ q.rootMultiplicity h := by
        simpa only [q] using ih'.2
      have hrho : rho ≤ a + b * h + kappa * q.rootMultiplicity h := by
        have hmult_real : (g.rootMultiplicity h : ℝ) ≤ q.rootMultiplicity h := by
          exact_mod_cast hmult
        have hmul : kappa * g.rootMultiplicity h ≤ kappa * q.rootMultiplicity h :=
          mul_le_mul_of_nonneg_left hmult_real hkappa
        exact (hs rho (Multiset.mem_cons_self _ _)).trans (by linarith)
      have hpack := rayDifferentialStep_package (a := a) (rho := rho)
        hb hkappa hq.1 hq.2.1
        (fun r hr => hq.2.2 r hr)
      have hstep_roots :
          ∀ r ∈ (rayDifferentialStep a b kappa h rho q).roots, r ≤ h :=
        hpack.2.2.1.mpr hrho
      have hidentity :
          rayBasisMap a b kappa h g
              ((rho ::ₘ s).map (X - C ·)).prod =
            rayDifferentialStep a b kappa h rho q := by
        simp only [Multiset.map_cons, Multiset.prod_cons]
        exact rayBasisMap_linear_mul a b kappa h rho g _
      rw [hidentity]
      exact ⟨⟨hpack.1, hpack.2.1, hstep_roots⟩, hmult.trans hpack.2.2.2⟩

/-- Exact source ray for a basis map generated by
`f ↦ (a + bX)f + κ(X-h)f'`.  This includes constant seeds and `κ = 0`. -/
theorem rayBasisMap_maps_realRootedIn_iff
    {a b kappa h : ℝ} {g : ℝ[X]} (hb : 0 < b) (hkappa : 0 ≤ kappa)
    (hg : IsRealRootedIn (Set.Iic h) g) (S : Set ℝ) :
    (∀ p, IsRealRootedIn S p →
      IsRealRootedIn (Set.Iic h) (rayBasisMap a b kappa h g p)) ↔
      S ⊆ Set.Iic (a + b * h + kappa * g.rootMultiplicity h) := by
  constructor
  · intro hmaps rho hrho
    let p : ℝ[X] := X - C rho
    have hp : IsRealRootedIn S p := by
      refine ⟨(isRealRooted_X_sub_C rho).1, (isRealRooted_X_sub_C rho).2, ?_⟩
      intro r hr
      dsimp [p] at hr
      rw [roots_X_sub_C, Multiset.mem_singleton] at hr
      simpa [hr] using hrho
    have himage := hmaps p hp
    have hlinear : rayBasisMap a b kappa h g p =
        rayDifferentialStep a b kappa h rho g := by
      dsimp [p]
      simpa only [mul_one, rayBasisMap_one] using
        rayBasisMap_linear_mul a b kappa h rho g 1
    have hpack := rayDifferentialStep_package (a := a) (rho := rho)
      hb hkappa hg.1 hg.2.1
      (fun r hr => hg.2.2 r hr)
    have hroot : ∀ r ∈ (rayDifferentialStep a b kappa h rho g).roots, r ≤ h := by
      intro r hr
      have hr' : r ∈ (rayBasisMap a b kappa h g p).roots := by
        simpa only [hlinear] using hr
      have hh := himage.2.2 r hr'
      change r ≤ h at hh
      exact hh
    exact hpack.2.2.1.mp hroot
  · intro hS p hp
    have hroots : ∀ rho ∈ p.roots,
        rho ≤ a + b * h + kappa * g.rootMultiplicity h := by
      intro rho hrho
      exact hS (hp.2.2 rho hrho)
    have hprod := rayBasisMap_prod_package hb hkappa hg p.roots hroots
    let q := (p.roots.map (X - C ·)).prod
    have hlc : p.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hp.1
    have hfactor : p = C p.leadingCoeff * q := by
      dsimp [q]
      exact hp.2.1.eq_prod_roots
    have himage : rayBasisMap a b kappa h g p =
        C p.leadingCoeff * rayBasisMap a b kappa h g q := by
      calc
        rayBasisMap a b kappa h g p =
            rayBasisMap a b kappa h g (C p.leadingCoeff * q) :=
          congrArg (rayBasisMap a b kappa h g) hfactor
        _ = _ := rayBasisMap_C_mul a b kappa h p.leadingCoeff g q
    refine ⟨?_, ?_, ?_⟩
    · rw [himage]
      exact mul_ne_zero (C_ne_zero.mpr hlc) hprod.1.1
    · rw [himage]
      exact hprod.1.2.1.C_mul _
    · intro r hr
      rw [himage, roots_C_mul _ hlc] at hr
      exact hprod.1.2.2 r hr

end RealRooted
