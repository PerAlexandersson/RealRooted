/-!
# Basis maps generated by interval differential operators

We determine the exact source interval for the basis map generated by
`f ↦ ρ ((α X + β) f + κ (X - L) (X - U) f')` from an arbitrary
standard seed supported in `[L, U]`.  The affine slope may be negative; the
sharp hypothesis is positivity of the prospective top coefficient.
-/

public section

open Polynomial Set

noncomputable section

namespace RealRooted

/-- The basis map whose `n`th basis element is the `n`th iterate of the scaled
interval differential operator applied to `g`. -/
@[expose] def intervalBasisMap
    (alpha beta rho kappa L U : ℝ) (g p : ℝ[X]) : ℝ[X] :=
  basisTransform
    (fun n ↦ (intervalDifferentialOperator alpha beta rho kappa L U ^ n) g) p

/-- The interval basis map is the polynomial functional calculus of its
differential operator, applied to the seed. -/
theorem intervalBasisMap_eq_aeval_apply
    (alpha beta rho kappa L U : ℝ) (g p : ℝ[X]) :
    intervalBasisMap alpha beta rho kappa L U g p =
      (aeval (intervalDifferentialOperator alpha beta rho kappa L U) p :
        Module.End ℝ ℝ[X]) g :=
  basisTransform_iterate_eq_aeval_apply _ _ _

/-- A source linear factor acts by the corresponding shifted interval step. -/
theorem intervalBasisMap_linear_mul
    (alpha beta rho kappa L U xi : ℝ) (g p : ℝ[X]) :
    intervalBasisMap alpha beta rho kappa L U g ((X - C xi) * p) =
      intervalDifferentialStep alpha beta rho kappa L U xi
        (intervalBasisMap alpha beta rho kappa L U g p) := by
  rw [intervalBasisMap_eq_aeval_apply, intervalBasisMap_eq_aeval_apply]
  simp only [map_mul, map_sub, aeval_X, aeval_C, Module.End.mul_apply,
    LinearMap.sub_apply, Module.algebraMap_end_apply, smul_eq_C_mul]
  rw [intervalDifferentialOperator_sub_apply]

/-- Scalar multiplication commutes with an interval basis map. -/
theorem intervalBasisMap_C_mul
    (alpha beta rho kappa L U c : ℝ) (g p : ℝ[X]) :
    intervalBasisMap alpha beta rho kappa L U g (C c * p) =
      C c * intervalBasisMap alpha beta rho kappa L U g p := by
  rw [intervalBasisMap, show C c * p = c • p by rw [smul_eq_C_mul],
    basisTransform_smul]
  rw [intervalBasisMap]

/-- The interval basis map sends the constant polynomial `1` to its seed. -/
@[simp] theorem intervalBasisMap_one
    (alpha beta rho kappa L U : ℝ) (g : ℝ[X]) :
    intervalBasisMap alpha beta rho kappa L U g 1 = g := by
  rw [intervalBasisMap]
  simpa using Polynomial.basisTransform_X_pow
    (fun n ↦ (intervalDifferentialOperator alpha beta rho kappa L U ^ n) g) 0

/-- The five invariants propagated while adjoining source linear factors. -/
private def IntervalBasisMapPackage (g q : ℝ[X]) (L U : ℝ) : Prop :=
  IsRealRootedIn (Icc L U) q ∧ HasPosLeadingCoeff q ∧
    g.natDegree ≤ q.natDegree ∧
    g.rootMultiplicity L ≤ q.rootMultiplicity L ∧
    g.rootMultiplicity U ≤ q.rootMultiplicity U

/-- One admissible source root propagates the interval-basis-map package. -/
private theorem intervalDifferentialStep_package
    {alpha beta rho kappa L U xi : ℝ} {g q : ℝ[X]}
    (hLU : L < U) (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * g.natDegree)
    (hq : IntervalBasisMapPackage g q L U)
    (hxi : xi ∈ Icc
      (rho * (alpha * L + beta -
        kappa * (U - L) * g.rootMultiplicity L))
      (rho * (alpha * U + beta +
        kappa * (U - L) * g.rootMultiplicity U))) :
    IntervalBasisMapPackage g
      (intervalDifferentialStep alpha beta rho kappa L U xi q) L U := by
  have hqtop : 0 < alpha + kappa * q.natDegree := by
    have hqdeg' : (g.natDegree : ℝ) ≤ q.natDegree := by
      exact_mod_cast hq.2.2.1
    nlinarith
  have hweight : 0 ≤ rho * kappa * (U - L) := by positivity
  have hxiL : rho * (alpha * L + beta -
      kappa * (U - L) * q.rootMultiplicity L) ≤ xi := by
    have hmult : (g.rootMultiplicity L : ℝ) ≤ q.rootMultiplicity L := by
      exact_mod_cast hq.2.2.2.1
    have hmul := mul_le_mul_of_nonneg_left hmult hweight
    calc
      rho * (alpha * L + beta - kappa * (U - L) * q.rootMultiplicity L) =
          rho * (alpha * L + beta) -
            (rho * kappa * (U - L)) * q.rootMultiplicity L := by ring
      _ ≤ rho * (alpha * L + beta) -
            (rho * kappa * (U - L)) * g.rootMultiplicity L :=
        sub_le_sub_left hmul _
      _ = rho * (alpha * L + beta -
          kappa * (U - L) * g.rootMultiplicity L) := by ring
      _ ≤ xi := hxi.1
  have hxiU : xi ≤ rho * (alpha * U + beta +
      kappa * (U - L) * q.rootMultiplicity U) := by
    have hmult : (g.rootMultiplicity U : ℝ) ≤ q.rootMultiplicity U := by
      exact_mod_cast hq.2.2.2.2
    have hmul := mul_le_mul_of_nonneg_left hmult hweight
    calc
      xi ≤ rho * (alpha * U + beta +
          kappa * (U - L) * g.rootMultiplicity U) := hxi.2
      _ = rho * (alpha * U + beta) +
            (rho * kappa * (U - L)) * g.rootMultiplicity U := by ring
      _ ≤ rho * (alpha * U + beta) +
            (rho * kappa * (U - L)) * q.rootMultiplicity U :=
        add_le_add le_rfl hmul
      _ = rho * (alpha * U + beta +
          kappa * (U - L) * q.rootMultiplicity U) := by ring
  have hpack := intervalDifferentialStep_closed (beta := beta) hrho
    hkappa hqtop hq.2.1 hq.1.2.1 (fun r hr => hq.1.2.2 r hr) (xi := xi)
  have hstepRoots := hpack.2.2.2.2.1.mpr ⟨hxiL, hxiU⟩
  exact ⟨⟨hpack.2.1.ne_zero, hpack.2.2.1, hstepRoots⟩, hpack.2.1,
    hq.2.2.1.trans (by rw [hpack.1]; exact Nat.le_add_right _ _),
    hq.2.2.2.1.trans hpack.2.2.2.2.2.1,
    hq.2.2.2.2.trans hpack.2.2.2.2.2.2⟩

/-- The interval package is preserved along a product of admissible source
linear factors. -/
private theorem intervalBasisMap_prod_package
    {alpha beta rho kappa L U : ℝ} {g : ℝ[X]}
    (hLU : L < U) (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * g.natDegree)
    (hgpos : HasPosLeadingCoeff g) (hg : IsRealRootedIn (Icc L U) g)
    (s : Multiset ℝ)
    (hs : ∀ xi ∈ s,
      xi ∈ Icc
        (rho * (alpha * L + beta -
          kappa * (U - L) * g.rootMultiplicity L))
        (rho * (alpha * U + beta +
          kappa * (U - L) * g.rootMultiplicity U))) :
    IsRealRootedIn (Icc L U)
        (intervalBasisMap alpha beta rho kappa L U g
          (s.map (X - C ·)).prod) ∧
      HasPosLeadingCoeff
        (intervalBasisMap alpha beta rho kappa L U g
          (s.map (X - C ·)).prod) ∧
      g.natDegree ≤
        (intervalBasisMap alpha beta rho kappa L U g
          (s.map (X - C ·)).prod).natDegree ∧
      g.rootMultiplicity L ≤
        (intervalBasisMap alpha beta rho kappa L U g
          (s.map (X - C ·)).prod).rootMultiplicity L ∧
      g.rootMultiplicity U ≤
        (intervalBasisMap alpha beta rho kappa L U g
          (s.map (X - C ·)).prod).rootMultiplicity U := by
  change IntervalBasisMapPackage g
    (intervalBasisMap alpha beta rho kappa L U g
      (s.map (X - C ·)).prod) L U
  induction s using Multiset.induction_on with
  | empty =>
      simpa only [Multiset.map_zero, Multiset.prod_zero, intervalBasisMap_one,
        IntervalBasisMapPackage]
        using (⟨hg, hgpos, le_rfl, le_rfl, le_rfl⟩ :
          IntervalBasisMapPackage g g L U)
  | @cons xi s ih =>
      have ih' := ih (fun z hz => hs z (Multiset.mem_cons_of_mem hz))
      let q := intervalBasisMap alpha beta rho kappa L U g
        (s.map (X - C ·)).prod
      have hxi := hs xi (Multiset.mem_cons_self _ _)
      have hidentity :
          intervalBasisMap alpha beta rho kappa L U g
              ((xi ::ₘ s).map (X - C ·)).prod =
            intervalDifferentialStep alpha beta rho kappa L U xi q := by
        simp only [Multiset.map_cons, Multiset.prod_cons]
        exact intervalBasisMap_linear_mul alpha beta rho kappa L U xi g _
      rw [hidentity]
      exact intervalDifferentialStep_package hLU hrho hkappa htop ih' hxi

/-- Exact source interval for the basis map generated by
`f ↦ ρ ((αX + β)f + κ(X-L)(X-U)f')` from a standard seed in
`[L, U]`.  The result allows negative `α` under the exact top-coefficient
condition. -/
theorem intervalBasisMap_maps_realRootedIn_iff
    {alpha beta rho kappa L U : ℝ} {g : ℝ[X]}
    (hLU : L < U) (hrho : 0 < rho) (hkappa : 0 < kappa)
    (htop : 0 < alpha + kappa * g.natDegree)
    (hgpos : HasPosLeadingCoeff g) (hg : IsRealRootedIn (Icc L U) g)
    (S : Set ℝ) :
    (∀ p, IsRealRootedIn S p →
      IsRealRootedIn (Icc L U)
        (intervalBasisMap alpha beta rho kappa L U g p)) ↔
      S ⊆ Icc
        (rho * (alpha * L + beta -
          kappa * (U - L) * g.rootMultiplicity L))
        (rho * (alpha * U + beta +
          kappa * (U - L) * g.rootMultiplicity U)) := by
  constructor
  · intro hmaps xi hxi
    let p : ℝ[X] := X - C xi
    have hp : IsRealRootedIn S p := by
      refine ⟨(isRealRooted_X_sub_C xi).1, (isRealRooted_X_sub_C xi).2, ?_⟩
      intro r hr
      dsimp [p] at hr
      rw [roots_X_sub_C, Multiset.mem_singleton] at hr
      simpa [hr] using hxi
    have himage := hmaps p hp
    have hlinear : intervalBasisMap alpha beta rho kappa L U g p =
        intervalDifferentialStep alpha beta rho kappa L U xi g := by
      dsimp [p]
      simpa only [mul_one, intervalBasisMap_one] using
        intervalBasisMap_linear_mul alpha beta rho kappa L U xi g 1
    have hpack := intervalDifferentialStep_closed (beta := beta) hrho
      hkappa htop hgpos hg.2.1 (fun r hr => hg.2.2 r hr) (xi := xi)
    have hroot :
        ∀ r ∈ (intervalDifferentialStep alpha beta rho kappa L U xi g).roots,
          r ∈ Icc L U := by
      intro r hr
      apply himage.2.2 r
      simpa only [hlinear] using hr
    exact hpack.2.2.2.2.1.mp hroot
  · intro hS p hp
    have hroots : ∀ xi ∈ p.roots,
        xi ∈ Icc
          (rho * (alpha * L + beta -
            kappa * (U - L) * g.rootMultiplicity L))
          (rho * (alpha * U + beta +
            kappa * (U - L) * g.rootMultiplicity U)) := by
      intro xi hxi
      exact hS (hp.2.2 xi hxi)
    have hprod := intervalBasisMap_prod_package hLU hrho hkappa htop hgpos hg
      p.roots hroots
    let q := (p.roots.map (X - C ·)).prod
    have hlc : p.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hp.1
    have hfactor : p = C p.leadingCoeff * q := by
      dsimp [q]
      exact hp.2.1.eq_prod_roots
    have himage : intervalBasisMap alpha beta rho kappa L U g p =
        C p.leadingCoeff * intervalBasisMap alpha beta rho kappa L U g q := by
      calc
        intervalBasisMap alpha beta rho kappa L U g p =
            intervalBasisMap alpha beta rho kappa L U g
              (C p.leadingCoeff * q) :=
          congrArg (intervalBasisMap alpha beta rho kappa L U g) hfactor
        _ = _ := intervalBasisMap_C_mul alpha beta rho kappa L U
          p.leadingCoeff g q
    refine ⟨?_, ?_, ?_⟩
    · rw [himage]
      exact mul_ne_zero (C_ne_zero.mpr hlc) hprod.1.1
    · rw [himage]
      exact hprod.1.2.1.C_mul _
    · intro r hr
      rw [himage, roots_C_mul _ hlc] at hr
      exact hprod.1.2.2 r hr

/-- For the normalized affine endpoint recurrence, confinement of every row
to `[-1, 0]` is equivalent to the two sharp endpoint inequalities at every
step.  This includes equality and hence both closed endpoints. -/
theorem normalizedAffineEndpointSequence_roots_mem_Icc_iff
    {P : ℕ → ℝ[X]} {a b d : ℝ} (ha : 0 < a)
    (hrec : ∀ n,
      P (n + 1) = C (((n : ℝ) + 1)⁻¹) *
        MaWang.endpointStep 1 a (b - d * n) (P n))
    (hzero : P 0 = 1) :
    (∀ n r, r ∈ (P n).roots → r ∈ Icc (-1 : ℝ) 0) ↔
      ∀ n,
        0 ≤ b - d * n + (P n).rootMultiplicity 0 ∧
          0 ≤ a + (P n).rootMultiplicity (-1) - (b - d * n) := by
  constructor
  · intro hall
    have hrows : ∀ n, HasPosLeadingCoeff (P n) ∧ (P n).Splits := by
      intro n
      induction n with
      | zero =>
          rw [hzero]
          exact ⟨by simp [HasPosLeadingCoeff], by simp⟩
      | succ n ih =>
          have hpack := affineEndpointStep_closed (c := b - d * n) ha
            ih.1 ih.2 (fun r hr => hall n r hr)
          have hcpos : 0 < ((n : ℝ) + 1)⁻¹ := by positivity
          rw [hrec n]
          refine ⟨?_, hpack.2.2.1.C_mul _⟩
          rw [HasPosLeadingCoeff, leadingCoeff_mul, leadingCoeff_C]
          exact mul_pos hcpos hpack.2.1
    intro n
    have hpack := affineEndpointStep_closed (c := b - d * n) ha
      (hrows n).1 (hrows n).2 (fun r hr => hall n r hr)
    have hcne : ((n : ℝ) + 1)⁻¹ ≠ 0 := by positivity
    apply hpack.2.2.2.2.1.mp
    intro r hr
    apply hall (n + 1) r
    rw [hrec n, roots_C_mul _ hcne]
    exact hr
  · intro hthreshold n
    have key : ∀ m, HasPosLeadingCoeff (P m) ∧ (P m).Splits ∧
        ∀ r ∈ (P m).roots, r ∈ Icc (-1 : ℝ) 0 := by
      intro m
      induction m with
      | zero =>
          rw [hzero]
          refine ⟨by simp [HasPosLeadingCoeff], by simp, ?_⟩
          intro r hr
          simp at hr
      | succ m ih =>
          have hpack := affineEndpointStep_closed (c := b - d * m) ha
            ih.1 ih.2.1 ih.2.2
          have hstepRoots := hpack.2.2.2.2.1.mpr (hthreshold m)
          have hcpos : 0 < ((m : ℝ) + 1)⁻¹ := by positivity
          have hcne : ((m : ℝ) + 1)⁻¹ ≠ 0 := hcpos.ne'
          rw [hrec m]
          refine ⟨?_, hpack.2.2.1.C_mul _, ?_⟩
          · rw [HasPosLeadingCoeff, leadingCoeff_mul, leadingCoeff_C]
            exact mul_pos hcpos hpack.2.1
          · intro r hr
            rw [roots_C_mul _ hcne] at hr
            exact hstepRoots r hr
    exact (key n).2.2

/-- Confinement supplies positive-leading-coefficient and splitting
certificates for every normalized affine row. -/
private lemma normalizedAffineEndpointSequence_certificates
    {P : ℕ → ℝ[X]} {a b d : ℝ} (ha : 0 < a)
    (hrec : ∀ n,
      P (n + 1) = C (((n : ℝ) + 1)⁻¹) *
        MaWang.endpointStep 1 a (b - d * n) (P n))
    (hzero : P 0 = 1)
    (hall : ∀ n r, r ∈ (P n).roots → r ∈ Icc (-1 : ℝ) 0) :
    ∀ n, HasPosLeadingCoeff (P n) ∧ (P n).Splits := by
  intro n
  induction n with
  | zero =>
      rw [hzero]
      exact ⟨by simp [HasPosLeadingCoeff], by simp⟩
  | succ n ih =>
      have hpack := affineEndpointStep_closed (c := b - d * n) ha
        ih.1 ih.2 (fun r hr => hall n r hr)
      have hcpos : 0 < ((n : ℝ) + 1)⁻¹ := by positivity
      rw [hrec n]
      refine ⟨?_, hpack.2.2.1.C_mul _⟩
      rw [HasPosLeadingCoeff, leadingCoeff_mul, leadingCoeff_C]
      exact mul_pos hcpos hpack.2.1

/-- A nondecreasing integer counter which stays above a positive affine line
must hit every integer level at an equality index. -/
private lemma exists_affine_threshold_hit
    {lambda mu : ℝ} {m : ℕ → ℕ} (hlambda : 0 < lambda)
    (hmzero : m 0 = 0)
    (hstep : ∀ n, m (n + 1) =
      if lambda * (n : ℝ) - mu = m n then m n + 1 else m n)
    (hbound : ∀ n : ℕ, lambda * (n : ℝ) - mu ≤ m n) (k : ℕ) :
    ∃ n, m n = k ∧ lambda * (n : ℝ) - mu = k := by
  obtain ⟨N, hN⟩ := exists_nat_gt (((k : ℝ) + mu) / lambda)
  have hkN : (k : ℝ) < lambda * (N : ℝ) - mu := by
    rw [div_lt_iff₀ hlambda] at hN
    nlinarith
  have hmN : k < m N := by exact_mod_cast hkN.trans_le (hbound N)
  clear hN hkN
  induction N with
  | zero =>
      rw [hmzero] at hmN
      lia
  | succ N ih =>
      rw [hstep N] at hmN
      by_cases heq : lambda * (N : ℝ) - mu = m N
      · rw [ite_eq_left heq] at hmN
        by_cases hmk : m N = k
        · exact ⟨N, hmk, hmk ▸ heq⟩
        · apply ih
          lia
      · rw [ite_eq_right heq] at hmN
        exact ih hmN

/-- Two consecutive affine threshold hits force reciprocal-integer slope and
integer-multiple intercept. -/
private lemma affine_threshold_parameters
    {lambda mu : ℝ} {m : ℕ → ℕ} (hlambda : 0 < lambda)
    (hmzero : m 0 = 0)
    (hstep : ∀ n, m (n + 1) =
      if lambda * (n : ℝ) - mu = m n then m n + 1 else m n)
    (hbound : ∀ n : ℕ, lambda * (n : ℝ) - mu ≤ m n) :
    ∃ r s : ℕ, 0 < r ∧ lambda = 1 / (r : ℝ) ∧ mu = (s : ℝ) / r := by
  obtain ⟨s, -, hs⟩ :=
    exists_affine_threshold_hit hlambda hmzero hstep hbound 0
  obtain ⟨t, -, ht⟩ :=
    exists_affine_threshold_hit hlambda hmzero hstep hbound 1
  norm_num at hs ht
  have hstReal : (s : ℝ) < t := by
    apply lt_of_mul_lt_mul_left (a := lambda) (by linarith [hs, ht]) hlambda.le
  have hst : s < t := by exact_mod_cast hstReal
  let r := t - s
  have hr : 0 < r := Nat.sub_pos_of_lt hst
  have hrcast : (r : ℝ) = (t : ℝ) - s := by
    exact Nat.cast_sub hst.le
  have hprod : lambda * (r : ℝ) = 1 := by
    rw [hrcast]
    nlinarith [hs, ht]
  have hlambdaR : lambda = 1 / (r : ℝ) :=
    (eq_div_iff (by positivity : (r : ℝ) ≠ 0)).2 hprod
  refine ⟨r, s, hr, hlambdaR, ?_⟩
  calc
    mu = lambda * (s : ℝ) := (sub_eq_zero.mp hs).symm
    _ = (s : ℝ) / r := by rw [hlambdaR, one_div, inv_mul_eq_div]

/-- Complete arithmetic trichotomy forced by confinement of every normalized
affine endpoint row to `[-1,0]`. -/
theorem normalizedAffineEndpointSequence_parameter_trichotomy
    {P : ℕ → ℝ[X]} {a b d : ℝ} (ha : 0 < a)
    (hrec : ∀ n,
      P (n + 1) = C (((n : ℝ) + 1)⁻¹) *
        MaWang.endpointStep 1 a (b - d * n) (P n))
    (hzero : P 0 = 1)
    (hall : ∀ n r, r ∈ (P n).roots → r ∈ Icc (-1 : ℝ) 0) :
    0 ≤ b ∧ b ≤ a ∧
      (d = 0 ∨
        (∃ r s : ℕ, 0 < r ∧ d = 1 / (r : ℝ) ∧ b = (s : ℝ) / r) ∨
        ∃ r s : ℕ, 0 < r ∧ d = -(1 / (r : ℝ)) ∧ a - b = (s : ℝ) / r) := by
  have hthreshold :=
    (normalizedAffineEndpointSequence_roots_mem_Icc_iff ha hrec hzero).mp hall
  have hba := hthreshold 0
  have hmone (e : ℝ) : (1 : ℝ[X]).rootMultiplicity e = 0 := by
    rw [show (1 : ℝ[X]) = C 1 by simp, rootMultiplicity_C]
  rw [hzero, hmone, hmone] at hba
  norm_num at hba
  refine ⟨hba.1, by linarith [hba.2], ?_⟩
  rcases lt_trichotomy d 0 with hd | hd | hd
  · right
    right
    let m : ℕ → ℕ := fun n => (P n).rootMultiplicity (-1)
    have hmzero : m 0 = 0 := by simp [m, hzero]
    have hcert := normalizedAffineEndpointSequence_certificates ha hrec hzero hall
    have hbound : ∀ n : ℕ, (-d) * (n : ℝ) - (a - b) ≤ m n := by
      intro n
      dsimp [m]
      nlinarith [(hthreshold n).2]
    have hstep : ∀ n, m (n + 1) =
        if (-d) * (n : ℝ) - (a - b) = m n then m n + 1 else m n := by
      intro n
      have hpack := affineEndpointStep_closed (c := b - d * n) ha
        (hcert n).1 (hcert n).2 (fun z hz => hall n z hz)
      have hc : ((n : ℝ) + 1)⁻¹ ≠ 0 := by positivity
      dsimp [m]
      rw [hrec n, rootMultiplicity_C_mul hc]
      rw [hpack.2.2.2.2.2.2]
      congr 1
      apply propext
      constructor <;> intro h <;> nlinarith
    obtain ⟨r, s, hr, hslope, hintercept⟩ :=
      affine_threshold_parameters (neg_pos.mpr hd) hmzero hstep hbound
    exact ⟨r, s, hr, by linarith, hintercept⟩
  · exact Or.inl hd
  · right
    left
    let m : ℕ → ℕ := fun n => (P n).rootMultiplicity 0
    have hmzero : m 0 = 0 := by simp [m, hzero]
    have hcert := normalizedAffineEndpointSequence_certificates ha hrec hzero hall
    have hbound : ∀ n : ℕ, d * (n : ℝ) - b ≤ m n := by
      intro n
      dsimp [m]
      nlinarith [(hthreshold n).1]
    have hstep : ∀ n, m (n + 1) =
        if d * (n : ℝ) - b = m n then m n + 1 else m n := by
      intro n
      have hpack := affineEndpointStep_closed (c := b - d * n) ha
        (hcert n).1 (hcert n).2 (fun z hz => hall n z hz)
      have hc : ((n : ℝ) + 1)⁻¹ ≠ 0 := by positivity
      dsimp [m]
      rw [hrec n, rootMultiplicity_C_mul hc]
      rw [hpack.2.2.2.2.2.1]
      congr 1
      apply propext
      constructor <;> intro h <;> nlinarith
    exact affine_threshold_parameters hd hmzero hstep hbound

/-- A reduced rational generating function whose numerator reaches the full
denominator degree has the denominator recurrence only after row zero.  One
extra forward shift gives an all-index recurrence, and every all-index
pure-lag recurrence has strictly larger order than the reduced denominator. -/
theorem pureLag_initial_index_exception
    {K : Type*} [Field K] (P : ℕ → K) (D N : K[X]) (q : ℕ)
    (hq : 0 < q) (hcoprime : IsCoprime D N) (hD0 : D.coeff 0 = 1)
    (hDdeg : D.natDegree = q) (hNdeg : N.natDegree = q)
    (hNlead : N.leadingCoeff ≠ 0)
    (hgen : (D : PowerSeries K) * PowerSeries.mk P = (N : PowerSeries K)) :
    (∀ n, P (n + 1 + q) =
        -∑ j ∈ Finset.range q,
          D.coeff (j + 1) * P (n + 1 + q - (j + 1))) ∧
      (∀ n, P (n + (q + 1)) =
        -∑ j ∈ Finset.range (q + 1),
          D.coeff (j + 1) * P (n + (q + 1) - (j + 1))) ∧
      P q ≠ -∑ j ∈ Finset.range q,
        D.coeff (j + 1) * P (q - (j + 1)) ∧
      ∀ (m : ℕ) (Q : K[X]), 0 < m → Q.coeff 0 = 1 →
        Q.natDegree ≤ m →
        (∀ n, P (n + m) =
          -∑ j ∈ Finset.range m,
            Q.coeff (j + 1) * P (n + m - (j + 1))) →
        q < m := by
  refine ⟨pureLag_tail_of_mul_generatingSeries_eq P D N q hD0 hDdeg
      hNdeg.le hgen,
    pureLag_succ_all_of_mul_generatingSeries_eq P D N q hD0 hDdeg
      hNdeg.le hgen,
    pureLag_zero_ne_of_mul_generatingSeries_eq P D N q hD0 hDdeg
      hNdeg hNlead hgen, ?_⟩
  intro m Q hm hQ0 hQdeg hrec
  have hqm : q ≤ m :=
    le_order_of_coprime_mul_generatingSeries_eq_of_pureLag
      P D N Q q m hm hcoprime hDdeg hQ0 hQdeg hgen hrec
  exact hqm.lt_of_ne fun hmq => by
    subst m
    exact (not_exists_pureLag_of_full_coprime_mul_generatingSeries_eq
      P D N q hq hcoprime hD0 hDdeg hNdeg hgen)
      ⟨Q, hQ0, hQdeg, hrec⟩

/-! ## Rational endpoint families over `ℝ(x)` -/

/-- The binomial `1 + t/r`, regarded as a polynomial in the series variable
over the rational-function field `ℝ(x)`. -/
@[expose] def endpointPositiveBinomial (r : ℕ) : (RatFunc ℝ)[X] :=
  1 + C ((RatFunc.C (r : ℝ))⁻¹) * X

/-- The binomial `1 - t/r`, regarded as a polynomial in the series variable
over the rational-function field `ℝ(x)`. -/
@[expose] def endpointNegativeBinomial (r : ℕ) : (RatFunc ℝ)[X] :=
  1 - C ((RatFunc.C (r : ℝ))⁻¹) * X

/-- Numerator `(1+t/r)^s` in the positive-slope rational endpoint family. -/
@[expose] def endpointPositiveNumerator (r s : ℕ) : (RatFunc ℝ)[X] :=
  endpointPositiveBinomial r ^ s

/-- Denominator `[1-x((1+t/r)^r-1)]^k` in the positive-slope rational
endpoint family. -/
@[expose] def endpointPositiveDenominator (r k : ℕ) : (RatFunc ℝ)[X] :=
  (1 - C RatFunc.X * (endpointPositiveBinomial r ^ r - 1)) ^ k

/-- Numerator `(1-t/r)^s` in the negative-slope rational endpoint family. -/
@[expose] def endpointNegativeNumerator (r s : ℕ) : (RatFunc ℝ)[X] :=
  endpointNegativeBinomial r ^ s

/-- Denominator `[(1+x)(1-t/r)^r-x]^k` in the negative-slope rational
endpoint family. -/
@[expose] def endpointNegativeDenominator (r k : ℕ) : (RatFunc ℝ)[X] :=
  (C (1 + RatFunc.X) * endpointNegativeBinomial r ^ r - C RatFunc.X) ^ k

/-- Coefficients of the positive-slope closed-form generating series. -/
@[expose] def endpointPositiveRationalSequence (r s k n : ℕ) : RatFunc ℝ :=
  PowerSeries.coeff n
    (PowerSeries.invOfUnit
        (endpointPositiveDenominator r k : PowerSeries (RatFunc ℝ)) 1 *
      (endpointPositiveNumerator r s : PowerSeries (RatFunc ℝ)))

/-- Coefficients of the negative-slope closed-form generating series. -/
@[expose] def endpointNegativeRationalSequence (r s k n : ℕ) : RatFunc ℝ :=
  PowerSeries.coeff n
    (PowerSeries.invOfUnit
        (endpointNegativeDenominator r k : PowerSeries (RatFunc ℝ)) 1 *
      (endpointNegativeNumerator r s : PowerSeries (RatFunc ℝ)))

/-- The positive-slope denominator is normalized at the series origin. -/
@[simp] theorem endpointPositiveDenominator_coeff_zero (r k : ℕ) :
    (endpointPositiveDenominator r k).coeff 0 = 1 := by
  rw [coeff_zero_eq_eval_zero]
  simp [endpointPositiveDenominator, endpointPositiveBinomial]

/-- The negative-slope denominator is normalized at the series origin. -/
@[simp] theorem endpointNegativeDenominator_coeff_zero (r k : ℕ) :
    (endpointNegativeDenominator r k).coeff 0 = 1 := by
  rw [coeff_zero_eq_eval_zero]
  simp [endpointNegativeDenominator, endpointNegativeBinomial]

/-- The closed-form series of a normalized denominator `D` and numerator `N` satisfies
`D * series = N`. -/
private lemma mul_mk_invOfUnit_mul_eq {K : Type*} [Field K] (D N : K[X]) (hD0 : D.coeff 0 = 1) :
    (D : PowerSeries K) * PowerSeries.mk (fun n => PowerSeries.coeff n
      (PowerSeries.invOfUnit (D : PowerSeries K) 1 * (N : PowerSeries K))) = N := by
  have hmk : (PowerSeries.mk fun n => PowerSeries.coeff n
      (PowerSeries.invOfUnit (D : PowerSeries K) 1 * (N : PowerSeries K))) =
      PowerSeries.invOfUnit (D : PowerSeries K) 1 * (N : PowerSeries K) :=
    PowerSeries.ext fun n => by simp
  rw [hmk, ← mul_assoc, PowerSeries.mul_invOfUnit _ 1 (by simpa using hD0), one_mul]

/-- The positive closed form has exactly the advertised polynomial-denominator
generating-function identity. -/
theorem endpointPositiveRationalSequence_generatingFunction (r s k : ℕ) :
    (endpointPositiveDenominator r k : PowerSeries (RatFunc ℝ)) *
        PowerSeries.mk (endpointPositiveRationalSequence r s k) =
      (endpointPositiveNumerator r s : PowerSeries (RatFunc ℝ)) :=
  mul_mk_invOfUnit_mul_eq _ _ (endpointPositiveDenominator_coeff_zero r k)

/-- The negative closed form has exactly the advertised polynomial-denominator
generating-function identity. -/
theorem endpointNegativeRationalSequence_generatingFunction (r s k : ℕ) :
    (endpointNegativeDenominator r k : PowerSeries (RatFunc ℝ)) *
        PowerSeries.mk (endpointNegativeRationalSequence r s k) =
      (endpointNegativeNumerator r s : PowerSeries (RatFunc ℝ)) :=
  mul_mk_invOfUnit_mul_eq _ _ (endpointNegativeDenominator_coeff_zero r k)

/-- The inverse of `r` in `ℝ(x)` is nonzero for positive `r`. -/
private lemma ratFuncC_natCast_inv_ne_zero {r : ℕ} (hr : 0 < r) :
    (RatFunc.C (r : ℝ))⁻¹ ≠ 0 := by
  have hr0 : (r : ℝ) ≠ 0 := by exact_mod_cast hr.ne'
  exact inv_ne_zero (by simpa using RatFunc.C_injective.ne hr0)

/-- The positive binomial has degree one when `r` is positive. -/
private lemma endpointPositiveBinomial_natDegree (r : ℕ) (hr : 0 < r) :
    (endpointPositiveBinomial r).natDegree = 1 := by
  rw [endpointPositiveBinomial]
  compute_degree
  simpa using ratFuncC_natCast_inv_ne_zero hr

/-- The negative binomial has degree one when `r` is positive. -/
private lemma endpointNegativeBinomial_natDegree (r : ℕ) (hr : 0 < r) :
    (endpointNegativeBinomial r).natDegree = 1 := by
  rw [endpointNegativeBinomial]
  compute_degree
  simpa using ratFuncC_natCast_inv_ne_zero hr

/-- The unpowered positive-slope denominator has degree `r`. -/
private lemma endpointPositiveDenominatorBase_natDegree (r : ℕ) (hr : 0 < r) :
    (1 - C RatFunc.X * (endpointPositiveBinomial r ^ r - 1) :
      (RatFunc ℝ)[X]).natDegree = r := by
  let A := endpointPositiveBinomial r
  have hAdeg : A.natDegree = 1 := endpointPositiveBinomial_natDegree r hr
  have hform : (1 - C RatFunc.X * (A ^ r - 1) : (RatFunc ℝ)[X]) =
      C (1 + RatFunc.X) - C RatFunc.X * A ^ r := by
    rw [map_add, map_one]
    ring
  rw [hform, natDegree_sub_eq_right_of_natDegree_lt]
  · rw [natDegree_C_mul RatFunc.X_ne_zero, natDegree_pow, hAdeg]
    simp
  · rw [natDegree_C, natDegree_C_mul RatFunc.X_ne_zero, natDegree_pow, hAdeg]
    simpa using hr

/-- The rational function `1+x` is nonzero. -/
private lemma one_add_ratFuncX_ne_zero : (1 + RatFunc.X : RatFunc ℝ) ≠ 0 := by
  have hpoly : (1 + X : ℝ[X]) ≠ 0 := by
    intro h
    have := congrArg (fun p : ℝ[X] => p.coeff 1) h
    rw [coeff_add, coeff_one, coeff_X, coeff_zero] at this
    norm_num at this
  have hmap := RatFunc.algebraMap_ne_zero hpoly
  simpa only [map_add, map_one, RatFunc.algebraMap_X] using hmap

/-- The unpowered negative-slope denominator has degree `r`. -/
private lemma endpointNegativeDenominatorBase_natDegree (r : ℕ) (hr : 0 < r) :
    (C (1 + RatFunc.X) * endpointNegativeBinomial r ^ r - C RatFunc.X :
      (RatFunc ℝ)[X]).natDegree = r := by
  rw [natDegree_sub_eq_left_of_natDegree_lt]
  · rw [natDegree_C_mul one_add_ratFuncX_ne_zero, natDegree_pow,
      endpointNegativeBinomial_natDegree r hr]
    simp
  · rw [natDegree_C, natDegree_C_mul one_add_ratFuncX_ne_zero, natDegree_pow,
      endpointNegativeBinomial_natDegree r hr]
    simpa using hr

/-- Degree data for the positive-slope rational numerator and denominator. -/
theorem endpointPositiveRational_natDegrees (r s k : ℕ) (hr : 0 < r) :
    (endpointPositiveNumerator r s).natDegree = s ∧
      (endpointPositiveDenominator r k).natDegree = k * r := by
  constructor
  · rw [endpointPositiveNumerator, natDegree_pow,
      endpointPositiveBinomial_natDegree r hr, mul_one]
  · rw [endpointPositiveDenominator, natDegree_pow,
      endpointPositiveDenominatorBase_natDegree r hr]

/-- Degree data for the negative-slope rational numerator and denominator. -/
theorem endpointNegativeRational_natDegrees (r s k : ℕ) (hr : 0 < r) :
    (endpointNegativeNumerator r s).natDegree = s ∧
      (endpointNegativeDenominator r k).natDegree = k * r := by
  constructor
  · rw [endpointNegativeNumerator, natDegree_pow,
      endpointNegativeBinomial_natDegree r hr, mul_one]
  · rw [endpointNegativeDenominator, natDegree_pow,
      endpointNegativeDenominatorBase_natDegree r hr]

/-- The positive binomial and its unpowered denominator are coprime over
`ℝ(x)`. -/
private lemma endpointPositiveBase_isCoprime (r : ℕ) (hr : 0 < r) :
    IsCoprime (endpointPositiveBinomial r)
      (1 - C RatFunc.X * (endpointPositiveBinomial r ^ r - 1)) := by
  let A := endpointPositiveBinomial r
  let x : RatFunc ℝ := RatFunc.X
  let u : RatFunc ℝ := 1 + x
  have hu : u ≠ 0 := one_add_ratFuncX_ne_zero
  have hrform : r - 1 + 1 = r := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hr.ne')
  refine ⟨C (x * u⁻¹) * A ^ (r - 1), C u⁻¹, ?_⟩
  change (C (x * u⁻¹) * A ^ (r - 1)) * A +
      C u⁻¹ * (1 - C x * (A ^ r - 1)) = 1
  rw [mul_assoc, ← pow_succ, hrform]
  rw [show (1 - C x * (A ^ r - 1) : (RatFunc ℝ)[X]) =
      C u - C x * A ^ r by
    dsimp [u]
    rw [map_add, map_one]
    ring]
  calc
    C (x * u⁻¹) * A ^ r + C u⁻¹ * (C u - C x * A ^ r) =
        C (u⁻¹ * u) := by
      simp only [map_mul]
      ring
    _ = 1 := by simp [inv_mul_cancel₀ hu]

/-- The negative binomial and its unpowered denominator are coprime over
`ℝ(x)`. -/
private lemma endpointNegativeBase_isCoprime (r : ℕ) (hr : 0 < r) :
    IsCoprime (endpointNegativeBinomial r)
      (C (1 + RatFunc.X) * endpointNegativeBinomial r ^ r - C RatFunc.X) := by
  let A := endpointNegativeBinomial r
  let x : RatFunc ℝ := RatFunc.X
  let u : RatFunc ℝ := 1 + x
  have hx : x ≠ 0 := RatFunc.X_ne_zero
  have hrform : r - 1 + 1 = r := Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hr.ne')
  refine ⟨C (x⁻¹ * u) * A ^ (r - 1), -C x⁻¹, ?_⟩
  change (C (x⁻¹ * u) * A ^ (r - 1)) * A +
      (-C x⁻¹) * (C u * A ^ r - C x) = 1
  rw [mul_assoc, ← pow_succ, hrform]
  calc
    C (x⁻¹ * u) * A ^ r + -C x⁻¹ * (C u * A ^ r - C x) =
        C (x⁻¹ * x) := by
      simp only [map_mul]
      ring
    _ = 1 := by simp [inv_mul_cancel₀ hx]

/-- The positive-slope numerator and denominator are reduced over `ℝ(x)`. -/
theorem endpointPositiveRational_isCoprime (r s k : ℕ) (hr : 0 < r) :
    IsCoprime (endpointPositiveDenominator r k)
      (endpointPositiveNumerator r s) := by
  rw [endpointPositiveDenominator, endpointPositiveNumerator]
  exact (endpointPositiveBase_isCoprime r hr).symm.pow

/-- The negative-slope numerator and denominator are reduced over `ℝ(x)`. -/
theorem endpointNegativeRational_isCoprime (r s k : ℕ) (hr : 0 < r) :
    IsCoprime (endpointNegativeDenominator r k)
      (endpointNegativeNumerator r s) := by
  rw [endpointNegativeDenominator, endpointNegativeNumerator]
  exact (endpointNegativeBase_isCoprime r hr).symm.pow

/-- A polynomial-denominator generating series is rational exactly when its
coefficients satisfy an eventual normalized pure-lag recurrence. -/
theorem rationalGeneratingSeries_iff_eventually_pureLag
    {K : Type*} [Field K] (P : ℕ → K) :
    (∃ (q n₀ : ℕ) (D N : K[X]), 0 < q ∧ D.coeff 0 = 1 ∧
        D.natDegree = q ∧ N.natDegree < n₀ + q ∧
        (D : PowerSeries K) * PowerSeries.mk P = (N : PowerSeries K)) ↔
      ∃ (q n₀ : ℕ) (Q : K[X]), 0 < q ∧ Q.coeff 0 = 1 ∧
        Q.natDegree = q ∧ ∀ n, P (n₀ + n + q) =
          -∑ j ∈ Finset.range q,
            Q.coeff (j + 1) * P (n₀ + n + q - (j + 1)) := by
  constructor
  · rintro ⟨q, n₀, D, N, hq, hD0, hDdeg, hNdeg, hgen⟩
    refine ⟨q, n₀, D, hq, hD0, hDdeg, fun n => ?_⟩
    exact pureLag_eq_of_mul_generatingSeries_eq P D N q (n₀ + n) hD0 hDdeg
      (hNdeg.trans_le (by lia)) hgen
  · rintro ⟨q, n₀, Q, hq, hQ0, hQdeg, hrec⟩
    obtain ⟨M, hMdeg, hgen⟩ :=
      exists_natDegree_lt_add_and_mul_generatingSeries_eq_of_pureLag_from
        P Q q n₀ hq hQ0 hQdeg.le hrec
    exact ⟨q, n₀, Q, M, hq, hQ0, hQdeg, hMdeg, hgen⟩

/-- A reduced denominator bounds the order of every eventual pure-lag
recurrence, not merely recurrences valid from row zero. -/
theorem le_eventualOrder_of_coprime_mul_generatingSeries_eq
    {K : Type*} [Field K] (P : ℕ → K) (D N Q : K[X])
    (q n₀ m : ℕ) (hm : 0 < m) (hcoprime : IsCoprime D N)
    (hDdeg : D.natDegree = q) (hQ0 : Q.coeff 0 = 1)
    (hQdeg : Q.natDegree ≤ m)
    (hgen : (D : PowerSeries K) * PowerSeries.mk P = (N : PowerSeries K))
    (hrec : ∀ n, P (n₀ + n + m) =
      -∑ j ∈ Finset.range m,
        Q.coeff (j + 1) * P (n₀ + n + m - (j + 1))) :
    q ≤ m := by
  obtain ⟨M, -, hQgen⟩ :=
    exists_natDegree_lt_add_and_mul_generatingSeries_eq_of_pureLag_from
      P Q m n₀ hm hQ0 hQdeg hrec
  rw [← hDdeg]
  exact (natDegree_le_of_coprime_mul_generatingSeries_eq
    P D N Q M hcoprime hQ0 hgen hQgen).trans hQdeg

/-- The denominator recurrence of the positive-slope family has order `k*r`
and is valid after row zero when the numerator degree is at most `k*r`. -/
theorem endpointPositiveRational_pureLag_tail
    {r s k : ℕ} (hr : 0 < r) (hs : s ≤ k * r) (n : ℕ) :
    endpointPositiveRationalSequence r s k (n + 1 + k * r) =
      -∑ j ∈ Finset.range (k * r),
        (endpointPositiveDenominator r k).coeff (j + 1) *
          endpointPositiveRationalSequence r s k
            (n + 1 + k * r - (j + 1)) := by
  have hdeg := endpointPositiveRational_natDegrees r s k hr
  exact pureLag_tail_of_mul_generatingSeries_eq
    (endpointPositiveRationalSequence r s k)
    (endpointPositiveDenominator r k) (endpointPositiveNumerator r s)
    (k * r) (endpointPositiveDenominator_coeff_zero r k) hdeg.2
    (by simpa [hdeg.1] using hs)
    (endpointPositiveRationalSequence_generatingFunction r s k) n

/-- If `s < k*r`, the positive-slope denominator recurrence is valid from
row zero. -/
theorem endpointPositiveRational_pureLag_all
    {r s k : ℕ} (hr : 0 < r) (hs : s < k * r) (n : ℕ) :
    endpointPositiveRationalSequence r s k (n + k * r) =
      -∑ j ∈ Finset.range (k * r),
        (endpointPositiveDenominator r k).coeff (j + 1) *
          endpointPositiveRationalSequence r s k (n + k * r - (j + 1)) := by
  have hdeg := endpointPositiveRational_natDegrees r s k hr
  exact pureLag_all_of_mul_generatingSeries_eq
    (endpointPositiveRationalSequence r s k)
    (endpointPositiveDenominator r k) (endpointPositiveNumerator r s)
    (k * r) (endpointPositiveDenominator_coeff_zero r k) hdeg.2
    (by simpa [hdeg.1] using hs)
    (endpointPositiveRationalSequence_generatingFunction r s k) n

/-- The denominator recurrence of the negative-slope family has order `k*r`
and is valid after row zero when the numerator degree is at most `k*r`. -/
theorem endpointNegativeRational_pureLag_tail
    {r s k : ℕ} (hr : 0 < r) (hs : s ≤ k * r) (n : ℕ) :
    endpointNegativeRationalSequence r s k (n + 1 + k * r) =
      -∑ j ∈ Finset.range (k * r),
        (endpointNegativeDenominator r k).coeff (j + 1) *
          endpointNegativeRationalSequence r s k
            (n + 1 + k * r - (j + 1)) := by
  have hdeg := endpointNegativeRational_natDegrees r s k hr
  exact pureLag_tail_of_mul_generatingSeries_eq
    (endpointNegativeRationalSequence r s k)
    (endpointNegativeDenominator r k) (endpointNegativeNumerator r s)
    (k * r) (endpointNegativeDenominator_coeff_zero r k) hdeg.2
    (by simpa [hdeg.1] using hs)
    (endpointNegativeRationalSequence_generatingFunction r s k) n

/-- If `s < k*r`, the negative-slope denominator recurrence is valid from
row zero. -/
theorem endpointNegativeRational_pureLag_all
    {r s k : ℕ} (hr : 0 < r) (hs : s < k * r) (n : ℕ) :
    endpointNegativeRationalSequence r s k (n + k * r) =
      -∑ j ∈ Finset.range (k * r),
        (endpointNegativeDenominator r k).coeff (j + 1) *
          endpointNegativeRationalSequence r s k (n + k * r - (j + 1)) := by
  have hdeg := endpointNegativeRational_natDegrees r s k hr
  exact pureLag_all_of_mul_generatingSeries_eq
    (endpointNegativeRationalSequence r s k)
    (endpointNegativeDenominator r k) (endpointNegativeNumerator r s)
    (k * r) (endpointNegativeDenominator_coeff_zero r k) hdeg.2
    (by simpa [hdeg.1] using hs)
    (endpointNegativeRationalSequence_generatingFunction r s k) n

/-- Every eventual pure-lag recurrence for the positive-slope rational family
has order at least `k*r`. -/
theorem endpointPositiveRational_minimalEventualOrder
    {r s k n₀ m : ℕ} (hr : 0 < r) (hm : 0 < m) (Q : (RatFunc ℝ)[X])
    (hQ0 : Q.coeff 0 = 1) (hQdeg : Q.natDegree ≤ m)
    (hrec : ∀ n, endpointPositiveRationalSequence r s k (n₀ + n + m) =
      -∑ j ∈ Finset.range m, Q.coeff (j + 1) *
        endpointPositiveRationalSequence r s k (n₀ + n + m - (j + 1))) :
    k * r ≤ m := by
  exact le_eventualOrder_of_coprime_mul_generatingSeries_eq
    (endpointPositiveRationalSequence r s k)
    (endpointPositiveDenominator r k) (endpointPositiveNumerator r s) Q
    (k * r) n₀ m hm (endpointPositiveRational_isCoprime r s k hr)
    (endpointPositiveRational_natDegrees r s k hr).2 hQ0 hQdeg
    (endpointPositiveRationalSequence_generatingFunction r s k) hrec

/-- Every eventual pure-lag recurrence for the negative-slope rational family
has order at least `k*r`. -/
theorem endpointNegativeRational_minimalEventualOrder
    {r s k n₀ m : ℕ} (hr : 0 < r) (hm : 0 < m) (Q : (RatFunc ℝ)[X])
    (hQ0 : Q.coeff 0 = 1) (hQdeg : Q.natDegree ≤ m)
    (hrec : ∀ n, endpointNegativeRationalSequence r s k (n₀ + n + m) =
      -∑ j ∈ Finset.range m, Q.coeff (j + 1) *
        endpointNegativeRationalSequence r s k (n₀ + n + m - (j + 1))) :
    k * r ≤ m := by
  exact le_eventualOrder_of_coprime_mul_generatingSeries_eq
    (endpointNegativeRationalSequence r s k)
    (endpointNegativeDenominator r k) (endpointNegativeNumerator r s) Q
    (k * r) n₀ m hm (endpointNegativeRational_isCoprime r s k hr)
    (endpointNegativeRational_natDegrees r s k hr).2 hQ0 hQdeg
    (endpointNegativeRationalSequence_generatingFunction r s k) hrec

/-- A positive-slope numerator is nonzero, hence has nonzero leading
coefficient. -/
private lemma endpointPositiveNumerator_leadingCoeff_ne_zero
    (r s : ℕ) (hr : 0 < r) :
    (endpointPositiveNumerator r s).leadingCoeff ≠ 0 :=
  leadingCoeff_ne_zero.mpr <| pow_ne_zero _ <|
    ne_zero_of_natDegree_gt (n := 0) (by simp [endpointPositiveBinomial_natDegree r hr])

/-- A negative-slope numerator is nonzero, hence has nonzero leading
coefficient. -/
private lemma endpointNegativeNumerator_leadingCoeff_ne_zero
    (r s : ℕ) (hr : 0 < r) :
    (endpointNegativeNumerator r s).leadingCoeff ≠ 0 :=
  leadingCoeff_ne_zero.mpr <| pow_ne_zero _ <|
    ne_zero_of_natDegree_gt (n := 0) (by simp [endpointNegativeBinomial_natDegree r hr])

/-- At the boundary `s=k*r`, the positive-slope order-`k*r` recurrence starts
at row one and fails at row zero; the shortest all-index order is `k*r+1`. -/
theorem endpointPositiveRational_initialIndexException
    {r k : ℕ} (hr : 0 < r) (hk : 0 < k) :
    (∀ n, endpointPositiveRationalSequence r (k * r) k (n + 1 + k * r) =
        -∑ j ∈ Finset.range (k * r),
          (endpointPositiveDenominator r k).coeff (j + 1) *
            endpointPositiveRationalSequence r (k * r) k
              (n + 1 + k * r - (j + 1))) ∧
      (∀ n, endpointPositiveRationalSequence r (k * r) k (n + (k * r + 1)) =
        -∑ j ∈ Finset.range (k * r + 1),
          (endpointPositiveDenominator r k).coeff (j + 1) *
            endpointPositiveRationalSequence r (k * r) k
              (n + (k * r + 1) - (j + 1))) ∧
      endpointPositiveRationalSequence r (k * r) k (k * r) ≠
        -∑ j ∈ Finset.range (k * r),
          (endpointPositiveDenominator r k).coeff (j + 1) *
            endpointPositiveRationalSequence r (k * r) k (k * r - (j + 1)) ∧
      ∀ (m : ℕ) (Q : (RatFunc ℝ)[X]), 0 < m → Q.coeff 0 = 1 →
        Q.natDegree ≤ m →
        (∀ n, endpointPositiveRationalSequence r (k * r) k (n + m) =
          -∑ j ∈ Finset.range m, Q.coeff (j + 1) *
            endpointPositiveRationalSequence r (k * r) k
              (n + m - (j + 1))) → k * r < m := by
  have hq : 0 < k * r := Nat.mul_pos hk hr
  have hdeg := endpointPositiveRational_natDegrees r (k * r) k hr
  exact pureLag_initial_index_exception
    (endpointPositiveRationalSequence r (k * r) k)
    (endpointPositiveDenominator r k) (endpointPositiveNumerator r (k * r))
    (k * r) hq (endpointPositiveRational_isCoprime r (k * r) k hr)
    (endpointPositiveDenominator_coeff_zero r k) hdeg.2 hdeg.1
    (endpointPositiveNumerator_leadingCoeff_ne_zero r (k * r) hr)
    (endpointPositiveRationalSequence_generatingFunction r (k * r) k)

/-- At the boundary `s=k*r`, the negative-slope order-`k*r` recurrence starts
at row one and fails at row zero; the shortest all-index order is `k*r+1`. -/
theorem endpointNegativeRational_initialIndexException
    {r k : ℕ} (hr : 0 < r) (hk : 0 < k) :
    (∀ n, endpointNegativeRationalSequence r (k * r) k (n + 1 + k * r) =
        -∑ j ∈ Finset.range (k * r),
          (endpointNegativeDenominator r k).coeff (j + 1) *
            endpointNegativeRationalSequence r (k * r) k
              (n + 1 + k * r - (j + 1))) ∧
      (∀ n, endpointNegativeRationalSequence r (k * r) k (n + (k * r + 1)) =
        -∑ j ∈ Finset.range (k * r + 1),
          (endpointNegativeDenominator r k).coeff (j + 1) *
            endpointNegativeRationalSequence r (k * r) k
              (n + (k * r + 1) - (j + 1))) ∧
      endpointNegativeRationalSequence r (k * r) k (k * r) ≠
        -∑ j ∈ Finset.range (k * r),
          (endpointNegativeDenominator r k).coeff (j + 1) *
            endpointNegativeRationalSequence r (k * r) k (k * r - (j + 1)) ∧
      ∀ (m : ℕ) (Q : (RatFunc ℝ)[X]), 0 < m → Q.coeff 0 = 1 →
        Q.natDegree ≤ m →
        (∀ n, endpointNegativeRationalSequence r (k * r) k (n + m) =
          -∑ j ∈ Finset.range m, Q.coeff (j + 1) *
            endpointNegativeRationalSequence r (k * r) k
              (n + m - (j + 1))) → k * r < m := by
  have hq : 0 < k * r := Nat.mul_pos hk hr
  have hdeg := endpointNegativeRational_natDegrees r (k * r) k hr
  exact pureLag_initial_index_exception
    (endpointNegativeRationalSequence r (k * r) k)
    (endpointNegativeDenominator r k) (endpointNegativeNumerator r (k * r))
    (k * r) hq (endpointNegativeRational_isCoprime r (k * r) k hr)
    (endpointNegativeDenominator_coeff_zero r k) hdeg.2 hdeg.1
    (endpointNegativeNumerator_leadingCoeff_ne_zero r (k * r) hr)
    (endpointNegativeRationalSequence_generatingFunction r (k * r) k)

end RealRooted
