/-!
# Pólya-frequency preservation for an order-two basis

We classify the basis transform attached to
`P (n + 2) = a P (n + 1) + (b X + c) P n`, including zero and repeated-root
boundary cases.
-/

@[expose] public section

open Polynomial

noncomputable section

namespace RealRooted

/-- The polynomial basis generated by a constant-coefficient order-two recurrence. -/
def orderTwoBasis (a b c s : ℝ) : ℕ → ℝ[X]
  | 0 => 1
  | 1 => C s
  | n + 2 => C a * orderTwoBasis a b c s (n + 1) +
      (C b * X + C c) * orderTwoBasis a b c s n

/-- The scalar recurrence formed by the constant coefficients of `orderTwoBasis`. -/
def orderTwoConstants (a c s : ℝ) : ℕ → ℝ
  | 0 => 1
  | 1 => s
  | n + 2 => a * orderTwoConstants a c s (n + 1) +
      c * orderTwoConstants a c s n

/-- Evaluating the order-two basis at zero gives its scalar constant recurrence. -/
theorem orderTwoBasis_eval_zero (a b c s : ℝ) (n : ℕ) :
    (orderTwoBasis a b c s n).eval 0 = orderTwoConstants a c s n := by
  induction n using Nat.twoStepInduction with
  | zero => simp [orderTwoBasis, orderTwoConstants]
  | one => simp [orderTwoBasis, orderTwoConstants]
  | more n ih₀ ih₁ =>
      simp only [orderTwoBasis, orderTwoConstants, eval_add, eval_mul, eval_C,
        eval_X, mul_zero]
      rw [ih₀, ih₁]
      ring

private theorem not_forall_nonneg_of_normalized_quadratic
    {t : ℝ} (ht : t < 2) {u : ℕ → ℝ}
    (hu0 : 0 < u 0) (hrec : ∀ n, u (n + 2) = t * u (n + 1) - u n) :
    ¬∀ n, 0 ≤ u n := by
  intro hu
  let d : ℕ → ℝ := fun n => u (n + 1) - u n
  have hdstep (n : ℕ) : d (n + 1) = d n - (2 - t) * u (n + 1) := by
    dsimp [d]
    rw [hrec]
    ring
  have hdanti : Antitone d := by
    intro m n hmn
    induction n, hmn using Nat.le_induction with
    | base => exact le_rfl
    | succ n hmn ih =>
        rw [hdstep]
        exact sub_le_self _ (mul_nonneg (by linarith) (hu _)) |>.trans ih
  have hdnonneg (n : ℕ) : 0 ≤ d n := by
    by_contra hn
    have hneg : d n < 0 := lt_of_not_ge hn
    have hbound (k : ℕ) : u (n + k) ≤ u n + (k : ℝ) * d n := by
      induction k with
      | zero => simp
      | succ k ih =>
          calc
            u (n + (k + 1)) = u (n + k) + d (n + k) := by
              rw [show n + (k + 1) = n + k + 1 by lia]
              dsimp [d]
              ring
            _ ≤ u (n + k) + d n := by
              gcongr
              exact hdanti (Nat.le_add_right n k)
            _ ≤ u n + (k : ℝ) * d n + d n := by linarith
            _ = u n + ((k + 1 : ℕ) : ℝ) * d n := by
              push_cast
              ring
    obtain ⟨k : ℕ, hk⟩ := exists_nat_gt (u n / (-d n))
    have : u n + (k : ℝ) * d n < 0 := by
      have hdpos : 0 < -d n := by linarith
      have := mul_lt_mul_of_pos_right hk hdpos
      rw [div_mul_cancel₀ _ (ne_of_gt hdpos)] at this
      nlinarith
    linarith [hu (n + k), hbound k]
  have hu0le (n : ℕ) : u 0 ≤ u n := by
    induction n with
    | zero => exact le_rfl
    | succ n ih =>
        dsimp [d] at hdnonneg
        linarith [hdnonneg n]
  let eps : ℝ := (2 - t) * u 0
  have heps : 0 < eps := mul_pos (by linarith) hu0
  obtain ⟨n : ℕ, hn⟩ := exists_nat_gt (d 0 / eps)
  have hdrop (k : ℕ) : d k ≤ d 0 - (k : ℝ) * eps := by
    induction k with
    | zero => simp
    | succ k ih =>
        rw [hdstep]
        have hmul : eps ≤ (2 - t) * u (k + 1) := by
          dsimp [eps]
          gcongr
          exact hu0le (k + 1)
        push_cast
        nlinarith
  have hright : d 0 - (n : ℝ) * eps < 0 := by
    have := mul_lt_mul_of_pos_right hn heps
    rw [div_mul_cancel₀ _ (ne_of_gt heps)] at this
    linarith
  linarith [hdnonneg n, hdrop n]

private theorem orderTwoConstants_discriminant_nonneg
    {a c s : ℝ} (ha : 0 ≤ a) (hall : ∀ n, 0 ≤ orderTwoConstants a c s n) :
    0 ≤ a ^ 2 + 4 * c := by
  by_contra hdisc
  have hc : c < 0 := by nlinarith
  let q := -c
  have hq : 0 < q := by dsimp [q]; linarith
  let r := Real.sqrt q
  have hr : 0 < r := Real.sqrt_pos.mpr hq
  have hrsq : r ^ 2 = q := by
    dsimp [r]
    nlinarith [Real.sq_sqrt hq.le]
  let u := LinearRecurrence.quadraticRescale r (orderTwoConstants a c s)
  have hvsol : (LinearRecurrence.quadratic a c).IsSolution
      (orderTwoConstants a c s) := by
    rw [LinearRecurrence.quadratic_isSolution_iff]
    intro n
    simp [orderTwoConstants]
  have husol := LinearRecurrence.quadraticRescale_sqrt_isSolution hq (by
    simpa [q] using hvsol)
  have hurec : ∀ n, u (n + 2) = (a / r) * u (n + 1) - u n := by
    rw [LinearRecurrence.quadratic_isSolution_iff] at husol
    intro n
    simpa only [u, r, q, sub_eq_add_neg, neg_one_mul] using husol n
  have hut : a / r < 2 := by
    have : a ^ 2 < 4 * q := by dsimp [q]; nlinarith
    have har : a < 2 * r := by nlinarith [sq_nonneg (a + 2 * r)]
    exact (div_lt_iff₀ hr).2 (by nlinarith)
  apply not_forall_nonneg_of_normalized_quadratic hut (u := u)
  · simp [u, LinearRecurrence.quadraticRescale, orderTwoConstants]
  · exact hurec
  · intro n
    dsimp [u, LinearRecurrence.quadraticRescale]
    exact div_nonneg (hall n) (pow_nonneg hr.le n)

private theorem orderTwoConstants_lower_root_le_initial
    {a c s : ℝ} (ha : 0 ≤ a) (hc : c < 0)
    (hdisc : 0 ≤ a ^ 2 + 4 * c)
    (hall : ∀ n, 0 ≤ orderTwoConstants a c s n) :
    (a - Real.sqrt (a ^ 2 + 4 * c)) / 2 ≤ s := by
  let delta := Real.sqrt (a ^ 2 + 4 * c)
  let h := (a - delta) / 2
  let k := (a + delta) / 2
  have hdelta : 0 ≤ delta := Real.sqrt_nonneg _
  have hdeltasq : delta ^ 2 = a ^ 2 + 4 * c := by
    dsimp [delta]
    nlinarith [Real.sq_sqrt hdisc]
  have hdelta_le : delta ≤ a := by
    nlinarith [sq_nonneg (a - delta), sq_nonneg (a + delta)]
  have hh : 0 ≤ h := by dsimp [h]; linarith
  have hk : 0 < k := by
    dsimp [k]
    by_contra hk0
    have ha0 : a = 0 := by linarith
    nlinarith
  have hsum : h + k = a := by dsimp [h, k]; ring
  have hprod : h * k = -c := by
    dsimp [h, k]
    nlinarith
  have hvsol : (LinearRecurrence.quadratic a c).IsSolution
      (orderTwoConstants a c s) := by
    rw [LinearRecurrence.quadratic_isSolution_iff]
    intro n
    simp [orderTwoConstants]
  have htelescope (n : ℕ) :
      orderTwoConstants a c s (n + 1) - h * orderTwoConstants a c s n =
        k ^ n * (s - h) := by
    simpa [orderTwoConstants] using
      LinearRecurrence.quadratic_telescope hvsol hsum hprod n
  by_contra hnot
  change ¬h ≤ s at hnot
  have hsh : s - h < 0 := by exact sub_neg.mpr (lt_of_not_ge hnot)
  have hhk : h ≤ k := by dsimp [h, k]; linarith
  let w : ℕ → ℝ := fun n => orderTwoConstants a c s n / k ^ n
  have hw (n : ℕ) : 0 ≤ w n :=
    div_nonneg (hall n) (pow_nonneg hk.le n)
  have hwstep (n : ℕ) : w (n + 1) ≤ w n + (s - h) / k := by
    have hpow : k ^ n ≠ 0 := pow_ne_zero n hk.ne'
    have htel := htelescope n
    have hweq : w (n + 1) = (h / k) * w n + (s - h) / k := by
      dsimp [w]
      rw [pow_succ]
      field_simp [hk.ne', hpow]
      nlinarith
    rw [hweq]
    have hratio : h / k ≤ 1 := (div_le_one hk).2 hhk
    have := mul_le_mul_of_nonneg_right hratio (hw n)
    nlinarith
  have hwbound (n : ℕ) : w n ≤ 1 + (n : ℝ) * ((s - h) / k) := by
    induction n with
    | zero => simp [w, orderTwoConstants]
    | succ n ih =>
        have hstep := hwstep n
        push_cast
        nlinarith
  have hslope : 0 < -(s - h) / k := div_pos (neg_pos.mpr hsh) hk
  obtain ⟨n : ℕ, hn⟩ := exists_nat_gt (1 / (-(s - h) / k))
  have hneg : 1 + (n : ℝ) * ((s - h) / k) < 0 := by
    have hmul := mul_lt_mul_of_pos_right hn hslope
    rw [div_mul_cancel₀ _ hslope.ne'] at hmul
    have hid : -(s - h) / k = -((s - h) / k) := by ring
    rw [hid] at hmul
    nlinarith
  linarith [hw n, hwbound n]

/-- Nonnegativity of every term in the scalar order-two recurrence is
equivalent to the sharp discriminant and initial-value inequalities. -/
theorem orderTwoConstants_nonneg_iff {a c s : ℝ} (ha : 0 ≤ a) (hs : 0 ≤ s) :
    (∀ n, 0 ≤ orderTwoConstants a c s n) ↔
      0 ≤ a ^ 2 + 4 * c ∧ (2 * s ≥ a ∨ c ≥ s ^ 2 - a * s) := by
  constructor
  · intro hall
    have hdisc := orderTwoConstants_discriminant_nonneg ha hall
    refine ⟨hdisc, ?_⟩
    by_cases hc : 0 ≤ c
    · by_cases hsa : a ≤ 2 * s
      · exact Or.inl hsa
      · right
        nlinarith [mul_nonpos_of_nonneg_of_nonpos hs (by linarith : s - a ≤ 0)]
    · have hcneg : c < 0 := lt_of_not_ge hc
      have hlower := orderTwoConstants_lower_root_le_initial
        ha hcneg hdisc hall
      let delta := Real.sqrt (a ^ 2 + 4 * c)
      have hdeltasq : delta ^ 2 = a ^ 2 + 4 * c := by
        dsimp [delta]
        nlinarith [Real.sq_sqrt hdisc]
      by_cases hsa : a ≤ 2 * s
      · exact Or.inl hsa
      · right
        dsimp [delta] at hdeltasq hlower
        nlinarith
  · rintro ⟨hdisc, hinitial⟩
    by_cases hc : 0 ≤ c
    · intro n
      induction n using Nat.twoStepInduction with
      | zero => simp [orderTwoConstants]
      | one => simpa [orderTwoConstants] using hs
      | more n ih₀ ih₁ =>
          simp only [orderTwoConstants]
          positivity
    · have hcneg : c < 0 := lt_of_not_ge hc
      let delta := Real.sqrt (a ^ 2 + 4 * c)
      let h := (a - delta) / 2
      let k := (a + delta) / 2
      have hdelta : 0 ≤ delta := Real.sqrt_nonneg _
      have hdeltasq : delta ^ 2 = a ^ 2 + 4 * c := by
        dsimp [delta]
        nlinarith [Real.sq_sqrt hdisc]
      have hdelta_le : delta ≤ a := by
        nlinarith [sq_nonneg (a - delta), sq_nonneg (a + delta)]
      have hh : 0 ≤ h := by dsimp [h]; linarith
      have hk : 0 ≤ k := by dsimp [k]; linarith
      have hsum : h + k = a := by dsimp [h, k]; ring
      have hprod : h * k = -c := by
        dsimp [h, k]
        nlinarith
      have hhs : h ≤ s := by
        rcases hinitial with hsa | hquad
        · dsimp [h]
          linarith
        · dsimp [h, delta]
          nlinarith
      have hvsol : (LinearRecurrence.quadratic a c).IsSolution
          (orderTwoConstants a c s) := by
        rw [LinearRecurrence.quadratic_isSolution_iff]
        intro n
        simp [orderTwoConstants]
      have htelescope (n : ℕ) :
          orderTwoConstants a c s (n + 1) -
              h * orderTwoConstants a c s n = k ^ n * (s - h) := by
        simpa [orderTwoConstants] using
          LinearRecurrence.quadratic_telescope hvsol hsum hprod n
      intro n
      induction n with
      | zero => simp [orderTwoConstants]
      | succ n ih =>
          have htel := htelescope n
          have : 0 ≤ k ^ n * (s - h) := mul_nonneg (pow_nonneg hk n) (by linarith)
          nlinarith

private def orderTwoFactorMatrix (r a : ℝ) : List (List ℝ[X]) :=
  [[C r, 1], [X, C (r + a)]]

private lemma orderTwoFactorMatrix_rect (r a : ℝ) :
    ∀ row ∈ orderTwoFactorMatrix r a, row.length = 2 := by
  intro row hrow
  simp only [orderTwoFactorMatrix, List.mem_cons, List.not_mem_nil, or_false] at hrow
  rcases hrow with rfl | rfl <;> simp

private lemma orderTwoFactorMatrix_nonneg {r a : ℝ} (hr : 0 ≤ r) (ha : 0 ≤ a) :
    ∀ row ∈ orderTwoFactorMatrix r a, ∀ p ∈ row, HasNonnegCoeffs p := by
  intro row hrow p hp
  simp only [orderTwoFactorMatrix, List.mem_cons, List.not_mem_nil, or_false] at hrow
  rcases hrow with rfl | rfl <;>
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
  · rcases hp with rfl | rfl
    · exact hasNonnegCoeffs_C hr
    · exact hasNonnegCoeffs_one
  · rcases hp with rfl | rfl
    · exact hasNonnegCoeffs_X
    · exact hasNonnegCoeffs_C (by positivity)

private lemma orderTwoFactorMatrix_affine {r a : ℝ} (hr : 0 ≤ r) (ha : 0 ≤ a) :
    ∀ (i₁ i₂ : Fin (orderTwoFactorMatrix r a).length) (j₁ j₂ : Fin 2),
      i₁ ≤ i₂ → j₁ ≤ j₂ →
      Has2x2InterlacingProperty0
        (((orderTwoFactorMatrix r a).get i₁).get
          ⟨j₁, by
            rw [orderTwoFactorMatrix_rect r a _ (List.get_mem _ i₁)]
            exact j₁.isLt⟩)
        (((orderTwoFactorMatrix r a).get i₁).get
          ⟨j₂, by
            rw [orderTwoFactorMatrix_rect r a _ (List.get_mem _ i₁)]
            exact j₂.isLt⟩)
        (((orderTwoFactorMatrix r a).get i₂).get
          ⟨j₁, by
            rw [orderTwoFactorMatrix_rect r a _ (List.get_mem _ i₂)]
            exact j₁.isLt⟩)
        (((orderTwoFactorMatrix r a).get i₂).get
          ⟨j₂, by
            rw [orderTwoFactorMatrix_rect r a _ (List.get_mem _ i₂)]
            exact j₂.isLt⟩) := by
  intro i₁ i₂ j₁ j₂ hi hj
  change Fin 2 at i₁ i₂
  fin_cases i₁ <;> fin_cases i₂ <;> norm_num at hi
  · fin_cases j₁ <;> fin_cases j₂ <;> norm_num at hj <;>
      simp only [orderTwoFactorMatrix, List.get_eq_getElem,
        List.getElem_cons_zero, List.getElem_cons_succ] <;>
      intro u v hu hv
    · exact interl_const_entries_affine_of_det_nonneg hr hr hr hr hu le_rfl
    · exact interl_const_entries_affine_of_det_nonneg hr zero_le_one hr zero_le_one
        hu (by norm_num)
    · exact interl_const_entries_affine_of_det_nonneg zero_le_one zero_le_one
        zero_le_one zero_le_one hu le_rfl
  · fin_cases j₁ <;> fin_cases j₂ <;> norm_num at hj <;>
      simp only [orderTwoFactorMatrix, List.get_eq_getElem,
        List.getElem_cons_zero, List.getElem_cons_succ] <;>
      intro u v hu hv
    · convert Interl.refl (fun _ =>
          (isRealRooted_affine_factor (s := u * r + 1) (t := v * r) (by positivity)).2)
        using 1 <;> grind
    · convert interl_affine_linear_affine_linear_of_cross
          (u := u) (v := v + r + a) (U := u * r + 1) (V := v * r)
          hu (by positivity) (by
            have : 0 ≤ u * r * (r + a) + v + r + a := by positivity
            nlinarith)
        using 1 <;> grind
    · convert Interl.refl (fun _ =>
          (isRealRooted_affine_factor (s := u) (t := v + r + a) hu).2)
        using 1 <;> grind
  · fin_cases j₁ <;> fin_cases j₂ <;> norm_num at hj <;>
      simp only [orderTwoFactorMatrix, List.get_eq_getElem,
        List.getElem_cons_zero, List.getElem_cons_succ] <;>
      intro u v hu hv
    · exact interl_affine_mul_X_add_X_self hu
    · by_cases hra : r + a = 0
      · convert interl_zero_left (X * (C u * X + C (v + 1))) using 1 <;>
          grind
      · have hra_pos : 0 < r + a := lt_of_le_of_ne (by positivity) (Ne.symm hra)
        convert interl_affine_to_X_mul_affine
            (u := u) (v := v + 1) (U := u * (r + a))
            (V := (v + 1) * (r + a)) hu (by positivity) (by nlinarith)
            (by positivity) (by positivity)
          using 1 <;> grind
    · exact interl_const_entries_affine_of_det_nonneg
        (by positivity) (by positivity) (by positivity) (by positivity) hu le_rfl

private lemma basisTransform_X_mul_shift (B : ℕ → ℝ[X]) (p : ℝ[X]) :
    basisTransform B (X * p) = basisTransform (fun n => B (n + 1)) p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp only [mul_add, basisTransform_add, hp, hq]
  | monomial n z =>
      rw [Polynomial.X_mul_monomial]
      simp only [basisTransform_monomial]

private lemma orderTwoNextTransform_X_mul (a s : ℝ) (p : ℝ[X]) :
    basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1)) (X * p) =
      X * basisTransform (orderTwoBasis a 1 0 s) p +
        C a * basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1)) p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp only [mul_add, basisTransform_add, hp, hq]; ring
  | monomial n z =>
      rw [Polynomial.X_mul_monomial]
      simp only [basisTransform_monomial]
      rw [show n + 1 + 1 = n + 2 by lia, orderTwoBasis]
      simp only [map_one, map_zero, one_mul, add_zero]
      ring

private lemma orderTwoFactorAction (a s r : ℝ) (p : ℝ[X]) :
    matPolyAction (orderTwoFactorMatrix r a)
        [basisTransform (orderTwoBasis a 1 0 s) p,
          basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1)) p] =
      [basisTransform (orderTwoBasis a 1 0 s) ((X + C r) * p),
        basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1))
          ((X + C r) * p)] := by
  simp only [matPolyAction, orderTwoFactorMatrix, List.map_cons, List.map_nil,
    List.zipWith_cons_cons, List.zipWith_nil_left, List.sum_cons, List.sum_nil,
    add_zero]
  rw [add_mul, basisTransform_add, basisTransform_X_mul_shift,
    show C r * p = r • p by rw [Polynomial.smul_eq_C_mul], basisTransform_smul,
    basisTransform_add, orderTwoNextTransform_X_mul, basisTransform_smul]
  rw [map_add]
  simp only [List.cons.injEq]
  constructor
  · ring
  · refine ⟨by ring, ?_⟩
    simp

private lemma constantPair_interlacing {u v : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) :
    IsInterlacingSeq0NonnegRealRooted [C u, C v] := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · rw [isInterlacingSeq0_iff_pairwise]
    simp only [List.pairwise_cons, List.mem_cons, List.not_mem_nil, or_false]
    refine ⟨?_, ?_⟩
    · intro p hp
      rcases hp with rfl
      exact interl_C_C u v
    · exact ⟨fun _ hp => hp.elim, List.Pairwise.nil⟩
  · intro p hp
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl
    · exact hasNonnegCoeffs_C hu
    · exact hasNonnegCoeffs_C hv
  · intro p hp hp0
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl
    · exact ⟨hp0, Splits.C u⟩
    · exact ⟨hp0, Splits.C v⟩

private theorem orderTwoZeroTransform_interlacing
    {a s : ℝ} (ha : 0 ≤ a) (hs : 0 ≤ s) {p : ℝ[X]} (hp : IsPFPolynomial p) :
    IsInterlacingSeq0NonnegRealRooted
      [basisTransform (orderTwoBasis a 1 0 s) p,
        basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1)) p] := by
  induction hdegree : p.natDegree using Nat.strong_induction_on generalizing p with
  | h n ih =>
      by_cases hp0 : p = 0
      · simpa [hp0] using
          constantPair_interlacing (u := 0) (v := 0) le_rfl le_rfl
      by_cases hn0 : n = 0
      · have hpC : p = C (p.coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero (by simpa [hdegree] using hn0)
        rw [hpC]
        simp only [basisTransform_C, orderTwoBasis]
        rw [← map_mul]
        simp only [mul_one]
        exact constantPair_interlacing (hp.hasNonnegCoeffs 0)
          (mul_nonneg (hp.hasNonnegCoeffs 0) hs)
      · have hpos : 0 < p.natDegree := by
          rw [hdegree]
          exact Nat.pos_of_ne_zero hn0
        obtain ⟨u, q, hu, hfactor, hq, hqdegree⟩ :=
          hp.exists_X_sub_C_factor_of_pos_natDegree hpos
        have hqstate := ih q.natDegree (by lia) hq rfl
        have hfactor' : p = (X + C (-u)) * q := by
          simpa [sub_eq_add_neg] using hfactor
        have hout := matrix_preserves_interlacing_seq0_of_2x2_weak
          (orderTwoFactorMatrix (-u) a) (orderTwoFactorMatrix_rect (-u) a)
          (orderTwoFactorMatrix_nonneg (neg_nonneg.mpr hu) ha)
          (orderTwoFactorMatrix_affine (neg_nonneg.mpr hu) ha)
          [basisTransform (orderTwoBasis a 1 0 s) q,
            basisTransform (fun n => orderTwoBasis a 1 0 s (n + 1)) q]
          (by simp) hqstate.1 hqstate.2
        rw [orderTwoFactorAction, ← hfactor'] at hout
        exact hout

/-- For nonnegative `a` and `s`, the unshifted order-two basis transform sends
every PF polynomial to a PF polynomial. -/
theorem orderTwoZeroTransform_isPFPolynomial
    {a s : ℝ} (ha : 0 ≤ a) (hs : 0 ≤ s) {p : ℝ[X]} (hp : IsPFPolynomial p) :
    IsPFPolynomial (basisTransform (orderTwoBasis a 1 0 s) p) := by
  have hstate := orderTwoZeroTransform_interlacing ha hs hp
  apply IsPFPolynomial.of_nonnegCoeffs_eq_zero_or_splits
  · exact hstate.nonnegCoeffs _ (by simp)
  · by_cases hzero : basisTransform (orderTwoBasis a 1 0 s) p = 0
    · exact Or.inl hzero
    · exact Or.inr (hstate.realRooted _ (by simp) hzero).2

/-- The general order-two basis is obtained from the unshifted unit-slope
basis by the affine substitution `X ↦ b X + c`. -/
theorem orderTwoBasis_eq_comp (a b c s : ℝ) (n : ℕ) :
    orderTwoBasis a b c s n =
      (orderTwoBasis a 1 0 s n).comp (C b * X + C c) := by
  induction n using Nat.twoStepInduction with
  | zero => simp [orderTwoBasis]
  | one => simp [orderTwoBasis]
  | more n ih₀ ih₁ =>
      simp only [orderTwoBasis, add_comp, mul_comp, C_comp, X_comp, ih₀, ih₁,
        map_one, map_zero, one_mul, add_zero]

private lemma basisTransform_comp_basis (B : ℕ → ℝ[X]) (q p : ℝ[X]) :
    basisTransform (fun n => (B n).comp q) p = (basisTransform B p).comp q := by
  induction p using Polynomial.induction_on' with
  | add p r hp hr => simp only [basisTransform_add, add_comp, hp, hr]
  | monomial n z => simp [basisTransform_monomial, mul_comp]

/-- The basis transform itself commutes with the affine substitution relating
the general basis to its unshifted normalization. -/
theorem basisTransform_orderTwoBasis_eq_comp (a b c s : ℝ) (p : ℝ[X]) :
    basisTransform (orderTwoBasis a b c s) p =
      (basisTransform (orderTwoBasis a 1 0 s) p).comp (C b * X + C c) := by
  rw [← basisTransform_comp_basis]
  congr 2
  funext n
  exact orderTwoBasis_eq_comp a b c s n

/-- For every real shift `c`, the order-two basis transform sends PF inputs
to the zero polynomial or to a real-rooted polynomial. -/
theorem basisTransform_orderTwoBasis_eq_zero_or_splits
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s)
    {p : ℝ[X]} (hp : IsPFPolynomial p) :
    basisTransform (orderTwoBasis a b c s) p = 0 ∨
      (basisTransform (orderTwoBasis a b c s) p).Splits := by
  have hq := orderTwoZeroTransform_isPFPolynomial ha hs hp
  let q := basisTransform (orderTwoBasis a 1 0 s) p
  rw [basisTransform_orderTwoBasis_eq_comp]
  by_cases hq0 : q = 0
  · left
    simp [q, hq0]
  · right
    have hqsplit := (hq.ne_zero_and_splits hq0).2
    have hshift := isRealRooted_comp_X_add_C hq0 hqsplit c
    have hscale := isRealRooted_comp_C_mul_X hshift.1 hshift.2 hb.ne'
    have heq : q.comp (C b * X + C c) =
        (q.comp (X + C c)).comp (C b * X) := by
      rw [comp_assoc]
      congr 1
      simp
    rw [heq]
    exact hscale.2

/-- A nonnegative affine shift of the order-two basis transform preserves PF
polynomials. -/
theorem basisTransform_orderTwoBasis_isPFPolynomial_of_nonneg
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hc : 0 ≤ c) (hs : 0 ≤ s)
    {p : ℝ[X]} (hp : IsPFPolynomial p) :
    IsPFPolynomial (basisTransform (orderTwoBasis a b c s) p) := by
  rw [basisTransform_orderTwoBasis_eq_comp]
  exact (orderTwoZeroTransform_isPFPolynomial ha hs hp).comp_C_mul_X_add_C hb hc

private lemma orderTwoBasisState_action
    {a c h k s : ℝ} (hsum : h + k = a) (hprod : h * k = -c) (n : ℕ) :
    matPolyAction (orderTwoFactorMatrix h (k - h))
        [orderTwoBasis a 1 c s n,
          orderTwoBasis a 1 c s (n + 1) - C h * orderTwoBasis a 1 c s n] =
      [orderTwoBasis a 1 c s (n + 1),
        orderTwoBasis a 1 c s (n + 2) -
          C h * orderTwoBasis a 1 c s (n + 1)] := by
  have haeq : a = h + k := hsum.symm
  have hceq : c = -(h * k) := by linarith
  simp only [matPolyAction, orderTwoFactorMatrix, List.map_cons, List.map_nil,
    List.zipWith_cons_cons, List.zipWith_nil_left, List.sum_cons, List.sum_nil,
    add_zero]
  rw [orderTwoBasis, haeq, hceq, map_add, map_neg, map_mul, map_one]
  simp only [one_mul]
  rw [← map_add, show h + (k - h) = k by ring, map_add]
  simp only [List.cons.injEq]
  refine ⟨by ring, by refine ⟨?_, trivial⟩; ring⟩

private theorem orderTwoBasis_state_interlacing
    {a c h k s : ℝ} (hh : 0 ≤ h) (hhk : h ≤ k) (hhs : h ≤ s)
    (hsum : h + k = a) (hprod : h * k = -c) (n : ℕ) :
    IsInterlacingSeq0NonnegRealRooted
      [orderTwoBasis a 1 c s n,
        orderTwoBasis a 1 c s (n + 1) - C h * orderTwoBasis a 1 c s n] := by
  induction n with
  | zero =>
      simp only [orderTwoBasis, mul_one]
      rw [← map_sub]
      exact constantPair_interlacing zero_le_one (sub_nonneg.mpr hhs)
  | succ n ih =>
      have hout := matrix_preserves_interlacing_seq0_of_2x2_weak
        (orderTwoFactorMatrix h (k - h))
        (orderTwoFactorMatrix_rect h (k - h))
        (orderTwoFactorMatrix_nonneg hh (sub_nonneg.mpr hhk))
        (orderTwoFactorMatrix_affine hh (sub_nonneg.mpr hhk))
        [orderTwoBasis a 1 c s n,
          orderTwoBasis a 1 c s (n + 1) - C h * orderTwoBasis a 1 c s n]
        (by simp) ih.1 ih.2
      rw [orderTwoBasisState_action hsum hprod] at hout
      exact hout

private theorem orderTwoBasis_unitSlope_isPFPolynomial_of_conditions
    {a c s : ℝ} (ha : 0 ≤ a) (hs : 0 ≤ s)
    (hdisc : 0 ≤ a ^ 2 + 4 * c)
    (hinitial : 2 * s ≥ a ∨ c ≥ s ^ 2 - a * s) (n : ℕ) :
    IsPFPolynomial (orderTwoBasis a 1 c s n) := by
  by_cases hc : 0 ≤ c
  · simpa using basisTransform_orderTwoBasis_isPFPolynomial_of_nonneg
      ha zero_lt_one hc hs (isPFPolynomial_X_pow n)
  · have hcneg : c < 0 := lt_of_not_ge hc
    let delta := Real.sqrt (a ^ 2 + 4 * c)
    let h := (a - delta) / 2
    let k := (a + delta) / 2
    have hdelta : 0 ≤ delta := Real.sqrt_nonneg _
    have hdeltasq : delta ^ 2 = a ^ 2 + 4 * c := by
      dsimp [delta]
      nlinarith [Real.sq_sqrt hdisc]
    have hdelta_le : delta ≤ a := by
      nlinarith [sq_nonneg (a - delta), sq_nonneg (a + delta)]
    have hh : 0 ≤ h := by dsimp [h]; linarith
    have hhk : h ≤ k := by dsimp [h, k]; linarith
    have hsum : h + k = a := by dsimp [h, k]; ring
    have hprod : h * k = -c := by
      dsimp [h, k]
      nlinarith
    have hall : ∀ m, 0 ≤ orderTwoConstants a c s m :=
      (orderTwoConstants_nonneg_iff ha hs).2 ⟨hdisc, hinitial⟩
    have hhs : h ≤ s := by
      exact orderTwoConstants_lower_root_le_initial ha hcneg hdisc hall
    have hstate := orderTwoBasis_state_interlacing hh hhk hhs hsum hprod n
    apply IsPFPolynomial.of_nonnegCoeffs_eq_zero_or_splits
    · exact hstate.nonnegCoeffs _ (by simp)
    · by_cases hzero : orderTwoBasis a 1 c s n = 0
      · exact Or.inl hzero
      · exact Or.inr (hstate.realRooted _ (by simp) hzero).2

private theorem orderTwoBasis_slope_eq_comp (a b c s : ℝ) (n : ℕ) :
    orderTwoBasis a b c s n =
      (orderTwoBasis a 1 c s n).comp (C b * X) := by
  induction n using Nat.twoStepInduction with
  | zero => simp [orderTwoBasis]
  | one => simp [orderTwoBasis]
  | more n ih₀ ih₁ =>
      simp only [orderTwoBasis, add_comp, mul_comp, C_comp, X_comp, ih₀, ih₁,
        map_one, one_mul]

private theorem orderTwoBasis_one_natDegree (c : ℝ) (n : ℕ) :
    (orderTwoBasis 1 1 c 1 n).natDegree = n / 2 := by
  convert threeTermHalf_natDegree
    (P := orderTwoBasis 1 1 c 1) (a := fun _ ↦ (1 : ℝ[X]))
    (b := fun _ ↦ X + C c) (D₀ := 0) (d := 1) (e := 0)
    (fun m ↦ by simp [orderTwoBasis]) (fun _ ↦ by simp) (fun _ ↦ by simp)
    (by norm_num) (by simp [orderTwoBasis]) (by simp [orderTwoBasis])
    (by norm_num [orderTwoBasis]) (by norm_num [orderTwoBasis])
    (fun _ ↦ by simp) (fun _ ↦ by simp) n using 1
  simp

private theorem orderTwoConstants_critical (n : ℕ) :
    orderTwoConstants 1 (-(1 / 4 : ℝ)) 1 n = (n + 1 : ℝ) / 2 ^ n := by
  induction n using Nat.twoStepInduction with
  | zero => norm_num [orderTwoConstants]
  | one => norm_num [orderTwoConstants]
  | more n ih₀ ih₁ =>
      rw [orderTwoConstants, ih₀, ih₁]
      push_cast
      field_simp
      ring

private theorem orderTwoBasis_critical_coeff_pos {n k : ℕ} (hk : k ≤ n / 2) :
    0 < (orderTwoBasis 1 1 (-(1 / 4 : ℝ)) 1 n).coeff k := by
  have hpf := orderTwoBasis_unitSlope_isPFPolynomial_of_conditions
    (a := (1 : ℝ)) (c := -(1 / 4 : ℝ)) (s := 1)
    (by norm_num) (by norm_num) (by norm_num) (Or.inl (by norm_num)) n
  apply hpf.coeff_pos_of_coeff_zero_pos
  · rw [Polynomial.coeff_zero_eq_eval_zero, orderTwoBasis_eval_zero,
      orderTwoConstants_critical]
    positivity
  · rwa [orderTwoBasis_one_natDegree]

private theorem continuous_orderTwoBasis_one_coeff (n k : ℕ) :
    Continuous fun c : ℝ ↦ (orderTwoBasis 1 1 c 1 n).coeff k := by
  have heq : (fun c : ℝ ↦ (orderTwoBasis 1 1 c 1 n).coeff k) =
      fun c : ℝ ↦ ((orderTwoBasis 1 1 0 1 n).comp (X + C c)).coeff k := by
    funext c
    rw [orderTwoBasis_eq_comp]
    simp
  rw [heq]
  exact (orderTwoBasis 1 1 0 1 n).continuous_coeff_comp_X_add_C k

/-- Under the sharp scalar inequalities, every member of the order-two basis
is a PF polynomial. -/
theorem orderTwoBasis_isPFPolynomial_of_conditions
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s)
    (hdisc : 0 ≤ a ^ 2 + 4 * c)
    (hinitial : 2 * s ≥ a ∨ c ≥ s ^ 2 - a * s) (n : ℕ) :
    IsPFPolynomial (orderTwoBasis a b c s n) := by
  rw [orderTwoBasis_slope_eq_comp]
  simpa using (orderTwoBasis_unitSlope_isPFPolynomial_of_conditions
    ha hs hdisc hinitial n).comp_C_mul_X_add_C hb le_rfl

/-- Preserving all PF polynomials is equivalent to every order-two basis row
being PF. -/
theorem basisTransform_orderTwoBasis_preserves_pf_iff_rows_pf
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s) :
    (∀ p : ℝ[X], IsPFPolynomial p →
        IsPFPolynomial (basisTransform (orderTwoBasis a b c s) p)) ↔
      ∀ n, IsPFPolynomial (orderTwoBasis a b c s n) := by
  constructor
  · intro h n
    simpa using h (X ^ n) (isPFPolynomial_X_pow n)
  · intro hrows p hp
    apply IsPFPolynomial.of_nonnegCoeffs_eq_zero_or_splits
    · exact hp.hasNonnegCoeffs.basisTransform fun n ↦ (hrows n).hasNonnegCoeffs
    · exact basisTransform_orderTwoBasis_eq_zero_or_splits ha hb hs hp

/-- Every order-two basis row is PF exactly when all of its constant terms are
nonnegative. -/
theorem forall_orderTwoBasis_isPFPolynomial_iff_eval_zero_nonneg
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s) :
    (∀ n, IsPFPolynomial (orderTwoBasis a b c s n)) ↔
      ∀ n, 0 ≤ (orderTwoBasis a b c s n).eval 0 := by
  constructor
  · intro h n
    rw [← Polynomial.coeff_zero_eq_eval_zero]
    exact (h n).hasNonnegCoeffs 0
  · intro h n
    have hconstants : ∀ m, 0 ≤ orderTwoConstants a c s m := by
      intro m
      simpa [orderTwoBasis_eval_zero] using h m
    obtain ⟨hdisc, hinitial⟩ := (orderTwoConstants_nonneg_iff ha hs).1 hconstants
    exact orderTwoBasis_isPFPolynomial_of_conditions ha hb hs hdisc hinitial n

/-- Constant-term nonnegativity for every row has the sharp discriminant and
initial-value criterion. -/
theorem forall_orderTwoBasis_eval_zero_nonneg_iff
    {a b c s : ℝ} (ha : 0 ≤ a) (hs : 0 ≤ s) :
    (∀ n, 0 ≤ (orderTwoBasis a b c s n).eval 0) ↔
      0 ≤ a ^ 2 + 4 * c ∧ (2 * s ≥ a ∨ c ≥ s ^ 2 - a * s) := by
  simpa [orderTwoBasis_eval_zero] using orderTwoConstants_nonneg_iff ha hs

/-- The four formulations in Issue 2186 are equivalent: PF preservation,
PF basis rows, nonnegative constant terms, and the two scalar inequalities. -/
theorem orderTwoBasis_pf_equivalences
    {a b c s : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s) :
    ((∀ p : ℝ[X], IsPFPolynomial p →
          IsPFPolynomial (basisTransform (orderTwoBasis a b c s) p)) ↔
        ∀ n, IsPFPolynomial (orderTwoBasis a b c s n)) ∧
      ((∀ n, IsPFPolynomial (orderTwoBasis a b c s n)) ↔
        ∀ n, 0 ≤ (orderTwoBasis a b c s n).eval 0) ∧
      ((∀ n, 0 ≤ (orderTwoBasis a b c s n).eval 0) ↔
        0 ≤ a ^ 2 + 4 * c ∧ (2 * s ≥ a ∨ c ≥ s ^ 2 - a * s)) := by
  exact ⟨basisTransform_orderTwoBasis_preserves_pf_iff_rows_pf ha hb hs,
    forall_orderTwoBasis_isPFPolynomial_iff_eval_zero_nonneg ha hb hs,
    forall_orderTwoBasis_eval_zero_nonneg_iff ha hs⟩

/-- Restricting PF inputs to have all roots in `[-R, 0]` gives exactly the
same criterion, for every nonnegative `R`.  Necessity is witnessed by
monomials. -/
theorem basisTransform_orderTwoBasis_preserves_bounded_pf_iff
    {a b c s R : ℝ} (ha : 0 ≤ a) (hb : 0 < b) (hs : 0 ≤ s) (hR : 0 ≤ R) :
    (∀ p : ℝ[X], IsPFPolynomial p →
        (∀ r ∈ p.roots, -R ≤ r ∧ r ≤ 0) →
        IsPFPolynomial (basisTransform (orderTwoBasis a b c s) p)) ↔
      0 ≤ a ^ 2 + 4 * c ∧ (2 * s ≥ a ∨ c ≥ s ^ 2 - a * s) := by
  constructor
  · intro hrestricted
    have hrows : ∀ n, IsPFPolynomial (orderTwoBasis a b c s n) := by
      intro n
      simpa using hrestricted (X ^ n) (isPFPolynomial_X_pow n) (by
        intro r hr
        have hr0 : r = 0 := by
          have hr' : n ≠ 0 ∧ r = 0 := by simpa using hr
          exact hr'.2
        subst r
        exact ⟨by linarith, le_rfl⟩)
    have heval :=
      (forall_orderTwoBasis_isPFPolynomial_iff_eval_zero_nonneg ha hb hs).1 hrows
    exact (forall_orderTwoBasis_eval_zero_nonneg_iff ha hs).1 heval
  · intro hconditions p hp _
    have heval :=
      (forall_orderTwoBasis_eval_zero_nonneg_iff (b := b) ha hs).2 hconditions
    have hrows :=
      (forall_orderTwoBasis_isPFPolynomial_iff_eval_zero_nonneg ha hb hs).2 heval
    exact (basisTransform_orderTwoBasis_preserves_pf_iff_rows_pf ha hb hs).2
      hrows p hp

/-- There is no universal finite degree cap for detecting preservation.  For
every cap `N`, a shift strictly below `-1/4` preserves every PF input of degree
at most `N`, but does not preserve all PF polynomials. -/
theorem exists_orderTwoBasis_finite_cap_counterexample (N : ℕ) :
    ∃ c : ℝ, c < -(1 / 4 : ℝ) ∧
      (∀ p : ℝ[X], IsPFPolynomial p → p.natDegree ≤ N →
        IsPFPolynomial (basisTransform (orderTwoBasis 1 1 c 1) p)) ∧
      ¬(∀ p : ℝ[X], IsPFPolynomial p →
        IsPFPolynomial (basisTransform (orderTwoBasis 1 1 c 1) p)) := by
  let c₀ : ℝ := -(1 / 4 : ℝ)
  have hnear : ∀ᶠ c in nhds c₀, ∀ n ∈ Finset.range (N + 1),
      ∀ k ∈ Finset.range (n / 2 + 1),
        0 < (orderTwoBasis 1 1 c 1 n).coeff k := by
    rw [Filter.eventually_all_finset]
    intro n hn
    rw [Filter.eventually_all_finset]
    intro k hk
    apply (continuous_orderTwoBasis_one_coeff n k).continuousAt.eventually
    apply lt_mem_nhds
    simpa [c₀] using orderTwoBasis_critical_coeff_pos
      (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  have hnearLeft : ∀ᶠ c in nhdsWithin c₀ (Set.Iio c₀),
      ∀ n ∈ Finset.range (N + 1), ∀ k ∈ Finset.range (n / 2 + 1),
        0 < (orderTwoBasis 1 1 c 1 n).coeff k :=
    hnear.filter_mono nhdsWithin_le_nhds
  obtain ⟨c, hcrows, hcinterval⟩ :=
    (hnearLeft.and (Ioo_mem_nhdsLT (show (-(1 / 2 : ℝ)) < c₀ by
      norm_num [c₀]))).exists
  have hc : c < -(1 / 4 : ℝ) := by
    simpa [c₀] using hcinterval.2
  have hrows {n : ℕ} (hn : n ≤ N) : HasNonnegCoeffs (orderTwoBasis 1 1 c 1 n) := by
    intro k
    by_cases hk : k ≤ n / 2
    · exact (hcrows n (Finset.mem_range.mpr (by lia)) k
        (Finset.mem_range.mpr (by lia))).le
    · rw [Polynomial.coeff_eq_zero_of_natDegree_lt]
      rw [orderTwoBasis_one_natDegree]
      exact lt_of_not_ge hk
  refine ⟨c, hc, ?_, ?_⟩
  · intro p hp hpdeg
    apply IsPFPolynomial.of_nonnegCoeffs_eq_zero_or_splits
    · intro j
      rw [Polynomial.coeff_basisTransform]
      simpa only [Polynomial.sum] using Finset.sum_nonneg fun n hn ↦
        mul_nonneg (hp.hasNonnegCoeffs n)
          (hrows ((Polynomial.le_natDegree_of_ne_zero
            (Polynomial.mem_support_iff.mp hn)).trans hpdeg) j)
    · exact basisTransform_orderTwoBasis_eq_zero_or_splits
        (by norm_num) (by norm_num) (by norm_num) hp
  · intro hall
    have hrowsPF :=
      (basisTransform_orderTwoBasis_preserves_pf_iff_rows_pf
        (a := (1 : ℝ)) (b := 1) (c := c) (s := 1)
        (by norm_num) (by norm_num) (by norm_num)).1 hall
    have heval :=
      (forall_orderTwoBasis_isPFPolynomial_iff_eval_zero_nonneg
        (a := (1 : ℝ)) (b := 1) (c := c) (s := 1)
        (by norm_num) (by norm_num) (by norm_num)).1 hrowsPF
    have hcondition :=
      (forall_orderTwoBasis_eval_zero_nonneg_iff
        (a := (1 : ℝ)) (b := 1) (c := c) (s := 1)
        (by norm_num) (by norm_num)).1 heval
    nlinarith [hcondition.1]

end RealRooted
