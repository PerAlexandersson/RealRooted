module

public import RealRooted.NarayanaTransformation.Basis
public import RealRooted.Mathlib.Algebra.Polynomial.BasisTransform
public import RealRooted.PFPolynomial
public import RealRooted.BorceaBranden.Applications.PoissonStarFallingFactorial
import RealRooted.NarayanaTransformation.Rising
import RealRooted.BasisTransform

/-!
# Polynomial semigroups preserving nonpositive roots

This file begins the finite algebraic API for the ray semigroup generated by
`a D + b X D²`.  Its monomial images are defined by their differential
recurrence, and the operator itself is the corresponding polynomial basis
transform.
-/

@[expose] public section

open Polynomial

noncomputable section

namespace RealRooted

/-- The monomial images of the ray semigroup generated by `a D + b X D²`.

At time `t`, the recurrence is
`P₀ = 1` and `Pₙ₊₁ = (X + t (a + b n)) Pₙ + b t X Pₙ'`.
-/
def raySemigroupBasis (a b t : ℝ) : ℕ → ℝ[X]
  | 0 => 1
  | n + 1 =>
      (X + C (t * (a + b * n))) * raySemigroupBasis a b t n +
        C (b * t) * X * (raySemigroupBasis a b t n).derivative

/-- The ray semigroup operator, defined as the linear basis transform with
monomial images `raySemigroupBasis a b t`.
-/
def raySemigroupTransform (a b t : ℝ) (p : ℝ[X]) : ℝ[X] :=
  basisTransform (raySemigroupBasis a b t) p

/-- The zeroth ray-semigroup row is one. -/
@[simp] theorem raySemigroupBasis_zero (a b t : ℝ) :
    raySemigroupBasis a b t 0 = 1 :=
  rfl

/-- Successive ray-semigroup rows satisfy the defining differential recurrence. -/
theorem raySemigroupBasis_succ (a b t : ℝ) (n : ℕ) :
    raySemigroupBasis a b t (n + 1) =
      (X + C (t * (a + b * n))) * raySemigroupBasis a b t n +
        C (b * t) * X * (raySemigroupBasis a b t n).derivative :=
  rfl

/-- The ray semigroup sends a monomial to its corresponding row. -/
@[simp] theorem raySemigroupTransform_X_pow (a b t : ℝ) (n : ℕ) :
    raySemigroupTransform a b t (X ^ n) = raySemigroupBasis a b t n := by
  exact Polynomial.basisTransform_X_pow (raySemigroupBasis a b t) n

/-- The ray semigroup sends zero to zero. -/
@[simp] theorem raySemigroupTransform_zero (a b t : ℝ) :
    raySemigroupTransform a b t 0 = 0 := by
  exact Polynomial.basisTransform_zero (raySemigroupBasis a b t)

/-- The ray semigroup is additive. -/
theorem raySemigroupTransform_add (a b t : ℝ) (p q : ℝ[X]) :
    raySemigroupTransform a b t (p + q) =
      raySemigroupTransform a b t p + raySemigroupTransform a b t q := by
  exact Polynomial.basisTransform_add (raySemigroupBasis a b t) p q

/-- The ray semigroup commutes with real scalar multiplication. -/
theorem raySemigroupTransform_smul (a b t c : ℝ) (p : ℝ[X]) :
    raySemigroupTransform a b t (c • p) = C c * raySemigroupTransform a b t p := by
  exact Polynomial.basisTransform_smul (raySemigroupBasis a b t) c p

private theorem raySemigroupBasis_degree_leadingCoeff (a b t : ℝ) (n : ℕ) :
    (raySemigroupBasis a b t n).natDegree = n ∧
      (raySemigroupBasis a b t n).leadingCoeff = 1 := by
  let P := raySemigroupBasis a b t
  have hrec : ∀ m, P (m + 1) =
      (C (b * t) * X + C 0 * X ^ 2) * (P m).derivative +
        (C (t * (a + b * m)) + C 1 * X) * P m + 0 := by
    intro m
    rw [show P (m + 1) =
      (X + C (t * (a + b * m))) * P m +
        C (b * t) * X * (P m).derivative by rfl]
    simp only [map_zero, zero_mul, add_zero, map_one, one_mul]
    ring_nf
  have h := Polynomial.natDegree_and_leadingCoeff_quadratic_derivative_recurrence_of_ne_zero
    P (fun _ => 0) (fun _ => b * t) (fun _ => 0)
      (fun m => t * (a + b * m)) (fun _ => 1) hrec (by simp [P])
      (by intro m; simp [P]) (by intro m; norm_num) n
  simpa [P] using h

/-- Every ray-semigroup row has its index as natural degree. -/
theorem raySemigroupBasis_natDegree (a b t : ℝ) (n : ℕ) :
    (raySemigroupBasis a b t n).natDegree = n :=
  (raySemigroupBasis_degree_leadingCoeff a b t n).1

/-- Every ray-semigroup row is monic, with no sign assumptions on the parameters. -/
theorem raySemigroupBasis_monic (a b t : ℝ) (n : ℕ) :
    (raySemigroupBasis a b t n).Monic :=
  (raySemigroupBasis_degree_leadingCoeff a b t n).2

/-- The ray semigroup does not increase natural degree. -/
theorem raySemigroupTransform_natDegree_le (a b t : ℝ) (p : ℝ[X]) :
    (raySemigroupTransform a b t p).natDegree ≤ p.natDegree := by
  exact Polynomial.basisTransform_natDegree_le_of_natDegree_le
    (fun n => (raySemigroupBasis_natDegree a b t n).le) p

/-- The ray semigroup sends monic polynomials to monic polynomials. -/
theorem raySemigroupTransform_monic (a b t : ℝ) {p : ℝ[X]} (hp : p.Monic) :
    (raySemigroupTransform a b t p).Monic := by
  exact Polynomial.basisTransform_monic_of_monic
    (raySemigroupBasis_natDegree a b t)
    (raySemigroupBasis_monic a b t) hp

/-- For nonnegative parameters and time, every monomial image is a
Pólya-frequency polynomial, hence has only nonpositive real roots.
-/
theorem raySemigroupBasis_isPFPolynomial {a b t : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (ht : 0 ≤ t) (n : ℕ) :
    IsPFPolynomial (raySemigroupBasis a b t n) := by
  let P := raySemigroupBasis a b t
  have hrec : ∀ m, P (m + 1) =
      (C (t * (a + b * m)) + C 1 * X) * P m +
        C ((b * t) * 1) * X * (P m).derivative := by
    intro m
    rw [show P (m + 1) =
      (X + C (t * (a + b * m))) * P m +
        C (b * t) * X * (P m).derivative by rfl]
    simp only [mul_one]
    ring_nf
    simp
  exact (Poisson.isPFPolynomial_and_interl_of_poisson_affine_recurrence
    (c := b * t) (a := fun m => t * (a + b * m)) (b := fun _ => 1)
    (P := P) (mul_nonneg hb ht)
    (fun m => mul_nonneg ht (add_nonneg ha (mul_nonneg hb (Nat.cast_nonneg m))))
    (fun _ => by norm_num) (by simp [P, IsPFPolynomial.one]) hrec n).1

/-- The step-`b t` falling-factorial transform conjugates each ray-semigroup
row to a translated generalized rising factorial.
-/
theorem fallingFactorialTransform_raySemigroupBasis (a b t : ℝ) (n : ℕ) :
    Poisson.fallingFactorialTransform (b * t) (raySemigroupBasis a b t n) =
      (risingFactorialPolynomial (b * t) n).comp (X + C (t * a)) := by
  induction n with
  | zero =>
      simp [Poisson.fallingFactorialTransform_one, risingFactorialPolynomial]
  | succ n ih =>
      rw [raySemigroupBasis_succ]
      rw [show
        (X + C (t * (a + b * n))) * raySemigroupBasis a b t n +
            C (b * t) * X * (raySemigroupBasis a b t n).derivative =
          Poisson.starC (b * t) (C (t * (a + b * n)) + C 1 * X)
            (raySemigroupBasis a b t n) by
        rw [Poisson.starC_linear_factor_left]
        simp only [mul_one, map_one, one_mul]
        ring]
      rw [Poisson.fallingFactorialTransform_starC_affine, ih]
      rw [risingFactorialPolynomial_succ_mul]
      simp only [mul_comp, X_comp, add_comp, C_comp, map_mul, map_add, map_natCast]
      simp
      ring

/-- Conjugating the ray semigroup by the step-`b t` falling-factorial
transform gives the generalized rising-factorial transform followed by
translation through `t a`.
-/
theorem fallingFactorialTransform_raySemigroupTransform
    (a b t : ℝ) (p : ℝ[X]) :
    Poisson.fallingFactorialTransform (b * t) (raySemigroupTransform a b t p) =
      (basisTransform (risingFactorialPolynomial (b * t)) p).comp
        (X + C (t * a)) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [raySemigroupTransform_add, Poisson.fallingFactorialTransform_add,
        Polynomial.basisTransform_add, add_comp, hp, hq]
  | monomial n c =>
      rw [raySemigroupTransform, Polynomial.basisTransform_monomial,
        Poisson.fallingFactorialTransform_C_mul,
        fallingFactorialTransform_raySemigroupBasis,
        Polynomial.basisTransform_monomial, mul_comp]
      simp

/-- Scaling a step falling factorial by its step recovers the ordinary
falling factorial, with the expected homogeneous factor.
-/
theorem stepFallingFactorial_comp_C_mul_X (c : ℝ) (n : ℕ) :
    (Poisson.stepFallingFactorial c n).comp (C c * X) =
      C (c ^ n) * fallingFactorialPolynomial n := by
  induction n with
  | zero => simp [Poisson.stepFallingFactorial, fallingFactorialPolynomial]
  | succ n ih =>
      rw [Poisson.stepFallingFactorial_succ, fallingFactorialPolynomial_succ_mul]
      simp only [mul_comp, sub_comp, X_comp, C_comp, ih, map_mul, map_natCast,
        pow_succ]
      simp
      ring

/-- Scaling after the step falling-factorial transform is the ordinary
falling-factorial transform of the scaled input.
-/
theorem fallingFactorialTransform_comp_C_mul_X (c : ℝ) (p : ℝ[X]) :
    (Poisson.fallingFactorialTransform c p).comp (C c * X) =
      basisTransform fallingFactorialPolynomial (p.comp (C c * X)) := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [Poisson.fallingFactorialTransform_add, add_comp, add_comp,
        Polynomial.basisTransform_add, hp, hq]
  | monomial n a =>
      rw [Poisson.fallingFactorialTransform, Polynomial.basisTransform_monomial,
        mul_comp, stepFallingFactorial_comp_C_mul_X]
      have hcomp : (monomial n a).comp (C c * X) = C (a * c ^ n) * X ^ n := by
        rw [← Polynomial.C_mul_X_pow_eq_monomial, mul_comp, pow_comp,
          C_comp, X_comp, mul_pow, ← map_pow, ← mul_assoc, ← map_mul]
      rw [hcomp, Polynomial.basisTransform_C_mul_X_pow]
      simp only [C_comp]
      rw [← mul_assoc, ← map_mul]

private theorem basisTransform_risingFactorial_zero (p : ℝ[X]) :
    basisTransform (risingFactorialPolynomial 0) p = p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [Polynomial.basisTransform_add, hp, hq]
  | monomial n a =>
      rw [Polynomial.basisTransform_monomial, ← Polynomial.C_mul_X_pow_eq_monomial]
      simp [risingFactorialPolynomial]

private theorem fallingFactorialTransform_zero (p : ℝ[X]) :
    Poisson.fallingFactorialTransform 0 p = p := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq => rw [Poisson.fallingFactorialTransform_add, hp, hq]
  | monomial n a =>
      rw [Poisson.fallingFactorialTransform, Polynomial.basisTransform_monomial,
        ← Polynomial.C_mul_X_pow_eq_monomial]
      simp [Poisson.stepFallingFactorial]

/-- For nonnegative generator parameters and time, the ray semigroup
preserves every Pólya-frequency polynomial, not only its monomial rows.
-/
theorem raySemigroupTransform_isPFPolynomial {a b t : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (ht : 0 ≤ t) {p : ℝ[X]}
    (hp : IsPFPolynomial p) :
    IsPFPolynomial (raySemigroupTransform a b t p) := by
  let c := b * t
  let s := t * a
  have hc : 0 ≤ c := mul_nonneg hb ht
  have hs : 0 ≤ s := mul_nonneg ht ha
  by_cases hc0 : c = 0
  · have hconj := fallingFactorialTransform_raySemigroupTransform a b t p
    have hout : raySemigroupTransform a b t p = p.comp (X + C s) := by
      simpa [c, s, hc0, fallingFactorialTransform_zero,
        basisTransform_risingFactorial_zero] using hconj
    rw [hout]
    simpa using hp.comp_C_mul_X_add_C (a := 1) (d := s) (by norm_num) hs
  · have hcpos : 0 < c := lt_of_le_of_ne hc (Ne.symm hc0)
    have hrising :
        IsPFPolynomial (basisTransform (risingFactorialPolynomial c) p) :=
      generalizedRisingFactorialPreservesPF hcpos hp
    have htranslated : IsPFPolynomial
        ((basisTransform (risingFactorialPolynomial c) p).comp (X + C s)) := by
      simpa using hrising.comp_C_mul_X_add_C (a := 1) (d := s) (by norm_num) hs
    have hfall : IsPFPolynomial
        (Poisson.fallingFactorialTransform c (raySemigroupTransform a b t p)) := by
      rw [show c = b * t by rfl]
      rw [fallingFactorialTransform_raySemigroupTransform]
      exact htranslated
    let q := raySemigroupTransform a b t p
    have hordinary : IsPFPolynomial
        (basisTransform fallingFactorialPolynomial (q.comp (C c * X))) := by
      rw [← fallingFactorialTransform_comp_C_mul_X]
      simpa [q] using hfall.comp_C_mul_X_add_C hcpos le_rfl
    have hscaledRoots : HasOnlyNonposRoots (q.comp (C c * X)) :=
      brentiFallingFactorial hordinary.hasOnlyNonposRoots
    have hqnn : HasNonnegCoeffs q :=
      hp.hasNonnegCoeffs.basisTransform fun n =>
        (raySemigroupBasis_isPFPolynomial ha hb ht n).hasNonnegCoeffs
    have hscalednn : HasNonnegCoeffs (q.comp (C c * X)) := by
      intro n
      rw [Polynomial.comp_C_mul_X_coeff]
      exact mul_nonneg (hqnn n) (pow_nonneg hc n)
    have hscaledPF : IsPFPolynomial (q.comp (C c * X)) := by
      rcases hscaledRoots with hzero | ⟨hsplits, hroots⟩
      · simpa [hzero] using IsPFPolynomial.zero
      · exact ⟨hscalednn, Or.inr hsplits, hroots⟩
    have hq : q = (q.comp (C c * X)).comp (C c⁻¹ * X) := by
      have hinner : C c * (C c⁻¹ * X) = (X : ℝ[X]) := by
        rw [← mul_assoc, ← map_mul, mul_inv_cancel₀ hcpos.ne']
        simp
      rw [Polynomial.comp_assoc, mul_comp, C_comp, X_comp, hinner,
        Polynomial.comp_X]
    change IsPFPolynomial q
    rw [hq]
    simpa using hscaledPF.comp_C_mul_X_add_C (inv_pos.mpr hcpos) le_rfl

/-- Multiplication by `X` is transported to the row recurrence under the ray
semigroup basis transform.
-/
theorem raySemigroupTransform_X_mul (a b t : ℝ) (p : ℝ[X]) :
    raySemigroupTransform a b t (X * p) =
      (X + C (t * a)) * raySemigroupTransform a b t p +
        C (b * t) * raySemigroupTransform a b t (X * p.derivative) +
          C (b * t) * X * (raySemigroupTransform a b t p).derivative := by
  apply Polynomial.basisTransform_X_mul_of_succ_index_derivative
    (raySemigroupBasis a b t) (X + C (t * a)) (C (b * t)) (C (b * t) * X)
  intro n
  have hC : C (t * (a + b * n)) =
      C (t * a) + C (b * t) * C (n : ℝ) := by
    simp only [map_mul, map_add, map_natCast]
    ring
  rw [raySemigroupBasis_succ]
  rw [hC]
  simp only [map_mul, map_natCast]
  ring

private theorem raySemigroupBasis_differential (a b t : ℝ) (n : ℕ) :
    C (n : ℝ) * raySemigroupBasis a b t n =
      (X + C (t * a)) * (raySemigroupBasis a b t n).derivative +
        C (b * t) * X * (raySemigroupBasis a b t n).derivative.derivative := by
  induction n with
  | zero => simp
  | succ n ih =>
      have ihd := congrArg derivative ih
      rw [raySemigroupBasis_succ]
      simp only [derivative_mul, derivative_X, derivative_C, derivative_one,
        zero_mul, zero_add, mul_zero, add_zero, map_add,
        Nat.cast_add]
      simp only [derivative_add, derivative_mul, derivative_X, derivative_C,
        zero_mul, zero_add, add_zero] at ihd
      push_cast
      have hC : C (t * (a + b * (n : ℝ))) =
          C (t * a) + C (b * t) * C (n : ℝ) := by
        simp only [map_mul, map_add, map_natCast]
        ring
      rw [hC]
      simp only [map_one, one_mul] at ihd ⊢
      linear_combination
        (X + C (t * a) + C (b * t) * C (n : ℝ) + C (b * t)) * ih +
          C (b * t) * X * ihd

/-- The ray semigroup intertwines the Euler operator with its infinitesimal
generator: `T (X p') = (X + t a) (T p)' + b t X (T p)''`.
-/
theorem raySemigroupTransform_X_mul_derivative (a b t : ℝ) (p : ℝ[X]) :
    raySemigroupTransform a b t (X * p.derivative) =
      (X + C (t * a)) * (raySemigroupTransform a b t p).derivative +
        C (b * t) * X * (raySemigroupTransform a b t p).derivative.derivative := by
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      simp only [derivative_add, mul_add, raySemigroupTransform_add, hp, hq]
      ring
  | monomial n c =>
      have htheta : X * (monomial n c).derivative = C (n : ℝ) * monomial n c := by
        cases n with
        | zero => simp
        | succ n =>
            rw [derivative_monomial, Nat.add_sub_cancel]
            simp only [Nat.cast_add, Nat.cast_one, map_add, map_one]
            rw [Polynomial.X_mul_monomial]
            rw [show (C (n : ℝ) + 1 : ℝ[X]) = C ((n : ℝ) + 1) by simp,
              Polynomial.C_mul_monomial]
            congr 1
            ring
      rw [htheta]
      rw [show C (n : ℝ) * monomial n c = (n : ℝ) • monomial n c by
        rw [Polynomial.smul_eq_C_mul]]
      rw [raySemigroupTransform_smul, raySemigroupTransform,
        Polynomial.basisTransform_monomial]
      simp only [derivative_mul, derivative_C, zero_mul, zero_add]
      linear_combination C c * raySemigroupBasis_differential a b t n

/-- Conjugated multiplication by `X`, written without an inverse operator.
At time one this is
`T M = (M + a I + (2 b M + a b I) D + b² M D²) T`.
-/
theorem raySemigroupTransform_X_mul_eq (a b t : ℝ) (p : ℝ[X]) :
    raySemigroupTransform a b t (X * p) =
      (X + C (t * a)) * raySemigroupTransform a b t p +
        (C (2 * b * t) * X + C (a * b * t ^ 2)) *
          (raySemigroupTransform a b t p).derivative +
        C ((b * t) ^ 2) * X *
          (raySemigroupTransform a b t p).derivative.derivative := by
  rw [raySemigroupTransform_X_mul, raySemigroupTransform_X_mul_derivative]
  simp only [map_mul, map_pow, map_ofNat]
  ring

/-- Transport of the first-order source recurrence through the ray semigroup.
This is the general-time algebraic identity behind the second-order
application theorem.
-/
theorem raySemigroupTransform_firstOrderStep (a b kappa t c : ℝ)
    (p : ℝ[X]) :
    raySemigroupTransform a b t
        ((X + C c) * p + C kappa * X * p.derivative) =
      (X + C (t * a + c)) * raySemigroupTransform a b t p +
        (C (2 * b * t + kappa) * X +
          C (t * a * (b * t + kappa))) *
            (raySemigroupTransform a b t p).derivative +
        C (b * t * (b * t + kappa)) * X *
          (raySemigroupTransform a b t p).derivative.derivative := by
  rw [raySemigroupTransform_add]
  rw [show (X + C c) * p = X * p + C c * p by ring,
    raySemigroupTransform_add]
  rw [show C c * p = c • p by rw [Polynomial.smul_eq_C_mul],
    raySemigroupTransform_smul]
  rw [show C kappa * X * p.derivative = kappa • (X * p.derivative) by
    rw [Polynomial.smul_eq_C_mul]
    ring, raySemigroupTransform_smul]
  rw [raySemigroupTransform_X_mul_eq, raySemigroupTransform_X_mul_derivative]
  simp only [map_mul, map_add, map_pow, map_ofNat]
  ring

/-- The first-order source sequence
`F₀ = 1`, `Fₙ₊₁ = (X + cₙ) Fₙ + kappa X Fₙ'`.
-/
def rayApplicationSource (kappa : ℝ) (c : ℕ → ℝ) : ℕ → ℝ[X]
  | 0 => 1
  | n + 1 =>
      (X + C (c n)) * rayApplicationSource kappa c n +
        C kappa * X * (rayApplicationSource kappa c n).derivative

/-- The second-order application sequence obtained by applying the time-one
ray semigroup to `rayApplicationSource`.
-/
def rayApplicationSequence (a b kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) : ℝ[X] :=
  raySemigroupTransform a b 1 (rayApplicationSource kappa c n)

/-- The source sequence starts at one. -/
@[simp] theorem rayApplicationSource_zero (kappa : ℝ) (c : ℕ → ℝ) :
    rayApplicationSource kappa c 0 = 1 :=
  rfl

/-- The source sequence satisfies its defining first-order recurrence. -/
theorem rayApplicationSource_succ (kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    rayApplicationSource kappa c (n + 1) =
      (X + C (c n)) * rayApplicationSource kappa c n +
        C kappa * X * (rayApplicationSource kappa c n).derivative :=
  rfl

private theorem rayApplicationSource_degree_leadingCoeff
    (kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    (rayApplicationSource kappa c n).natDegree = n ∧
      (rayApplicationSource kappa c n).leadingCoeff = 1 := by
  let P := rayApplicationSource kappa c
  have hrec : ∀ m, P (m + 1) =
      (C kappa * X + C 0 * X ^ 2) * (P m).derivative +
        (C (c m) + C 1 * X) * P m + 0 := by
    intro m
    rw [show P (m + 1) =
      (X + C (c m)) * P m + C kappa * X * (P m).derivative by rfl]
    simp only [map_zero, zero_mul, add_zero, map_one, one_mul]
    ring_nf
  have h := Polynomial.natDegree_and_leadingCoeff_quadratic_derivative_recurrence_of_ne_zero
    P (fun _ => 0) (fun _ => kappa) (fun _ => 0) c (fun _ => 1)
      hrec (by simp [P]) (by intro m; simp [P]) (by intro m; norm_num) n
  simpa [P] using h

/-- The source row at index `n` has degree `n`. -/
theorem rayApplicationSource_natDegree (kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    (rayApplicationSource kappa c n).natDegree = n :=
  (rayApplicationSource_degree_leadingCoeff kappa c n).1

/-- Every source row is monic. -/
theorem rayApplicationSource_monic (kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    (rayApplicationSource kappa c n).Monic :=
  (rayApplicationSource_degree_leadingCoeff kappa c n).2

/-- Nonnegative first-order parameters make every source row PF. -/
theorem rayApplicationSource_isPFPolynomial {kappa : ℝ} {c : ℕ → ℝ}
    (hkappa : 0 ≤ kappa) (hc : ∀ n, 0 ≤ c n) (n : ℕ) :
    IsPFPolynomial (rayApplicationSource kappa c n) := by
  exact (Poisson.isPFPolynomial_and_interl_of_poisson_affine_recurrence
    (c := kappa) (a := c) (b := fun _ => 1) (P := rayApplicationSource kappa c)
    hkappa hc (fun _ => by norm_num) (by simp [IsPFPolynomial.one])
    (fun m => by
      rw [rayApplicationSource_succ]
      simp only [mul_one]
      ring_nf
      simp) n).1

/-- The application sequence starts at one. -/
@[simp] theorem rayApplicationSequence_zero (a b kappa : ℝ) (c : ℕ → ℝ) :
    rayApplicationSequence a b kappa c 0 = 1 := by
  change basisTransform (raySemigroupBasis a b 1) 1 = 1
  rw [show (1 : ℝ[X]) = X ^ 0 by simp, Polynomial.basisTransform_X_pow]
  rfl

/-- The time-one ray transfer satisfies the paper's second-order recurrence. -/
theorem rayApplicationSequence_succ (a b kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    rayApplicationSequence a b kappa c (n + 1) =
      (X + C (a + c n)) * rayApplicationSequence a b kappa c n +
        (C (2 * b + kappa) * X + C (a * (b + kappa))) *
          (rayApplicationSequence a b kappa c n).derivative +
        C (b * (b + kappa)) * X *
          (rayApplicationSequence a b kappa c n).derivative.derivative := by
  rw [rayApplicationSequence, rayApplicationSource_succ,
    raySemigroupTransform_firstOrderStep]
  simp only [one_mul, mul_one, rayApplicationSequence]

/-- Nonnegative parameters make every application row a PF polynomial. -/
theorem rayApplicationSequence_isPFPolynomial {a b kappa : ℝ} {c : ℕ → ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hkappa : 0 ≤ kappa)
    (hc : ∀ n, 0 ≤ c n) (n : ℕ) :
    IsPFPolynomial (rayApplicationSequence a b kappa c n) := by
  exact raySemigroupTransform_isPFPolynomial ha hb zero_le_one
    (rayApplicationSource_isPFPolynomial hkappa hc n)

/-- Every application row is monic. -/
theorem rayApplicationSequence_monic (a b kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    (rayApplicationSequence a b kappa c n).Monic := by
  exact raySemigroupTransform_monic a b 1 (rayApplicationSource_monic kappa c n)

/-- The application row at index `n` has degree `n`. -/
theorem rayApplicationSequence_natDegree (a b kappa : ℝ) (c : ℕ → ℝ) (n : ℕ) :
    (rayApplicationSequence a b kappa c n).natDegree = n := by
  unfold rayApplicationSequence raySemigroupTransform
  apply natDegree_eq_of_le_of_coeff_ne_zero
  · simpa [rayApplicationSource_natDegree] using
      Polynomial.basisTransform_natDegree_le_of_natDegree_le
        (fun m => (raySemigroupBasis_natDegree a b 1 m).le)
        (rayApplicationSource kappa c n)
  · have hcoeff := Polynomial.coeff_basisTransform_natDegree_eq_one_of_monic
      (raySemigroupBasis_natDegree a b 1)
      (raySemigroupBasis_monic a b 1)
      (rayApplicationSource_monic kappa c n)
    rw [rayApplicationSource_natDegree] at hcoeff
    simp [hcoeff]

end RealRooted
