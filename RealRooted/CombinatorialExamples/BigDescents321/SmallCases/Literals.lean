            ofList (sumList (fun i ↦ mulList (motzkinList i) (motzkinList (k - i))) (k + 1)) := by
        rw [ofList_sumList]
        refine Finset.sum_congr rfl fun i hi ↦ ?_
        have hi' := Finset.mem_range.mp hi
        rw [ih i (by lia) (by lia),
          ih (k - i) (by lia) (by lia), ← ofList_mulList]
