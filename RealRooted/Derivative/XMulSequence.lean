import RealRooted.Derivative.FamilyClosure

/-!
# Split sequences obtained from a differentiated `X`-multiple

Multiplication by a split polynomial after differentiating `X * p` preserves splitting.
The sequence form packages the induction used by degree-jump-two rows.
-/

open Polynomial

noncomputable section

namespace RealRooted

/-- A sequence generated by multiplying `(X * P n)'` by a fixed split polynomial is split. -/
theorem splits_of_mul_derivative_X_mul_sequence {P : ℕ → ℝ[X]} {q : ℝ[X]}
    (hq : q.Splits) (hzero : (P 0).Splits)
    (hrec : ∀ n, P (n + 1) = q * (X * P n).derivative) :
    ∀ n, (P n).Splits := by
  intro n
  induction n with
  | zero => exact hzero
  | succ n ih =>
      rw [hrec]
      exact hq.mul ((Polynomial.Splits.X.mul ih).derivative)

end RealRooted
