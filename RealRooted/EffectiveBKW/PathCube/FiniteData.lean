/-- Integer-list version of the order-four transfer recurrence. -/
def listStep (a b c d : IntPoly) : IntPoly :=
  BigDescents321.SmallCases.addList
    (BigDescents321.SmallCases.addList
      (BigDescents321.SmallCases.addList
        (BigDescents321.SmallCases.mulList [1, 3] a)
        (BigDescents321.SmallCases.mulList [0, 2, -2] b))
      (BigDescents321.SmallCases.mulList [0, 2, -1, -1] c))
    (BigDescents321.SmallCases.mulList [0, 0, 1, -2, 1] d)

end RealRooted.EffectiveBKW.PathCube
