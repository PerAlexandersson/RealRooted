module

public import RealRooted.Hermite.Generalized.Basic
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import RealRooted.Hermite.Generalized.Monic
import RealRooted.Hermite.Generalized.PositiveFactor
import Mathlib.FieldTheory.KummerExtension

/-!
# Root-of-unity products for generalized Hermite polynomials

Kim--Kim (2015), Theorem 2.2: the nonzero roots occur in full root-of-unity
orbits generated by distinct positive real numbers. The empty product also
covers degrees smaller than the derivative stride.
-/

public section

open Polynomial Complex

namespace RealRooted

/-- Monicity cancels the scalar in a split compressed factorization. -/
private theorem monic_power_factor_product {P Q : ℝ[X]} {c : ℝ} {p s : ℕ}
    (hp : p ≠ 0) (hP : P.Monic) (hQ : Q.Splits)
    (hfactor : P = C c * (X ^ s * Q.comp (X ^ p))) :
    P = X ^ s * (Q.roots.map (fun a ↦ X ^ p - C a)).prod := by
  have hdeg : (X ^ p : ℝ[X]).natDegree ≠ 0 := by simpa using hp
  have hlc : c * Q.leadingCoeff = 1 := by
    have h := congrArg leadingCoeff hfactor
    simpa only [hP.leadingCoeff, leadingCoeff_mul, leadingCoeff_C,
      leadingCoeff_pow, leadingCoeff_X, one_pow, one_mul,
      leadingCoeff_comp hdeg, mul_one] using h.symm
  calc
    P = C c * (X ^ s *
        (C Q.leadingCoeff * (Q.roots.map (X - C ·)).prod).comp (X ^ p)) := by
      rw [← hQ.eq_prod_roots]
      exact hfactor
    _ = C (c * Q.leadingCoeff) *
        (X ^ s * (Q.roots.map (fun a ↦ X ^ p - C a)).prod) := by
      simp only [mul_comp, C_comp, multiset_prod_comp, Multiset.map_map,
        Function.comp_def, sub_comp, X_comp, C_comp, map_mul]
      ring
    _ = X ^ s * (Q.roots.map (fun a ↦ X ^ p - C a)).prod := by
      rw [hlc, map_one, one_mul]

/-- The real binomial product has distinct positive radii and no scalar factor. -/
theorem generalizedHermite_eq_prod_X_pow_sub_pow {p s : ℕ}
    (hp : 2 ≤ p) (hs : s < p) (q : ℕ) :
    ∃ R : Multiset ℝ, R.Nodup ∧ R.card = q ∧ (∀ r ∈ R, 0 < r) ∧
      generalizedHermite p (s + p * q) =
        X ^ s * (R.map (fun r ↦ X ^ p - C (r ^ p))).prod := by
  obtain ⟨c, Q, _, hfactor, hQ, hdeg, hpos⟩ :=
    generalizedHermite_eq_C_mul_X_pow_comp hp hs q
  have hp0 : p ≠ 0 := by lia
  have heq := monic_power_factor_product hp0
    (generalizedHermite_isMonicOfDegree p (s + p * q)).monic hQ.2.1 hfactor
  let R := Q.roots.map (fun a ↦ a ^ (p : ℝ)⁻¹)
  have hpow (a : ℝ) (ha : a ∈ Q.roots) : (a ^ (p : ℝ)⁻¹) ^ p = a :=
    Real.rpow_inv_natCast_pow (hpos a ha).le hp0
  refine ⟨R, ?_, ?_, ?_, ?_⟩
  · apply Multiset.Nodup.map_on _ hQ.2.2.roots_nodup
    intro a ha b hb hab
    have h := congrArg (fun x : ℝ ↦ x ^ p) hab
    simpa only [hpow a ha, hpow b hb] using h
  · exact (Multiset.card_map _ _).trans (hQ.2.1.natDegree_eq_card_roots.symm.trans hdeg)
  · intro r hr
    obtain ⟨a, ha, rfl⟩ := Multiset.mem_map.mp hr
    exact Real.rpow_pos_of_pos (hpos a ha) _
  · rw [heq]
    congr 1
    dsimp only [R]
    rw [Multiset.map_map]
    apply congrArg Multiset.prod
    exact Multiset.map_congr rfl (fun a ha ↦ by simp only [Function.comp_def, hpow a ha])

/-- Each positive radius contributes its complete orbit under the primitive
`p`th root of unity. Distinct positive radii and the empty product are explicit. -/
theorem generalizedHermite_eq_rootOfUnity_product {p s : ℕ}
    (hp : 2 ≤ p) (hs : s < p) (q : ℕ) :
    ∃ R : Multiset ℝ, R.Nodup ∧ R.card = q ∧ (∀ r ∈ R, 0 < r) ∧
      (generalizedHermite p (s + p * q)).map ofRealHom = X ^ s *
        (R.map (fun r : ℝ ↦ ∏ k ∈ Finset.range p,
          (X - C (exp (2 * Real.pi * I / p) ^ k * (r : ℂ))))).prod := by
  obtain ⟨R, hR, hcard, hpos, heq⟩ :=
    generalizedHermite_eq_prod_X_pow_sub_pow hp hs q
  refine ⟨R, hR, hcard, hpos, ?_⟩
  rw [heq, Polynomial.map_mul, Polynomial.map_pow, map_X, Polynomial.map_multiset_prod,
    Multiset.map_map]
  congr 1
  apply congrArg Multiset.prod
  apply Multiset.map_congr rfl
  intro r _
  simp only [Function.comp_def, Polynomial.map_sub, Polynomial.map_pow,
    map_X, map_C, ofRealHom_eq_coe, ofReal_pow]
  exact X_pow_sub_C_eq_prod (isPrimitiveRoot_exp p (by lia)) (by lia) rfl

end RealRooted
