          w = b ∨ w = d) →
        (xSubQuarticCubicPolynomial a b b d u v w μ).Splits := by
    intro hcommon
    exact xSubQuarticCubicSplits_of_common_root_cases
      (le_of_lt hab) le_rfl (le_of_lt hbd) huv hvw hau hbv hbw hub hvd
