    HasNonnegCoeffs (g.comp (X + C r)) →
    f.natDegree = g.natDegree + 1 →
    P g.natDegree →
    ∀ μ : ℝ, 0 < μ →
      (X * f.comp (X + C r) - C μ * g.comp (X + C r)).Splits

