    (R : ℕ → ℕ → Prop) : Prop :=
  ∀ {f g : ℝ[X]} {r s : ℝ},
    f.Splits → g.Splits → OppositeLeadingSigns f g →
      LeftRootCountBranch f g r s →
        R f.natDegree g.natDegree →
          (∃ k : ℝ[X], Prec (deleteRootFactor f r) k ∧ Prec g k) →
            Compatible
              (X * (deleteRootFactor f r).comp (X + C r))
              (g.comp (X + C r))

