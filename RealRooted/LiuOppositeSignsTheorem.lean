    simpa [Polynomial.natDegree_comp] using hgdeg
  exact splits_X_mul_sub_C_mul_of_positiveSplit_natDegree_two_one_of_cubicDiscrim
    harith (hpair.comp_X_add_C r) hfnn hgnn hfdeg_shift hgdeg_shift hμ

