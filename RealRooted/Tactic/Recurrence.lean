import RealRooted.Tactic.Recurrence.Shape
import RealRooted.Tactic.Recurrence.Eval
import RealRooted.Tactic.Recurrence.Degree
import RealRooted.Tactic.Recurrence.ODE
import RealRooted.RecurrenceSpace.Defect

/-!
# Recurrence tactics

Tactics about the rows of a polynomial sequence defined by a recurrence, independent of
real-rootedness:

* `RealRooted.Tactic.Recurrence.Shape`: reading the recurrence off the definition;
* `RealRooted.Tactic.Recurrence.Eval`: exact computation of the first rows;
* `RealRooted.Tactic.Recurrence.Degree`: `rr_row_natDegree`, `rr_row_ne_zero`,
  `rr_row_leadingCoeff_pos`;
* `RealRooted.Tactic.Recurrence.ODE`: `rr_find_ode` and `rr_row_ode`, eigen-ODEs of
  second-order recurrences;
* `rr_replay_lift` and `rr_replay_source`: replay short recurrence-space certificates;
* `rr_lift_recurrence`: adapt a checked lift to the coefficient convention used by the
  derivative-recurrence theorems.

The real-rootedness and interlacing tactics (`rr_row_interlaces`, `rr_product_*`) build
on these.
-/

/-- Normalize the concrete rational-polynomial factor identity generated by certificate
replay.  The final `done` makes a corrupted certificate fail atomically. -/
macro "rr_replay_factor" : tactic => `(tactic| (
  first
  | decide
  | (norm_num [RealRooted.defectCorrection, RealRooted.lagCharacteristic,
      LinearRecurrence.charPoly, Fin.sum_univ_succ]
     simp only [← Polynomial.C_mul_X_pow_eq_monomial, map_add, map_mul, map_one,
       map_ofNat]
     ring)
  done))

/-- Replay a short factor certificate from a pure-lag recurrence and its lift seeds. -/
syntax (name := rrReplayLift) "rr_replay_lift" "(" term ")" "(" term ")" "(" term ")" : tactic

macro_rules
  | `(tactic|
      rr_replay_lift ($hsource:term) ($factor:term) ($hseeds:term)) =>
      `(tactic| first
        | (refine RealRooted.liftDefect_eq_zero_of_lagDefect_eq_zero
              (gamma := $factor) (hsource := $hsource) (hfactor := ?_)
              (hseed := $hseeds)
           rr_replay_factor)
        | (intro n
           refine congrFun (RealRooted.liftDefect_eq_zero_of_lagDefect_eq_zero
             (gamma := $factor) (hsource := $hsource) (hfactor := ?_)
             (hseed := $hseeds)) n
           rr_replay_factor))

/-- Replay a short factor certificate on a tail beginning at an exceptional index. -/
syntax (name := rrReplayLiftFrom) "rr_replay_lift_from" "(" term ")" "(" term ")"
  "(" term ")" "(" term ")" "(" term ")" : tactic

macro_rules
  | `(tactic|
      rr_replay_lift_from ($origin:term) ($hsource:term) ($factor:term)
        ($hfactor:term) ($hseeds:term)) =>
      `(tactic| exact RealRooted.liftDefect_eq_zero_from_of_lagDefect_eq_zero_from
        (n₀ := $origin) (gamma := $factor) (hsource := $hsource) (hfactor := $hfactor)
        (hseed := $hseeds))

/-- Replay the converse short certificate when every affine leader is nonzero. -/
syntax (name := rrReplaySource) "rr_replay_source" "(" term ")" "(" term ")"
  "(" term ")" "(" term ")" : tactic

macro_rules
  | `(tactic|
      rr_replay_source ($hlift:term) ($factor:term) ($hseed:term) ($hleader:term)) =>
      `(tactic| first
        | (refine RealRooted.lagDefect_eq_zero_of_liftDefect_eq_zero
              (gamma := $factor) (hlift := $hlift) (hfactor := ?_)
              (hseed := $hseed) (hleader := $hleader)
           rr_replay_factor)
        | (intro n
           refine congrFun (RealRooted.lagDefect_eq_zero_of_liftDefect_eq_zero
             (gamma := $factor) (hlift := $hlift) (hfactor := ?_)
             (hseed := $hseed) (hleader := $hleader)) n
           rr_replay_factor))

/-- Replay the converse certificate on a tail, using extra source seeds at singular leaders. -/
syntax (name := rrReplaySourceFrom) "rr_replay_source_from" "(" term ")" "(" term ")"
  "(" term ")" "(" term ")" "(" term ")" "(" term ")" : tactic

macro_rules
  | `(tactic|
      rr_replay_source_from ($origin:term) ($hlift:term) ($factor:term)
        ($hfactor:term) ($hseed:term) ($hexceptions:term)) =>
      `(tactic| exact
        RealRooted.lagDefect_eq_zero_from_of_liftDefect_eq_zero_from_of_exceptional
          (n₀ := $origin) (gamma := $factor) (hlift := $hlift) (hfactor := $hfactor)
          (hseed := $hseed) (hexception := $hexceptions))

/-- Convert a checked lift to the `A * P' + B * P` convention of the
derivative-recurrence and root-window theorems. -/
syntax (name := rrLiftRecurrence) "rr_lift_recurrence" "(" term ")" "(" term ")"
  "(" term ")" "(" term ")" : tactic

macro_rules
  | `(tactic|
      rr_lift_recurrence ($hlift:term) ($scalar:term) ($scalarEq:term) ($scalarNe:term)) =>
      `(tactic| first
        | exact RealRooted.derivativeRecurrence_of_liftDefect_eq_zero
            (delta := $scalar) (hlift := $hlift) (hdelta := $scalarEq)
            (hdelta_ne := $scalarNe) _
        | (intro n
           exact RealRooted.derivativeRecurrence_of_liftDefect_eq_zero
             (delta := $scalar) (hlift := $hlift) (hdelta := $scalarEq)
             (hdelta_ne := $scalarNe) n))
